{
  "schema": "gaga.section-front-policy.v1",
  "version": "0.0.40.1",
  "principles": {
    "sectionsDerivedFromArticles": true,
    "noSecondSectionContentAuthority": true,
    "sectionRoutesAreStatic": true,
    "sectionRoutesParticipateInDiscovery": true,
    "sectionRoutesParticipateInSitemap": true,
    "sectionFrontUsesEditorialHierarchy": true
  },
  "route": {
    "index": "/sections",
    "detailPattern": "/sections/{slug}"
  },
  "fallback": {
    "unknownSection": "/404",
    "emptySectionsAreNotGenerated": true
  }
}
