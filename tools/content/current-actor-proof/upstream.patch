diff --git a/packages/core/tests/unit/plugins/authorization.test.ts b/packages/core/tests/unit/plugins/authorization.test.ts
new file mode 100644
index 0000000..af16b75
--- /dev/null
+++ b/packages/core/tests/unit/plugins/authorization.test.ts
@@ -0,0 +1,106 @@
+import { Role } from "@emdash-cms/auth";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { createBridgeHandler } from "../../../../workerd/src/sandbox/bridge-handler.js";
+import { ContentRepository } from "../../../src/database/repositories/content.js";
+import { UserRepository } from "../../../src/database/repositories/user.js";
+import { createAuthorizationAccess } from "../../../src/plugins/authorization.js";
+import { PluginContextFactory } from "../../../src/plugins/context.js";
+import { definePlugin } from "../../../src/plugins/define-plugin.js";
+import type { AuthorizationCheck } from "../../../src/plugins/types.js";
+import { describeEachDialect, setupForDialectWithCollections, teardownForDialect } from "../../utils/test-db.js";
+import type { DialectTestContext } from "../../utils/test-db.js";
+
+describeEachDialect("current native publication authorization", (dialect) => {
+	let ctx: DialectTestContext;
+	let actorId: string;
+	let otherId: string;
+	let resource: AuthorizationCheck["resource"];
+	let access: ReturnType<typeof createAuthorizationAccess>;
+	const request = (): AuthorizationCheck => ({ actor: { type: "user", id: actorId }, permission: "content:publish_own", resource });
+
+	beforeEach(async () => {
+		ctx = await setupForDialectWithCollections(dialect);
+		const users = new UserRepository(ctx.db);
+		actorId = (await users.create({ email: "author@example.test", role: Role.AUTHOR })).id;
+		otherId = (await users.create({ email: "other@example.test", role: Role.AUTHOR })).id;
+		const item = await new ContentRepository(ctx.db).create({ type: "post", authorId: actorId, data: { title: "Saved draft" } });
+		resource = { type: "content", collection: "post", id: item.id };
+		access = createAuthorizationAccess(ctx.db);
+	});
+	afterEach(async () => teardownForDialect(ctx));
+
+	it("allows the active native Author only on owned content", async () => {
+		expect(await access.check(request())).toEqual({ allowed: true });
+		expect(await access.check({ ...request(), actor: { type: "user", id: otherId } })).toEqual({ allowed: false });
+		expect(await access.check({ ...request(), permission: "content:publish_any" })).toEqual({ allowed: false });
+	});
+	it("uses native any-content authority for an Editor and Admin", async () => {
+		for (const role of [Role.EDITOR, Role.ADMIN]) {
+			await new UserRepository(ctx.db).update(otherId, { role });
+			for (const permission of ["content:publish_own", "content:publish_any"] as const) {
+				expect(await access.check({ ...request(), actor: { type: "user", id: otherId }, permission })).toEqual({ allowed: true });
+			}
+		}
+	});
+	it("observes disablement after an earlier allowed decision", async () => {
+		expect(await access.check(request())).toEqual({ allowed: true });
+		await ctx.db.updateTable("users").set({ disabled: 1 }).where("id", "=", actorId).execute();
+		expect(await access.check(request())).toEqual({ allowed: false });
+	});
+	it("observes demotion and promotion without rebuilding the accessor", async () => {
+		expect(await access.check(request())).toEqual({ allowed: true });
+		await new UserRepository(ctx.db).update(actorId, { role: Role.CONTRIBUTOR });
+		expect(await access.check(request())).toEqual({ allowed: false });
+		await new UserRepository(ctx.db).update(actorId, { role: Role.AUTHOR });
+		expect(await access.check(request())).toEqual({ allowed: true });
+	});
+	it("denies a deleted actor", async () => {
+		expect(await access.check(request())).toEqual({ allowed: true });
+		await ctx.db.deleteFrom("users").where("id", "=", actorId).execute();
+		expect(await access.check(request())).toEqual({ allowed: false });
+	});
+	it("recomputes native ownership, including ownerless content", async () => {
+		expect(await access.check(request())).toEqual({ allowed: true });
+		await ctx.db.updateTable("ec_post").set({ author_id: otherId }).where("id", "=", resource.id).execute();
+		expect(await access.check(request())).toEqual({ allowed: false });
+		expect(await access.check({ ...request(), actor: { type: "user", id: otherId } })).toEqual({ allowed: true });
+		await ctx.db.updateTable("ec_post").set({ author_id: null }).where("id", "=", resource.id).execute();
+		expect(await access.check(request())).toEqual({ allowed: false });
+	});
+	it("denies missing, trashed and unknown resources", async () => {
+		expect(await access.check({ ...request(), resource: { ...resource, id: "missing" } })).toEqual({ allowed: false });
+		expect(await access.check({ ...request(), resource: { ...resource, collection: "missing" } })).toEqual({ allowed: false });
+		await ctx.db.updateTable("ec_post").set({ deleted_at: new Date().toISOString() }).where("id", "=", resource.id).execute();
+		expect(await access.check(request())).toEqual({ allowed: false });
+	});
+	it("denies malformed inputs and unknown actor/permission kinds without disclosure", async () => {
+		for (const value of [null, {}, { ...request(), actor: { type: "service", id: actorId } }, { ...request(), actor: { type: "user", id: "" } }, { ...request(), permission: "users:manage" }, { ...request(), resource: { ...resource, collection: "posts;drop" } }, { ...request(), actor: { type: "user", id: "missing" } }]) {
+			// @ts-expect-error Deliberate untrusted boundary input.
+			expect(await access.check(value)).toEqual({ allowed: false });
+		}
+		expect(Object.keys(await access.check(request()))).toEqual(["allowed"]);
+	});
+	it("fails closed when authoritative state cannot be read", async () => {
+		await ctx.db.destroy();
+		expect(await access.check(request())).toEqual({ allowed: false });
+	});
+	it("requires explicit capability and grants neither directory nor mutation access", () => {
+		const factory = new PluginContextFactory({ db: ctx.db });
+		const omitted = factory.createContext(definePlugin({ id: "no-check", version: "1.0.0", capabilities: [] }));
+		expect(omitted.authorization).toBeUndefined();
+		const permitted = factory.createContext(definePlugin({ id: "check-only", version: "1.0.0", capabilities: ["authorization:check"] }));
+		expect(permitted.authorization?.check).toBeTypeOf("function");
+		expect(permitted.users).toBeUndefined();
+		expect(permitted.content).toBeUndefined();
+		expect(Object.keys(permitted.authorization ?? {})).toEqual(["check"]);
+	});
+	it("enforces capability and current-state parity through the sandbox HTTP bridge", async () => {
+		const handler = (capabilities: string[]) => createBridgeHandler({ db: ctx.db, pluginId: "check-only", version: "1.0.0", capabilities, allowedHosts: [], storageCollections: [], emailSend: () => null });
+		const call = (capabilities: string[]) => handler(capabilities)(new Request("http://bridge/authorization/check", { method: "POST", body: JSON.stringify({ request: request() }) }));
+		expect((await call([])).status).not.toBe(200);
+		expect(await (await call(["authorization:check"])).json()).toEqual({ result: await access.check(request()) });
+		await ctx.db.updateTable("users").set({ disabled: 1 }).where("id", "=", actorId).execute();
+		expect(await (await call(["authorization:check"])).json()).toEqual({ result: { allowed: false } });
+	});
+});
