@@ -0,0 +1,39 @@
+import { env, exports as workerExports } from "cloudflare:workers";
+import { Kysely } from "kysely";
+import { describe, expect, it } from "vitest";
+import { RawBindingD1Dialect } from "../../../cloudflare/src/db/d1-dialect.js";
+import { generatePluginWrapper } from "../../../cloudflare/src/sandbox/wrapper.js";
+import { UserRepository } from "../../src/database/repositories/user.js";
+import { ContentRepository } from "../../src/database/repositories/content.js";
+import { runMigrations } from "../../src/database/migrations/runner.js";
+import type { Database } from "../../src/database/types.js";
+import { createAuthorizationAccess } from "../../src/plugins/authorization.js";
+import { SchemaRegistry } from "../../src/schema/registry.js";
+import { resetD1Schema } from "./d1-schema.js";
+
+describe("current authorization over native workerd RPC", () => {
+	it("uses the shared host decision on real D1 and enforces capability at both boundaries", async () => {
+		const db = new Kysely<Database>({ dialect: new RawBindingD1Dialect({ database: env.DB }) });
+		await resetD1Schema(db);
+		await runMigrations(db);
+		await new SchemaRegistry(db).createCollection({ slug: "posts", label: "Posts" });
+		const user = await new UserRepository(db).create({ email: "writer@example.test", role: "author" });
+		const post = await new ContentRepository(db).create({ type: "posts", authorId: user.id, data: {} });
+		const input = { actor: { type: "user" as const, id: user.id }, permission: "content:publish_own" as const, resource: { type: "content" as const, collection: "posts", id: post.id } };
+		const props = { pluginId: "authorization-test", pluginVersion: "1.0.0", capabilities: ["authorization:check"], allowedHosts: [], storageCollections: [] };
+		const wrapper = generatePluginWrapper({ id: props.pluginId, version: "1.0.0", capabilities: ["authorization:check"], allowedHosts: [], storage: {}, hooks: [], routes: ["check"], admin: {} });
+		const stub = env.LOADER.load({
+			compatibilityDate: "2026-05-14", compatibilityFlags: ["nodejs_compat"], mainModule: "wrapper.js",
+			modules: { "wrapper.js": wrapper, "sandbox-plugin.js": 'export default { routes: { check: ({input}, ctx) => ctx.authorization.check(input) } };' },
+			env: { BRIDGE: workerExports.PluginBridge({ props }), PLUGIN_ID: props.pluginId, PLUGIN_VERSION: "1.0.0" },
+		});
+		const worker = stub.getEntrypoint() as unknown as { invokeRoute(name: string, input: unknown, request: unknown, id: string): Promise<unknown> };
+		expect(await worker.invokeRoute("check", input, { method: "POST", meta: {} }, "first")).toEqual(await createAuthorizationAccess(db).check(input));
+		expect(await createAuthorizationAccess(db).check(input)).toEqual({ allowed: true });
+		await db.updateTable("users").set({ disabled: 1 }).where("id", "=", user.id).execute();
+		expect(await worker.invokeRoute("check", input, { method: "POST", meta: {} }, "second")).toEqual({ allowed: false });
+		const deniedBridge = workerExports.PluginBridge({ props: { ...props, capabilities: [] } });
+		await expect(deniedBridge.authorizationCheck(input)).rejects.toThrow("Missing capability: authorization:check");
+		await db.destroy();
+	});
