diff --git a/packages/plugin-types/tests/authorization-consent.test.ts b/packages/plugin-types/tests/authorization-consent.test.ts
new file mode 100644
index 0000000..2bbaab3
--- /dev/null
+++ b/packages/plugin-types/tests/authorization-consent.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { capabilitiesToDeclaredAccess, declaredAccessToCapabilities, isDeclaredAccessEscalation } from "../src/index.js";
+import { pluginManifestSchema } from "../src/manifest-schema.js";
+
+describe("authorization check consent", () => {
+	it("round-trips a dedicated check-only capability and requires new consent", () => {
+		const access = capabilitiesToDeclaredAccess(["authorization:check"]);
+		expect(access).toEqual({ authorization: { check: {} } });
+		expect(declaredAccessToCapabilities(access).capabilities).toEqual(["authorization:check"]);
+		expect(isDeclaredAccessEscalation({}, access)).toBe(true);
+		expect(isDeclaredAccessEscalation(access, access)).toBe(false);
+		expect(isDeclaredAccessEscalation(access, {})).toBe(false);
+	});
+	it("accepts the capability in the public manifest without user or mutation capability", () => {
+		const manifest = pluginManifestSchema.parse({
+			id: "check-only", name: "Check only", version: "1.0.0", capabilities: ["authorization:check"],
+			allowedHosts: [], storage: {}, hooks: [], routes: [], admin: {},
+		});
+		expect(manifest.capabilities).toEqual(["authorization:check"]);
+	});
+});
