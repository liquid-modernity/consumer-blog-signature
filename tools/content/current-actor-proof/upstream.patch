diff --git a/packages/core/src/plugins/authorization.ts b/packages/core/src/plugins/authorization.ts
new file mode 100644
index 0000000..670b652
--- /dev/null
+++ b/packages/core/src/plugins/authorization.ts
@@ -0,0 +1,41 @@
+import { canActOnOwn, hasPermission, Role } from "@emdash-cms/auth";
+import { createKyselyAdapter } from "@emdash-cms/auth/adapters/kysely";
+import type { Kysely } from "kysely";
+import { z } from "zod";
+
+import { ContentRepository } from "../database/repositories/content.js";
+import type { Database } from "../database/types.js";
+import type { AuthorizationAccess } from "./types.js";
+
+const id = z.string().min(1).max(256).refine((value) => value.trim() === value);
+const requestSchema = z.object({
+	actor: z.object({ type: z.literal("user"), id }).strict(),
+	permission: z.enum(["content:publish_own", "content:publish_any"]),
+	resource: z.object({
+		type: z.literal("content"), collection: z.string().regex(/^[a-z][a-z0-9_]{0,62}$/), id,
+	}).strict(),
+}).strict();
+
+export function createAuthorizationAccess(db: Kysely<Database>): AuthorizationAccess {
+	const auth = createKyselyAdapter(db);
+	const content = new ContentRepository(db);
+	return {
+		async check(input) {
+			const parsed = requestSchema.safeParse(input);
+			if (!parsed.success) return { allowed: false };
+			const request = parsed.data;
+			try {
+				// Never retain actor or resource state across decisions: delayed work must observe revocation.
+				const user = await auth.getUserById(request.actor.id);
+				if (!user || user.disabled !== false || !Object.values(Role).includes(user.role)) return { allowed: false };
+				const item = await content.findById(request.resource.collection, request.resource.id);
+				if (!item) return { allowed: false };
+				return { allowed: request.permission === "content:publish_any"
+					? hasPermission(user, request.permission)
+					: canActOnOwn(user, item.authorId ?? "", "content:publish_own", "content:publish_any") };
+			} catch {
+				return { allowed: false };
+			}
+		},
+	};
+}
