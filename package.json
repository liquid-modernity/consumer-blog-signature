{
  "name": "consumer-blog-signature",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Universal, configurable high-end enterprise blog/knowledge publishing bootstrap powered by Astro and Gaga Engine.",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "verify": "npm run test:gaga && npm run validate:signature && npm run check && npm run build && npm run test:consumer",
    "review": "./run_local.command",
    "validate:signature": "node tools/validate-signature.mjs",
    "test": "node tools/validate-signature.mjs && node --test tools/hardening.test.mjs",
    "verify:toolchain": "node scripts/verify-local-toolchain.mjs",
    "verify:full": "npm run verify:toolchain && npm run verify",
    "bootstrap:catalina": "bash scripts/bootstrap-catalina.sh",
    "predev": "node tools/gaga/prepare.mjs",
    "prebuild": "node tools/gaga/prepare.mjs",
    "postbuild": "node tools/gaga/worker-build.mjs",
    "precheck": "node tools/gaga/prepare.mjs",
    "test:gaga": "node --test tools/gaga/*.test.mjs",
    "test:consumer": "node tools/gaga/consumer.mjs",
    "test:ui": "playwright test",
    "cms:dev": "bash scripts/cms-local.sh dev",
    "cms:install": "bash scripts/cms-local.sh install",
    "cms:seed": "bash scripts/cms-local.sh seed",
    "cms:verify": "bash scripts/cms-local.sh verify",
    "test:cms": "node --test tools/cms/*.test.mjs",
    "cms:refresh": "bash scripts/cms-local.sh refresh",
    "test:editorial": "node --test tools/editorial/*.test.mjs",
    "editorial:prepare": "node tools/editorial/prepare.mjs",
    "editorial:studio": "bash scripts/cms-local.sh studio",
    "test:editorial:ui": "playwright test --config playwright.editorial.config.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "astro": "7.3.3",
    "sass": "1.89.2",
    "typescript": "5.8.3",
    "@gaga/engine-capabilities": "0.4.0",
    "@gaga/engine-contracts": "0.4.0",
    "@gaga/engine-runtime": "0.4.0",
    "@gaga/engine-adapter-obsidian": "0.4.0",
    "@gaga/corps-astro": "0.1.0",
    "@gaga/corps-starlight": "0.1.0",
    "@gaga/corps-emdash": "0.1.0",
    "@gaga/corps-cloudflare": "0.1.0",
    "@astrojs/starlight": "0.41.10",
    "@gaga/arsenal-contracts": "0.1.0",
    "@gaga/arsenal": "file:vendor/arsenal-editorial/gaga-arsenal-0.2.0-editorial.0.tgz",
    "@astrojs/markdown-remark": "7.3.4",
    "github-slugger": "2.0.0",
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "wrangler": "4.152.0",
    "esbuild": "0.28.2",
    "rolldown": "1.2.12",
    "workerd": "1.20261022.1",
    "@playwright/test": "1.58.2",
    "yaml": "2.9.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "overrides": {
    "rolldown": "1.2.12",
    "source-map-js": "1.2.2",
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    },
    "@astrojs/prism": "4.0.2",
    "undici@7.29.1": "7.30.1",
    "micromark-extension-math": {
      "katex": "0.19.1"
    }
  }
}
