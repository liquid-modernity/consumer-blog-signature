{
  "name": "pakrpp-editorial-studio-local",
  "main": "../src/worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "editorial-studio-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "editorial-studio-local-media" },
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "00000000000000000000000000000000" },
  ],
}
