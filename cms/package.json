{
  "name": "consumer-blog-signature-cms",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "seed": "emdash seed --database .data/cms.db --on-conflict error",
    "build:cloudflare": "astro build --config astro.cloudflare.config.mjs",
    "studio": "astro dev --root ./studio --config ../astro.studio.config.mjs"
  },
  "dependencies": {
    "emdash": "1.3.1",
    "astro": "7.3.3",
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@emdash-cms/cloudflare": "1.3.1",
    "@astrojs/cloudflare": "14.3.4",
    "@emdash-cms/admin": "1.3.1"
  },
  "overrides": {
    "rolldown": "1.2.12",
    "esbuild": "0.28.2",
    "zod": "4.6.7",
    "source-map-js": "1.2.2",
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    },
    "@astrojs/compiler-binding-wasm32-wasi": {
      "@emnapi/core": "1.11.3",
      "@emnapi/runtime": "1.11.3",
      "@emnapi/wasi-threads": "1.2.3",
      "@napi-rs/wasm-runtime": "1.2.4"
    },
    "@rolldown/binding-wasm32-wasi": {
      "@emnapi/core": "2.0.0-alpha.5",
      "@emnapi/runtime": "2.0.0-alpha.5",
      "@napi-rs/wasm-runtime": "1.2.4"
    },
    "undici@7.29.1": "7.30.1"
  },
  "emdash": {
    "seed": "migration/seed.json"
  },
  "optionalDependencies": {
    "@astrojs/compiler-binding-wasm32-wasi": "0.4.1",
    "@rolldown/binding-wasm32-wasi": "1.2.12"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
