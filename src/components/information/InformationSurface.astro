---
import { presenceNavigation } from '../../lib/presence';
const links = [
  ...presenceNavigation().map(item=>[item.title,item.href]),
  ['Legal','/legal'],
  ['Privacy','/privacy'],
  ['Terms','/terms'],
  ['Sitemap','/sitemap-index.xml'],
  ['RSS','/rss.xml']
];
---
<details class="gaga-information-surface">
  <summary data-gaga-tooltip="Information">Information</summary>
  <div class="gaga-information-surface__panel">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </div>
</details>
