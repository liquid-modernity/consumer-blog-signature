---
import '../../styles/tokens.css';
import '../../styles/signature.scss';
import { normalizeContentMetadata } from '@gaga/engine/content';
import Head from './Head.astro';
import PageFrame from './PageFrame.astro';
import ContentPanel from './ContentPanel.astro';
import MarkdownContent from './MarkdownContent.astro';
import { resolveGagaWorkspace } from '../../config/workspaces';
import { resolveGagaShellContext } from '../../config/shell-context';
import {
  normalizeGagaRouteContext,
  type GagaRouteContext
} from '../../gaga/content/runtime-route';

interface Props {
  entryData: Record<string, unknown>;
  routeContext?: GagaRouteContext | null;
}

const {
  entryData,
  routeContext = Astro.locals.gagaRoute
} = Astro.props;

const metadata = normalizeContentMetadata(entryData);
const baseRoute = normalizeGagaRouteContext(routeContext);
const route = normalizeGagaRouteContext({
  ...baseRoute,
  id: baseRoute.id || Astro.url.pathname,
  lang: baseRoute.lang ?? metadata.language,
  entryData,
  entry: { data: entryData }
});
const language = metadata.language === 'en' ? 'en' : 'id-ID';
const workspace = resolveGagaWorkspace(Astro.url.pathname, metadata.contentKind);
const shellContext = resolveGagaShellContext(workspace);
---

<!doctype html>
<html
  lang={language}
  data-gaga-publishing-shell="native"
  data-gaga-workspace={workspace.id}
  data-gaga-workspace-mode={workspace.mode}
  data-gaga-context-intent={shellContext.intent}
  data-gaga-context-left={shellContext.left}
  data-gaga-context-right={shellContext.right}
  data-gaga-context-mobile={shellContext.mobile}
  data-gaga-context-priority={shellContext.rightPriority}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head entryData={entryData} routeContext={route} />
  </head>
  <body>
    <div
      class="gaga-visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-gaga-context-status
    ></div>
    <PageFrame
      entryData={entryData}
      routeContext={route}
      workspace={workspace}
      shellContext={shellContext}
    >
      <div class="main-pane">
        <ContentPanel entryData={entryData}>
          <MarkdownContent entryData={entryData} routeContext={route}>
            <slot />
          </MarkdownContent>
        </ContentPanel>
      </div>
    </PageFrame>
  </body>
</html>
