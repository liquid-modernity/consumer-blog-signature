---
import ArticleShell from './ArticleShell.astro';
import DocumentWorkspace from '../reader/DocumentWorkspace.astro';
import { documentExperience } from '../../config/document-experience';
import PageTitle from './PageTitle.astro';
import AuthorArticleIndex from '../reader/AuthorArticleIndex.astro';
import TopicArticleIndex from '../reader/TopicArticleIndex.astro';
import PageMetadataTable from '../information/PageMetadataTable.astro';
import { createArticleWorkspaceActionsInput, createRightRailInput } from '../frame/site-composition';
import { contentDefaults } from '../../config/content';
import { i18nLabel } from '../../config/i18n';
import { getArticles, getAuthorBySlug, getAuthors, getTagGroups, getTopicGroups } from '../../lib/content';
import { toCanonicalPublications } from '../../lib/pakrpp-content';
import { resolveCanonicalTopic, resolvePublicationType } from '../../config/pakrpp-architecture';
import { getScreenInfo } from '../../lib/screen-info';
import type { BreadcrumbItem } from '../../lib/page-context';
import { normalizeContentMetadata } from '@gaga/engine-capabilities/content';
import { resolveCoverageAuthority } from '../../config/coverage';
import { normalizeGagaRouteContext, type GagaRouteContext } from '../../gaga/content/runtime-route';

interface Props {
  entryData: Record<string, unknown>;
  routeContext?: GagaRouteContext | null;
}

const {
  entryData,
  routeContext = Astro.locals.gagaRoute
} = Astro.props;
const route = normalizeGagaRouteContext({
  ...normalizeGagaRouteContext(routeContext),
  entryData,
  entry: { data: entryData }
});
const metadata = normalizeContentMetadata(entryData);
const isArticle = metadata.contentKind === 'article';
const isAuthor = metadata.contentKind === 'author';
const isTopic = metadata.contentKind === 'topic';
const language = metadata.language ?? route?.lang;
const routeIdentity = metadata.canonical ?? route?.id ?? Astro.url.pathname;
const missingTitleSource = route?.id ?? Astro.url.pathname;
const articleActions = createArticleWorkspaceActionsInput();
const coverage = resolveCoverageAuthority(entryData);
const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isRootPage = cleanPath === '/';
const documentProfile = documentExperience(cleanPath);
let breadcrumbs: BreadcrumbItem[] = [];
let rightRail = null;
let readingMetaItems: string[] = [];
let personalPublication = false;
let prevPub: { title: string; canonicalHref: string; summary?: string; metaText?: string } | null = null;
let nextPub: { title: string; canonicalHref: string; summary?: string; metaText?: string } | null = null;

if (!isRootPage) {
  const [articles, authors, topicGroupsAll, tagGroups, canonicalPubs] = await Promise.all([
    getArticles(),
    getAuthors(),
    getTopicGroups(),
    getTagGroups(),
    isArticle ? toCanonicalPublications() : Promise.resolve([])
  ]);
  const context = getScreenInfo({
    pathname: Astro.url.pathname,
    data: metadata,
    language,
    defaults: contentDefaults,
    tocItems: route?.toc?.items ?? [],
    articles,
    authors,
    topicGroups: topicGroupsAll,
    tagGroups
  });
  breadcrumbs = context.breadcrumbs ?? [];
  rightRail = createRightRailInput(context);

  if (isArticle && canonicalPubs.length > 0) {
    const slugSegment = cleanPath.split('/').filter(Boolean).at(-1) ?? '';
    const currentIdx = canonicalPubs.findIndex((p) => p.slug === slugSegment || p.canonicalHref === cleanPath);
    const currentPub = currentIdx >= 0 ? canonicalPubs[currentIdx] : null;
    if (currentPub) {
      personalPublication = true;
      const pubTypeLabel = resolvePublicationType(currentPub.type).label;
      const topicLabels = (rightRail?.topics?.length ? rightRail.topics : currentPub.topics.map((t) => resolveCanonicalTopic(t)?.label ?? t)).join(', ');
      readingMetaItems = [
        pubTypeLabel,
        topicLabels,
        rightRail?.publishedDate?.text ?? currentPub.publishedAt ?? '',
        rightRail?.readTime ?? currentPub.readTime ?? ''
      ].filter(Boolean);

      if (currentIdx > 0) {
        const nextItem = canonicalPubs[currentIdx - 1];
        nextPub = {
          title: nextItem.title,
          canonicalHref: nextItem.canonicalHref,
          summary: nextItem.summary,
          metaText: `${resolvePublicationType(nextItem.type).label} · ${nextItem.publishedAt}`
        };
      }
      if (currentIdx < canonicalPubs.length - 1) {
        const prevItem = canonicalPubs[currentIdx + 1];
        prevPub = {
          title: prevItem.title,
          canonicalHref: prevItem.canonicalHref,
          summary: prevItem.summary,
          metaText: `${resolvePublicationType(prevItem.type).label} · ${prevItem.publishedAt}`
        };
      }
    } else if (rightRail) {
      readingMetaItems = [
        rightRail.publishedDate?.text ?? '',
        rightRail.readTime ?? '',
        (rightRail.topics ?? []).join(', ')
      ].filter(Boolean);
    }
  }
}

const authorSlug = isAuthor ? Astro.url.pathname.split('/').filter(Boolean).at(-1) : undefined;
const authorRef = authorSlug ? (await getAuthorBySlug(authorSlug))?.contentId : undefined;
const topicGroups = isTopic ? await getTopicGroups() : [];
const topicGroup = topicGroups.find((group) => group.href === cleanPath);
const isEntity = isAuthor || isTopic;
const entityTitle = isAuthor ? metadata.title : topicGroup?.topic ?? metadata.title;
const entityProfileLabel = i18nLabel(isAuthor ? 'entity.profile' : 'entity.topicAbout');
const entityWritingsLabel = i18nLabel('entity.writings');
const entityNavigationLabel = i18nLabel(isAuthor ? 'entity.authorNavigation' : 'entity.topicNavigation');
---
{isArticle ? (
  <ArticleShell
    identity={metadata}
    language={language}
    actions={articleActions}
    routeIdentity={routeIdentity}
    missingTitleSource={missingTitleSource}
    breadcrumbs={breadcrumbs}
    coverage={coverage}
    readingMetaItems={readingMetaItems}
  >
    <div class="gaga-article-body gaga-markdown-content" data-gaga-article-body data-gaga-personal-readable={personalPublication ? 'true' : undefined} data-gaga-personal-kind="article" data-gaga-personal-author={rightRail?.author}><slot /></div>
    {(prevPub || nextPub) && (
      <nav class="gaga-article-pager" aria-label="Navigasi antar publikasi" data-gaga-preview-scope>
        <div class="gaga-article-pager__col">
          {prevPub && (
            <a
              href={prevPub.canonicalHref}
              class="gaga-article-pager__link"
              data-gaga-preview
              data-gaga-preview-title={prevPub.title}
              data-gaga-preview-snippet={prevPub.summary}
              data-gaga-preview-meta={prevPub.metaText}
              data-gaga-preview-href={prevPub.canonicalHref}
            >
              <span class="gaga-article-pager__dir">← Publikasi Sebelumnya</span>
              <span class="gaga-article-pager__title">{prevPub.title}</span>
            </a>
          )}
        </div>
        <div class="gaga-article-pager__col gaga-article-pager__col--end">
          {nextPub && (
            <a
              href={nextPub.canonicalHref}
              class="gaga-article-pager__link"
              data-gaga-preview
              data-gaga-preview-title={nextPub.title}
              data-gaga-preview-snippet={nextPub.summary}
              data-gaga-preview-meta={nextPub.metaText}
              data-gaga-preview-href={nextPub.canonicalHref}
            >
              <span class="gaga-article-pager__dir">Publikasi Selanjutnya →</span>
              <span class="gaga-article-pager__title">{nextPub.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}
    {rightRail ? <PageMetadataTable rail={rightRail} /> : null}
  </ArticleShell>
) : (
  isEntity ? (
    <section class="gaga-entity-surface" data-gaga-entity-tabs data-gaga-entity-kind={isAuthor ? 'author' : 'topic'}>
      <header class="gaga-entity-header">
        <h1 id="_top">{entityTitle}</h1>
      </header>

      <nav
        class="gaga-entity-tabs__list"
        aria-label={entityNavigationLabel.id}
        data-gaga-i18n-key={entityNavigationLabel.key}
        data-gaga-i18n-id={entityNavigationLabel.id}
        data-gaga-i18n-en={entityNavigationLabel.en}
        data-gaga-i18n-target="aria"
      >
        <a
          href="#profile"
          data-gaga-entity-tab="profile"
          aria-controls="profile"
          aria-current="location"
          data-gaga-i18n-key={entityProfileLabel.key}
          data-gaga-i18n-id={entityProfileLabel.id}
          data-gaga-i18n-en={entityProfileLabel.en}
        >{entityProfileLabel.id}</a>
        <a
          href="#writings"
          data-gaga-entity-tab="writings"
          aria-controls="writings"
          data-gaga-i18n-key={entityWritingsLabel.key}
          data-gaga-i18n-id={entityWritingsLabel.id}
          data-gaga-i18n-en={entityWritingsLabel.en}
        >{entityWritingsLabel.id}</a>
      </nav>

      <div class="gaga-entity-tabs__panels">
        <section
          id="profile"
          class="gaga-entity-panel gaga-entity-panel--profile"
          data-gaga-entity-panel="profile"
          data-gaga-legacy-fragment="gaga-entity-profile"
        >
          <div
            class:list={['gaga-markdown-content', isAuthor && 'gaga-author-profile']}
            data-gaga-author-profile={isAuthor ? '' : undefined}
            data-gaga-entity-profile-content
          >
            <slot />
          </div>
        </section>

        <section
          id="writings"
          class="gaga-entity-panel gaga-entity-panel--writings"
          data-gaga-entity-panel="writings"
          data-gaga-legacy-fragment="gaga-entity-writings"
        >
          {authorRef ? <AuthorArticleIndex authorRef={authorRef} /> : null}
          {topicGroup ? <TopicArticleIndex group={topicGroup} language={metadata.language ?? route?.lang} /> : null}
        </section>
      </div>
      {rightRail ? <PageMetadataTable rail={rightRail} /> : null}
    </section>
  ) : (
    <>
      {documentProfile ? (
        <DocumentWorkspace title={metadata.title ?? ''}>
          <PageTitle entryData={entryData} routeId={routeIdentity} />
          <div class="gaga-markdown-content" data-gaga-personal-readable={documentProfile.readable ? 'true' : undefined} data-gaga-personal-kind="document" data-gaga-document-body={documentProfile.id !== 'section' ? '' : undefined}><slot /></div>
        </DocumentWorkspace>
      ) : (
        <><PageTitle entryData={entryData} routeId={routeIdentity} /><div class="gaga-markdown-content"><slot /></div></>
      )}
      {rightRail ? documentProfile ? <details class="gaga-document-metadata"><summary>Informasi {documentProfile.id === 'section' ? 'ruang editorial' : 'dokumen'}</summary><PageMetadataTable rail={rightRail} /></details> : <PageMetadataTable rail={rightRail} /> : null}
    </>
  )
)}

<style>
  .gaga-article-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    inline-size: var(--gaga-reading-measure, 100%);
    max-inline-size: var(--gaga-article-measure, 40.5rem);
    margin-inline: auto;
    margin-top: 2.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid color-mix(in srgb, var(--gaga-line) 55%, transparent);
  }

  .gaga-article-pager__col--end {
    text-align: right;
  }

  .gaga-article-pager__link {
    display: inline-flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: inherit;
    max-width: 100%;
  }

  .gaga-article-pager__col--end .gaga-article-pager__link {
    align-items: flex-end;
  }

  .gaga-article-pager__dir {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gaga-muted);
  }

  .gaga-article-pager__title {
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--gaga-ink);
  }

  .gaga-article-pager__link:hover .gaga-article-pager__title,
  .gaga-article-pager__link:focus-visible .gaga-article-pager__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 42rem) {
    .gaga-article-pager {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }

    .gaga-article-pager__col--end {
      text-align: left;
    }

    .gaga-article-pager__col--end .gaga-article-pager__link {
      align-items: flex-start;
    }
  }
</style>

