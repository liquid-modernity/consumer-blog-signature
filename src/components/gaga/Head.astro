---
import SeoHead from '../seo/SeoHead.astro';
import { resolveAuthorRefs } from '../../lib/content';
import { normalizeContentMetadata } from '@gaga/engine-capabilities/content';
import { resolveFreshnessAuthority } from '../../config/freshness';
import { resolveCoverageAuthority } from '../../config/coverage';
import {
  extractGagaHeadTitle,
  filterGagaHeadEntries,
  normalizeGagaRouteContext,
  type GagaRouteContext
} from '../../gaga/content/runtime-route';

interface Props {
  entryData: Record<string, unknown>;
  routeContext?: GagaRouteContext | null;
}

const {
  entryData,
  routeContext = Astro.locals.gagaRoute
} = Astro.props;
const route = normalizeGagaRouteContext({
  ...normalizeGagaRouteContext(routeContext),
  entryData,
  entry: { data: entryData }
});
const authorRefs = Array.isArray(entryData.authorRefs)
  ? entryData.authorRefs.filter((ref): ref is string => typeof ref === 'string')
  : [];
const resolvedAuthors = await resolveAuthorRefs(authorRefs);
const data = normalizeContentMetadata({
  ...entryData,
  ...(resolvedAuthors[0] ? { author: resolvedAuthors[0].title } : {})
});
const { title, socialTitle } = extractGagaHeadTitle(route);
const freshness = resolveFreshnessAuthority(entryData);
const coverage = resolveCoverageAuthority(entryData);
const shouldNoindex = data.noindex === true || Astro.url.pathname === '/404' || Astro.url.pathname === '/offline.html';
const renderedHead = filterGagaHeadEntries(route.head, {
  replacedMetaNames: ['gaga:summary', 'gaga:search-index', 'gaga:machine-index', 'gaga:agent', 'gaga:llms', 'gaga:freshness-status', 'gaga:freshness-volatility', 'gaga:last-reviewed', 'gaga:review-after', 'gaga:coverage-mode', 'gaga:coverage-status', 'gaga:coverage-updated-at']
});
---

{renderedHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<SeoHead
  metadata={data}
  title={title}
  socialTitle={socialTitle}
  noindex={shouldNoindex}
  locale={route.lang === 'en' ? 'en' : 'id-ID'}
/>

<meta name="gaga:freshness-status" content={freshness.status} />
<meta name="gaga:freshness-volatility" content={freshness.volatility} />
{freshness.lastReviewed && <meta name="gaga:last-reviewed" content={freshness.lastReviewed} />}
{freshness.reviewAfter && <meta name="gaga:review-after" content={freshness.reviewAfter} />}

<meta name="gaga:coverage-mode" content={coverage.mode} />
<meta name="gaga:coverage-status" content={coverage.status} />
{coverage.updatedAt && <meta name="gaga:coverage-updated-at" content={coverage.updatedAt} />}
