---
import { getIconDefinition } from '../../lib/icons';

interface Props {
  name: string;
  label?: string;
  class?: string;
}

const { name, label, class: className = '' } = Astro.props;
const icon = getIconDefinition(name);
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox}
  class:list={['gaga-icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.85"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <g set:html={icon.body} />
</svg>
