---
import type { CanonicalContentMetadata } from '@gaga/engine-capabilities/content';
import { identityConfig } from '../../config/identity';
import { seoConfig } from '../../config/seo';
import { siteConfig } from '../../config/site';
import { storageKeys } from '../../config/systems';
import { defaultTheme, themeChromeColor, themeChromeColorMap, themeColorSchemeMap, themeOptions } from '../../config/theme';
import {
  absoluteUrl,
  canonicalUrl,
  jsonLdArticle,
  jsonLdWebPage,
  jsonLdWebSite,
  robotsContent,
  seoDescription,
  seoImageAlt,
  seoImageUrl,
  seoKeywords,
  seoSummary,
  seoTitle,
  stripUndefined
} from '@gaga/engine-capabilities/seo';

interface Props {
  metadata: CanonicalContentMetadata;
  pathname?: string;
  title?: string;
  socialTitle?: string;
  noindex?: boolean;
  includeWebSiteSchema?: boolean;
  locale?: string;
}

const {
  metadata,
  pathname = Astro.url.pathname,
  title,
  socialTitle,
  noindex,
  includeWebSiteSchema,
  locale = 'id-ID'
} = Astro.props;

const resolvedTitle = title ?? seoTitle(metadata, seoConfig.text);
const resolvedSocialTitle = socialTitle ?? resolvedTitle;
const canonical = canonicalUrl(metadata, pathname, seoConfig.canonical);
const description = seoDescription(metadata, seoConfig.text);
const summary = seoSummary(metadata, seoConfig.text);
const keywords = seoKeywords(metadata);
const contentKind = metadata.contentKind ?? 'page';
const author = metadata.author ?? siteConfig.author;
const hasCustomImage = typeof metadata.image === 'string' && metadata.image.trim().length > 0;
const socialImage = seoImageUrl(metadata, seoConfig);
const twitterImage = hasCustomImage
  ? socialImage
  : absoluteUrl(seoConfig.socialImage.defaultTwitterImage, seoConfig.canonical);
const socialImageAlt = seoImageAlt(metadata, seoConfig.socialImage);
const shouldNoindex = noindex ?? metadata.noindex;
const pageSchema = stripUndefined(contentKind === 'article'
  ? jsonLdArticle(metadata, canonical, seoConfig)
  : jsonLdWebPage(metadata, canonical, seoConfig));
const shouldIncludeWebSiteSchema = includeWebSiteSchema ?? !shouldNoindex;
const webSiteSchema = shouldIncludeWebSiteSchema ? stripUndefined(jsonLdWebSite(seoConfig)) : undefined;
const rssUrl = absoluteUrl('/rss.xml', seoConfig.canonical);
const searchIndexUrl = absoluteUrl('/search-index.json', seoConfig.canonical);
const machineIndexUrl = absoluteUrl('/machine.json', seoConfig.canonical);
const agentDescriptionUrl = absoluteUrl('/agent.json', seoConfig.canonical);
const llmsUrl = absoluteUrl('/llms.txt', seoConfig.canonical);
const themeInitScript = `(() => {
  const storageKey = ${JSON.stringify(storageKeys.theme)};
  const defaultTheme = ${JSON.stringify(defaultTheme)};
  const themes = ${JSON.stringify(themeOptions.map((theme) => theme.id))};
  const chromeColors = ${JSON.stringify(themeChromeColorMap)};
  const colorSchemes = ${JSON.stringify(themeColorSchemeMap)};
  let theme = defaultTheme;
  try {
    const saved = window.localStorage.getItem(storageKey);
    const parsed = saved ? JSON.parse(saved) : null;
    if (themes.includes(parsed)) theme = parsed;
  } catch {}
  const root = document.documentElement;
  root.dataset.gagaTheme = theme;
  root.dataset.theme = colorSchemes[theme] || colorSchemes[defaultTheme] || 'dark';
  const themeColor = document.querySelector('meta[name="theme-color"][data-gaga-theme-color]');
  if (themeColor) themeColor.setAttribute('content', chromeColors[theme] || chromeColors[defaultTheme]);
})();`;
---
<title>{resolvedTitle}</title>
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={rssUrl} />
<link rel="alternate" type="application/json" title={`${siteConfig.name} machine index`} href={machineIndexUrl} />
<link rel="alternate" type="application/json" title={`${siteConfig.name} agent capabilities`} href={agentDescriptionUrl} />
<link rel="alternate" type="application/json" title={`${siteConfig.name} public search index`} href={searchIndexUrl} />
<link rel="icon" href={identityConfig.faviconIco} sizes="any" />
<link rel="icon" href={identityConfig.faviconSvg} type="image/svg+xml" />
<link rel="apple-touch-icon" href={identityConfig.appleTouchIcon} />
<link rel="mask-icon" href={identityConfig.safariPinnedTab} color={identityConfig.themeColor} />
<link rel="manifest" href={identityConfig.manifest} />
<meta name="description" content={description} />
<meta name="robots" content={robotsContent(shouldNoindex)} />
<meta name="author" content={author} />
<meta name="theme-color" content={themeChromeColor(defaultTheme)} data-gaga-theme-color />
<script is:inline set:html={themeInitScript} />
<meta property="og:type" content={contentKind === 'article' ? 'article' : 'website'} />
<meta property="og:title" content={resolvedSocialTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:image" content={socialImage} />
{!hasCustomImage && <meta property="og:image:width" content="1200" />}
{!hasCustomImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={socialImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedSocialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={twitterImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />
<meta name="gaga:summary" content={summary} />
<meta name="gaga:search-index" content={searchIndexUrl} />
<meta name="gaga:machine-index" content={machineIndexUrl} />
<meta name="gaga:agent" content={agentDescriptionUrl} />
<meta name="gaga:llms" content={llmsUrl} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{contentKind === 'article' && metadata.publishedAt && <meta property="article:published_time" content={metadata.publishedAt} />}
{contentKind === 'article' && metadata.updatedAt && <meta property="article:modified_time" content={metadata.updatedAt} />}
<script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
{webSiteSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />}
