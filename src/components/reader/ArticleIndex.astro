---
import { getArticles, toArticlePreview } from '../../lib/content';
import { contentDefaults } from '../../config/content';
import { normalizeContentMetadata, resolveContentDateLocale } from '@gaga/engine/content';
const articles = await getArticles();
const route = Astro.locals.gagaRoute;
const metadata = normalizeContentMetadata(route?.entry?.data ?? {});
const surfaceLocale = resolveContentDateLocale(metadata.language ?? route?.lang ?? contentDefaults.defaultLanguage, contentDefaults.dateLocale);
---
<section class="gaga-index-screen" aria-labelledby="latest-title">
  <div class="gaga-screen-section-head">
    <h2 id="latest-title">Latest</h2>
    <p>{articles.length} articles</p>
  </div>
  <ol class="gaga-mission-list" aria-label="Latest articles" data-gaga-preview-scope>
    {articles.map((article, index) => {
      const preview = toArticlePreview(article, surfaceLocale, contentDefaults.preview);
      const previewId = `latest-note-${index + 1}`;
      const titleId = `${previewId}-title`;

      return (
        <li class="gaga-mission-item" data-gaga-motion>
          <a
            href={preview.href}
            class="gaga-mission-link"
            data-gaga-preview
            data-gaga-preview-title={preview.title}
            data-gaga-preview-href={preview.href}
            data-gaga-preview-snippet={preview.snippet}
            data-gaga-preview-topics={preview.topics}
            data-gaga-preview-tags={preview.tags}
            data-gaga-preview-read-time={preview.readTime}
            data-gaga-preview-date={preview.date}
            data-gaga-preview-updated={preview.updated}
            data-gaga-preview-author={preview.author}
          >
            <span class="gaga-mission-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="gaga-mission-copy">
              <span id={titleId} class="gaga-mission-title">{preview.title}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</section>
