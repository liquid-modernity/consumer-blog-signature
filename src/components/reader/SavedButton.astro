---
import Icon from '../ui/Icon.astro';
import type { SavedButtonInput } from '../frame/component-inputs';

interface Props {
  action: SavedButtonInput;
}

const { action } = Astro.props;
---
<button
  type="button"
  class="gaga-save-button"
  data-gaga-action={action.command}
  data-gaga-quick-action="save"
  data-gaga-active="false"
  data-gaga-tooltip={action.ariaLabel.id}
  aria-pressed="false"
  aria-label={action.ariaLabel.id}
  data-gaga-i18n-key={action.ariaLabel.key}
  data-gaga-i18n-id={action.ariaLabel.id}
  data-gaga-i18n-en={action.ariaLabel.en}
  data-gaga-i18n-target="aria"
>
  {action.icon ? <Icon name={action.icon} /> : null}
  <span class="gaga-save-button__label" data-gaga-i18n-key={action.label.key} data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en}>{action.label.id}</span>
</button>
