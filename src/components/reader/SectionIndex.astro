---
import { canonicalPublicationHref } from '../../lib/pakrpp-content';
import { getEditorialSections } from '../../lib/editorial';
import { toArticlePreview } from '../../lib/content';
import { contentDefaults } from '../../config/content';
import { resolveContentDateLocale } from '@gaga/engine-capabilities/content';

const sections = await getEditorialSections();
const surfaceLocale = resolveContentDateLocale(
  contentDefaults.defaultLanguage,
  contentDefaults.dateLocale
);
---

<section class="gaga-section-index" aria-label="Ruang editorial tersedia">
  <header class="gaga-section-index__head">

    <p>{sections.length} ruang editorial</p>
  </header>

  {sections.length === 0 && <p>Belum ada ruang editorial yang ditetapkan.</p>}
  <div class="gaga-section-index__grid">
    {sections.map((section) => {
      const lead = section.lead
        ? { ...toArticlePreview(section.lead.article, surfaceLocale, contentDefaults.preview), href: canonicalPublicationHref(section.lead.article) }
        : undefined;

      return (
        <article class="gaga-section-tile">
          <div class="gaga-section-tile__meta">
            <span>{section.count} stories</span>
            {section.lead?.role && <span>{section.lead.role}</span>}
          </div>
          <h2><a href={section.href}>{section.name}</a></h2>
          {lead && (
            <p>
              <span>Lead:</span>{' '}
              <a href={lead.href}>{lead.title}</a>
            </p>
          )}
        </article>
      );
    })}
  </div>
</section>
