---
import { searchCommands } from '../../config/search-commands';

const commandProviders = searchCommands
  .filter((command) => !command.requiresArticle && !command.requiresSelection)
  .filter((command) => command.href || command.actionCommand)
  .map((command) => ({
    id: command.id,
    label: command.label,
    description: command.description,
    category: command.category,
    source: command.source,
    href: command.href,
    actionCommand: command.actionCommand
  }));

const tabs = [
  { type: 'all', label: 'All', href: '/search' },
  { type: 'articles', label: 'Articles', href: '/search?type=articles' },
  { type: 'topics', label: 'Topics', href: '/search?type=topics' },
  { type: 'tags', label: 'Tags', href: '/search?type=tags' },
  { type: 'commands', label: 'Commands', href: '/search?type=commands' },
  { type: 'graph', label: 'Graph', href: '/search?type=graph' }
];
---
<section class="gaga-search-page" data-gaga-search-page data-gaga-search-state="initial">
  <form class="gaga-search-workspace" action="/search" method="get" role="search" data-gaga-search-workspace>
    <label class="gaga-visually-hidden" for="gaga-search-workspace-input">What are you looking for?</label>
    <div class="gaga-search-workspace__row">
      <input
        id="gaga-search-workspace-input"
        type="search"
        name="q"
        placeholder="Search articles, topics, saved reading, or actions"
        data-gaga-search-input
        autocomplete="off"
        autofocus
      />
      <button type="submit">Search</button>
    </div>
  </form>

  <nav class="gaga-search-tabs" aria-label="Search result type" data-gaga-search-tabs>
    {tabs.map((tab) => (
      <a href={tab.href} data-gaga-search-tab={tab.type} aria-current={tab.type === 'all' ? 'page' : undefined}>{tab.label}</a>
    ))}
  </nav>

  <div class="gaga-search-status gaga-visually-hidden" role="status" aria-live="polite" data-gaga-search-status>
    Type at least two characters to search this publication.
  </div>

  <div class="gaga-search-results" data-gaga-search-results></div>

  <script is:inline type="application/json" data-gaga-search-command-providers set:html={JSON.stringify(commandProviders)}></script>
</section>
<script>
  import { runSiteCommand } from '../../scripts/systems/site-commands';
  import type { GagaActionCommand } from '../../config/actions';

  type SearchItem = {
    title: string;
    href: string;
    description?: string;
    tags?: string[];
    topics?: string[];
    topicLinks?: { label: string; href: string }[];
    tagLinks?: { label: string; href: string }[];
  };

  type CommandProvider = {
    id: string;
    label: string;
    description: string;
    category: string;
    source: string;
    href?: string;
    actionCommand?: string;
  };

  type FacetLink = { label: string; href: string };
  type FacetMatch = FacetLink & { count: number };
  type SearchType = 'all' | 'articles' | 'topics' | 'tags' | 'commands' | 'graph';

  const searchTypes: SearchType[] = ['all', 'articles', 'topics', 'tags', 'commands', 'graph'];
  const root = document.querySelector('[data-gaga-search-page]');
  const input = root?.querySelector<HTMLInputElement>('[data-gaga-search-input]');
  const results = root?.querySelector<HTMLElement>('[data-gaga-search-results]');
  const status = root?.querySelector<HTMLElement>('[data-gaga-search-status]');
  const commandsScript = root?.querySelector<HTMLScriptElement>('[data-gaga-search-command-providers]');
  const emptyMessage = 'Type at least two characters to search this publication.';
  let index: SearchItem[] = [];
  let loading: Promise<void> | null = null;
  let activeQuery = '';
  const commandProviders: CommandProvider[] = JSON.parse(commandsScript?.textContent || '[]');

  function loadIndex() {
    loading ??= fetch('/search-index.json')
      .then((response) => response.json())
      .then((data: { items?: SearchItem[] }) => {
        index = data.items ?? [];
      })
      .catch(() => {
        index = [];
      });
    return loading;
  }

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function section(title: string, provider: string, description?: string) {
    const node = document.createElement('section');
    node.className = 'gaga-search-provider';
    node.dataset.gagaSearchProvider = provider;
    const heading = document.createElement('h2');
    heading.textContent = title;
    node.append(heading);
    if (description) {
      const text = document.createElement('p');
      text.textContent = description;
      node.append(text);
    }
    return node;
  }

  function resultList() {
    const list = document.createElement('div');
    list.className = 'gaga-search-provider__grid';
    return list;
  }

  function createLinkCard(href: string, title: string, description = '', source = '') {
    const link = document.createElement('a');
    link.href = href;
    link.className = 'gaga-search-card';
    const titleNode = document.createElement('span');
    titleNode.textContent = title;
    link.append(titleNode);
    if (description) {
      const summary = document.createElement('small');
      summary.textContent = description;
      link.append(summary);
    }
    if (source) {
      const provenance = document.createElement('em');
      provenance.textContent = source;
      link.append(provenance);
    }
    return link;
  }

  function createCommandCard(command: CommandProvider) {
    if (command.href) {
      return createLinkCard(command.href, command.label, command.description, command.category);
    }
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'gaga-search-card';
    if (command.actionCommand) button.dataset.gagaSearchCommand = command.actionCommand;
    const title = document.createElement('span');
    title.textContent = command.label;
    const description = document.createElement('small');
    description.textContent = command.description;
    const source = document.createElement('em');
    source.textContent = command.category;
    button.append(title, description, source);
    return button;
  }

  function topicLabel(topic: string) {
    return topic
      .replace(/^(?:pakrpp|consumer)\.topic\./, '')
      .split(/[.\-_]/)
      .filter(Boolean)
      .map((part) => part[0]?.toUpperCase() + part.slice(1))
      .join(' ');
  }

  function scoreText(item: SearchItem) {
    return [item.title, item.description, ...(item.tags ?? []), ...(item.topics ?? [])].join(' ').toLowerCase();
  }

  function matchesQuery(value: string, query: string) {
    return value.toLowerCase().includes(query);
  }

  function matchingArticles(query: string) {
    return index.filter((item) => scoreText(item).includes(query)).slice(0, 12);
  }

  function matchingCommands(query: string) {
    return commandProviders
      .filter((command) => matchesQuery([command.label, command.description, command.category, command.source].join(' '), query))
      .slice(0, 8);
  }

  function matchingFacet(matches: SearchItem[], query: string, linksForItem: (item: SearchItem) => FacetLink[] | undefined) {
    const facets = new Map<string, FacetMatch>();
    for (const item of matches) {
      for (const facet of linksForItem(item) ?? []) {
        const current = facets.get(facet.href);
        facets.set(facet.href, { label: facet.label, href: facet.href, count: (current?.count ?? 0) + 1 });
      }
    }
    for (const item of index) {
      for (const facet of linksForItem(item) ?? []) {
        if (!matchesQuery(facet.label, query) && !matchesQuery(facet.href, query)) continue;
        const current = facets.get(facet.href);
        facets.set(facet.href, { label: facet.label, href: facet.href, count: Math.max(current?.count ?? 0, 1) });
      }
    }
    return [...facets.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label)).slice(0, 8);
  }

  function matchingTopics(matches: SearchItem[], query: string) {
    return matchingFacet(matches, query, (item) => item.topicLinks);
  }

  function matchingTags(matches: SearchItem[], query: string) {
    return matchingFacet(matches, query, (item) => item.tagLinks);
  }

  function renderSearchSection(matches: SearchItem[]) {
    if (!matches.length) return null;
    const node = section('Articles', 'SEARCH_PROVIDER', 'Ranked article results.');
    node.classList.add('gaga-search-provider--articles');
    const list = resultList();
    list.classList.add('gaga-search-provider__list');
    for (const item of matches) {
      list.append(createLinkCard(item.href, item.title, item.description ?? '', 'Article'));
    }
    node.append(list);
    return node;
  }

  function renderCommandSection(commands: CommandProvider[]) {
    if (!commands.length) return null;
    const node = section('Actions', 'COMMAND_PROVIDER', 'Choose an action intentionally.');
    node.classList.add('gaga-search-provider--commands');
    const list = resultList();
    list.classList.add('gaga-search-provider__list');
    for (const command of commands) list.append(createCommandCard(command));
    node.append(list);
    return node;
  }

  function renderTopicSection(topics: FacetMatch[]) {
    if (!topics.length) return null;
    const node = section('Topics', 'KNOWLEDGE_PROVIDER', 'Topics from matching public articles.');
    const list = resultList();
    for (const topic of topics) {
      list.append(createLinkCard(topic.href, topic.label, `${topic.count} matching item${topic.count === 1 ? '' : 's'}`, 'Topic'));
    }
    node.append(list);
    return node;
  }

  function renderTagSection(tags: FacetMatch[]) {
    if (!tags.length) return null;
    const node = section('Tags', 'TAG_PROVIDER', 'Lightweight authored labels from matching public articles.');
    const list = resultList();
    for (const tag of tags) {
      list.append(createLinkCard(tag.href, tag.label, `${tag.count} matching item${tag.count === 1 ? '' : 's'}`, 'Tag'));
    }
    node.append(list);
    return node;
  }

  function renderSavedSection(query: string) {
    if (!matchesQuery('saved bookmark continue reading queue continuity', query)) return null;
    const node = section('Saved reading', 'SAVED_PROVIDER', 'Saved and continuity state remain owned by the Saved page and local reading systems.');
    const list = resultList();
    list.append(createLinkCard('/library', 'Library', 'Open saved reading and local continuity context.', 'Library'));
    node.append(list);
    return node;
  }

  function renderGraphSection(matches: SearchItem[], topics: FacetMatch[], query: string) {
    if (!matches.length && !topics.length && !matchesQuery('graph relationship topic map', query)) return null;
    const node = section('Relationship view', 'GRAPH_PROVIDER', 'Topic and article relationships that can be explained from public content.');
    const graph = document.createElement('div');
    graph.className = 'gaga-search-graph';
    graph.setAttribute('role', 'list');
    const queryNode = document.createElement('div');
    queryNode.className = 'gaga-search-graph__node gaga-search-graph__node--focus';
    queryNode.setAttribute('role', 'listitem');
    queryNode.textContent = `Query: ${activeQuery}`;
    graph.append(queryNode);
    for (const topic of topics.slice(0, 4)) {
      const topicNode = document.createElement('a');
      topicNode.className = 'gaga-search-graph__node';
      topicNode.setAttribute('role', 'listitem');
      topicNode.href = topic.href;
      topicNode.textContent = `${topic.label} (${topic.count})`;
      graph.append(topicNode);
    }
    for (const item of matches.slice(0, 4)) {
      const articleNode = document.createElement('a');
      articleNode.className = 'gaga-search-graph__node';
      articleNode.setAttribute('role', 'listitem');
      articleNode.href = item.href;
      articleNode.textContent = item.title;
      graph.append(articleNode);
    }
    node.append(graph);

    const fullGraph = document.createElement('p');
    fullGraph.className = 'gaga-search-provider__action';
    const fullGraphLink = document.createElement('a');
    const fullGraphParams = new URLSearchParams();
    if (activeQuery) fullGraphParams.set('q', activeQuery);
    const fullGraphQuery = fullGraphParams.toString();
    fullGraphLink.href = fullGraphQuery ? `/graphs?${fullGraphQuery}` : '/graphs';
    fullGraphLink.textContent = 'Open interactive graph';
    fullGraph.append(fullGraphLink);
    node.append(fullGraph);

    const details = document.createElement('details');
    details.className = 'gaga-search-graph-expanded';
    const summary = document.createElement('summary');
    summary.textContent = 'Expand graph';
    details.append(summary);
    const relationshipList = document.createElement('ul');
    for (const item of matches.slice(0, 10)) {
      const row = document.createElement('li');
      const link = document.createElement('a');
      link.href = item.href;
      link.textContent = item.title;
      const topicsText = (item.topics ?? []).map(topicLabel).join(', ');
      row.append(link, document.createTextNode(topicsText ? ` has_topic ${topicsText}` : ' matched search text'));
      relationshipList.append(row);
    }
    if (!relationshipList.children.length) {
      const row = document.createElement('li');
      row.textContent = 'No article-topic relationships matched this query yet.';
      relationshipList.append(row);
    }
    details.append(relationshipList);
    node.append(details);
    return node;
  }

  function createStartSection() {
    return document.createDocumentFragment();
  }

  function typeFromUrl(): SearchType {
    const value = new URLSearchParams(window.location.search).get('type') ?? 'all';
    return searchTypes.includes(value as SearchType) ? value as SearchType : 'all';
  }

  function tabHref(type: SearchType, query: string) {
    const params = new URLSearchParams();
    if (query) params.set('q', query);
    if (type !== 'all') params.set('type', type);
    const suffix = params.toString();
    return suffix ? `/search?${suffix}` : '/search';
  }

  function syncTabs(query: string, type: SearchType) {
    for (const tab of document.querySelectorAll<HTMLAnchorElement>('[data-gaga-search-tab]')) {
      const tabType = searchTypes.includes(tab.dataset.gagaSearchTab as SearchType)
        ? tab.dataset.gagaSearchTab as SearchType
        : 'all';
      tab.href = tabHref(tabType, query);
      if (tabType === type) tab.setAttribute('aria-current', 'page');
      else tab.removeAttribute('aria-current');
    }
  }

  function renderResults() {
    if (!results || !input) return;
    const q = input.value.trim().toLowerCase();
    const type = typeFromUrl();
    syncTabs(input.value.trim(), type);
    if (q.length < 2) {
      setStatus(emptyMessage);
      root?.setAttribute('data-gaga-search-state', 'initial');
      results.replaceChildren(createStartSection());
      return;
    }
    activeQuery = input.value.trim();
    root?.setAttribute('data-gaga-search-state', 'active');
    const matches = matchingArticles(q);
    const commands = matchingCommands(q);
    const topics = matchingTopics(matches, q);
    const tags = matchingTags(matches, q);
    const sections = [
      type === 'all' || type === 'articles' ? renderSearchSection(matches) : null,
      type === 'all' || type === 'topics' ? renderTopicSection(topics) : null,
      type === 'all' || type === 'tags' ? renderTagSection(tags) : null,
      type === 'all' ? renderSavedSection(q) : null,
      type === 'all' || type === 'commands' ? renderCommandSection(commands) : null,
      type === 'all' || type === 'graph' ? renderGraphSection(matches, topics, q) : null
    ].filter((section): section is HTMLElement => !!section);
    if (!sections.length) {
      setStatus('No matching public results yet.');
      results.replaceChildren();
      return;
    }
    setStatus(`${sections.length} provider section${sections.length === 1 ? '' : 's'} available.`);
    results.replaceChildren(...sections);
  }

  function queryFromUrl() {
    return new URLSearchParams(window.location.search).get('q') ?? '';
  }

  function syncInputFromUrl() {
    if (!input) return;
    input.value = queryFromUrl();
    syncTabs(input.value.trim(), typeFromUrl());
  }

  function syncUrlFromInput() {
    if (!input) return;
    const url = new URL(window.location.href);
    const query = input.value.trim();
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    const nextUrl = `${url.pathname}${url.search}${url.hash}`;
    const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextUrl !== currentUrl) window.history.replaceState({}, '', nextUrl);
  }

  async function renderFromUrl() {
    syncInputFromUrl();
    if (!input?.value.trim()) {
      root?.setAttribute('data-gaga-search-state', 'initial');
      setStatus(emptyMessage);
      results?.replaceChildren(createStartSection());
      return;
    }
    await loadIndex();
    renderResults();
  }

  input?.addEventListener('focus', () => {
    void loadIndex();
  }, { once: true });

  input?.addEventListener('input', async () => {
    syncUrlFromInput();
    await loadIndex();
    renderResults();
  });

  results?.addEventListener('click', (event) => {
    const target = event.target instanceof HTMLElement ? event.target : null;
    const control = target?.closest<HTMLElement>('[data-gaga-search-command]');
    const command = control?.dataset.gagaSearchCommand;
    if (!command) return;
    event.preventDefault();
    runSiteCommand(command as GagaActionCommand, { source: 'search-workspace', target: control });
  });

  window.addEventListener('popstate', () => {
    void renderFromUrl();
  });

  document.querySelector('[data-gaga-search-tabs]')?.addEventListener('click', (event) => {
    const target = event.target instanceof HTMLElement ? event.target.closest<HTMLAnchorElement>('[data-gaga-search-tab]') : null;
    if (!target) return;
    event.preventDefault();
    window.history.pushState({}, '', target.href);
    void renderFromUrl();
  });

  void renderFromUrl();
</script>
