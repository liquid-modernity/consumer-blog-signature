---
import { getArticles, groupArticlesByMonth, toArticlePreview } from '../../lib/content';
import { contentDefaults } from '../../config/content';
import { routes } from '../../config/routes';
import { normalizeContentMetadata, resolveContentDateLocale } from '@gaga/engine-capabilities/content';
const articles = await getArticles();
const route = Astro.locals.gagaRoute;
const metadata = normalizeContentMetadata(route?.entry?.data ?? {});
const surfaceLocale = resolveContentDateLocale(metadata.language ?? route?.lang ?? contentDefaults.defaultLanguage, contentDefaults.dateLocale);
const groups = groupArticlesByMonth(articles, surfaceLocale);
---
<section class="gaga-archive-screen" aria-label="Arsip Kronologis">
  <div class="gaga-archive-log" aria-label="Daftar arsip berdasarkan bulan" data-gaga-preview-scope>
    {groups.map((group, index) => (
      <details class="gaga-archive-month" open={index === 0}>
        <summary><h2 id={`archive-${group.slug}`}>{group.month}</h2></summary>
        <ol>
          {group.articles.map((article) => {
            const preview = toArticlePreview(article, surfaceLocale, contentDefaults.preview);
            const cleanSlug = preview.href.replace(/^\/+|\/+$/g, '');
            const canonicalHref = routes.publications.detail(cleanSlug);
            return (
              <li>
                <a
                  href={canonicalHref}
                  data-gaga-preview
                  data-gaga-preview-title={preview.title}
                  data-gaga-preview-href={canonicalHref}
                  data-gaga-preview-snippet={preview.snippet}
                  data-gaga-preview-topics={preview.topics}
                  data-gaga-preview-tags={preview.tags}
                  data-gaga-preview-read-time={preview.readTime}
                  data-gaga-preview-date={preview.date}
                  data-gaga-preview-updated={preview.updated}
                  data-gaga-preview-author={preview.author}
                >{preview.title}</a>
              </li>
            );
          })}
        </ol>
      </details>
    ))}
  </div>
</section>

<style>
.gaga-archive-month { border:0; padding-block:1rem; }
.gaga-archive-month summary { cursor:pointer; min-block-size:44px; }
.gaga-archive-month summary h2 { display:inline; font-size:1.25rem; }
.gaga-archive-month a { text-decoration:underline; text-underline-offset:.18em; }
.gaga-archive-month summary:focus-visible { outline:2px solid var(--gaga-focus-ring); outline-offset:4px; }
</style>
