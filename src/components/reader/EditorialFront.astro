---
import { contentDefaults } from '../../config/content';
import { getEditorialFront } from '../../lib/editorial';
import { toArticlePreview } from '../../lib/content';
import { normalizeContentMetadata, resolveContentDateLocale } from '@gaga/engine-capabilities/content';
import {
  getEnabledRootSections,
  navigationConfig,
  resolveCanonicalTopic,
  resolvePublicationType
} from '../../config/pakrpp-architecture';
import {
  getArchiveYears,
  getCanonicalTopicsWithCounts,
  toCanonicalPublications
} from '../../lib/pakrpp-content';
import { routes } from '../../config/routes';

const route = Astro.locals.gagaRoute;
const metadata = normalizeContentMetadata(route?.entry?.data ?? {});
const surfaceLocale = resolveContentDateLocale(
  metadata.language ?? route?.lang ?? contentDefaults.defaultLanguage,
  contentDefaults.dateLocale
);

const [projection, publications, topics, archiveYears] = await Promise.all([
  getEditorialFront(),
  toCanonicalPublications(),
  getCanonicalTopicsWithCounts(),
  getArchiveYears()
]);

const rootSections = getEnabledRootSections();
const sectionById = new Map(rootSections.map((sec) => [sec.id, sec]));
const limit = navigationConfig.homepagePublicationLimit;
const latestPublications = publications.slice(0, limit);
const recentYears = archiveYears.slice(0, navigationConfig.archivePreviewYears.length);

const latestSection = sectionById.get('latest');
const savedSection = sectionById.get('saved');
const topicsSection = sectionById.get('topics');
const archiveSection = sectionById.get('archive');
const knowledgeSection = sectionById.get('knowledge');
const aboutSection = sectionById.get('about');
const systemSection = sectionById.get('system');
const legalSection = sectionById.get('legal');
const socialSection = sectionById.get('social');
---

<div class="gaga-editorial-front pakrpp-root-index" aria-labelledby="pakrpp-root-title" data-pakrpp-root-index>
  <h1 id="pakrpp-root-title" class="gaga-visually-hidden">PakRPP</h1>

  {/* VIEWPORT STAGE 01: 01 TERBARU (1_08edb1cd.png) */}
  {latestSection && (
    <div
      id="stage-01"
      class="pakrpp-viewport-stage"
      data-pakrpp-viewport-stage="01"
      data-stage-index="1"
      data-stage-badge="01 · TERBARU"
      data-stage-title="01 · Publikasi Terbaru"
      data-stage-anchors="latest,stage-01"
    >
      <div class="pakrpp-viewport-stage__inner pakrpp-viewport-stage__inner--stage01">
        <section id={latestSection.anchor} class="pakrpp-section pakrpp-section--latest" aria-label="Publikasi Terbaru">
          <ol class="pakrpp-publication-list" data-gaga-preview-scope>
            {latestPublications.map((pub, index) => {
              const pubType = resolvePublicationType(pub.type);
              const topicLabels = pub.topics
                .map((topicId) => resolveCanonicalTopic(topicId)?.label ?? topicId)
                .join(', ');
              const contextLabel = [pubType.label, topicLabels, pub.readTime].filter(Boolean).join(' · ');
              const sourceStory = projection.lead?.article.id === pub.id
                ? projection.lead.article
                : projection.highlights.find((h) => h.article.id === pub.id)?.article
                  ?? projection.latest.find((l) => l.article.id === pub.id)?.article;
              const preview = sourceStory
                ? toArticlePreview(sourceStory, surfaceLocale, contentDefaults.preview)
                : undefined;

              return (
                <li class="pakrpp-publication-row">
                  <span class="pakrpp-publication-row__num">{String(index + 1).padStart(2, '0')}</span>
                  <div class="pakrpp-publication-row__main">
                    <a
                      href={pub.canonicalHref}
                      class="pakrpp-publication-row__title"
                      data-gaga-preview
                      data-gaga-preview-title={pub.title}
                      data-gaga-preview-href={pub.canonicalHref}
                      data-gaga-preview-snippet={pub.summary ?? preview?.snippet ?? ''}
                      data-gaga-preview-meta={contextLabel}
                      data-gaga-preview-type={pubType.label}
                      data-gaga-preview-topics={topicLabels}
                      data-gaga-preview-tags={pub.tags.join(', ')}
                      data-gaga-preview-read-time={pub.readTime ?? ''}
                      data-gaga-preview-date={pub.publishedAt ?? ''}
                      data-gaga-preview-updated={pub.updatedAt ?? ''}
                      data-gaga-preview-author={pub.authors.join(', ')}
                    >
                      {pub.title}
                    </a>
                  </div>
                </li>
              );
            })}
          </ol>

          {latestSection.moreLink && (
            <div class="pakrpp-section__footer">
              <a href={latestSection.moreLink.href} class="pakrpp-more-link">
                {latestSection.moreLink.label} →
              </a>
              <a href={routes.publications.index} class="pakrpp-more-link pakrpp-more-link--secondary">
                Indeks Objek Publikasi →
              </a>
            </div>
          )}
        </section>
      </div>
    </div>
  )}

  {/* VIEWPORT STAGE 02: TOPIK · ARSIP · PENGETAHUAN + TERSIMPAN (2_4c136fda.png) */}
  <div
    id="stage-02"
    class="pakrpp-viewport-stage"
    data-pakrpp-viewport-stage="02"
    data-stage-index="2"
    data-stage-badge="02 · EKSPLORASI"
    data-stage-title="02 · Topik, Arsip, Pengetahuan & Tersimpan"
    data-stage-anchors="saved,topics,archive,knowledge,stage-02"
    aria-label="02 Topik, Arsip, Pengetahuan, dan Tersimpan"
  >
    <div class="pakrpp-viewport-stage__inner pakrpp-viewport-stage__inner--stage02">
      <div class="pakrpp-index-grid pakrpp-index-grid--3col">
        {/* Topik */}
        {topicsSection && (
          <section id={topicsSection.anchor} class="pakrpp-tree-section" aria-labelledby="section-topics-heading">
            <div class="pakrpp-tree-section__body">
              <div class="pakrpp-tree-section__head">
                <h3 id="section-topics-heading">{topicsSection.label}</h3>
              </div>
              <ul class="pakrpp-tree-list">
                {topics.map((topic) => (
                  <li class="pakrpp-tree-item">
                    <div class="pakrpp-tree-item__row">
                      <a href={topic.href} class="pakrpp-tree-item__link">{topic.label}</a>
                      <span class="pakrpp-tree-item__count">{topic.count} publikasi</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            {topicsSection.moreLink && (
              <div class="pakrpp-tree-section__foot">
                <a href={topicsSection.moreLink.href} class="pakrpp-more-link">
                  {topicsSection.moreLink.label} →
                </a>
              </div>
            )}
          </section>
        )}

        {/* Arsip */}
        {archiveSection && (
          <section id={archiveSection.anchor} class="pakrpp-tree-section" aria-labelledby="section-archive-heading">
            <div class="pakrpp-tree-section__body">
              <div class="pakrpp-tree-section__head">
                <h3 id="section-archive-heading">{archiveSection.label}</h3>
              </div>
              <ul class="pakrpp-tree-list">
                {recentYears.map((yr) => (
                  <li class="pakrpp-tree-item">
                    <div class="pakrpp-tree-item__row">
                      <a href={yr.href} class="pakrpp-tree-item__link">{yr.year}</a>
                      <span class="pakrpp-tree-item__count">{yr.count} publikasi</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            {archiveSection.moreLink && (
              <div class="pakrpp-tree-section__foot">
                <a href={archiveSection.moreLink.href} class="pakrpp-more-link">
                  {archiveSection.moreLink.label} →
                </a>
              </div>
            )}
          </section>
        )}

        {/* Pengetahuan */}
        {knowledgeSection && (
          <section id={knowledgeSection.anchor} class="pakrpp-tree-section" aria-labelledby="section-knowledge-heading">
            <div class="pakrpp-tree-section__body">
              <div class="pakrpp-tree-section__head">
                <h3 id="section-knowledge-heading">{knowledgeSection.label}</h3>
              </div>
              <ul class="pakrpp-tree-list">
                {(knowledgeSection.items ?? []).map((item) => (
                  <li class="pakrpp-tree-item">
                    <div class="pakrpp-tree-item__row">
                      <a href={item.href} class="pakrpp-tree-item__link">{item.label}</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pakrpp-tree-section__foot">
              <a href={routes.knowledge.root} class="pakrpp-more-link">
                Ikhtisar Pengetahuan →
              </a>
            </div>
          </section>
        )}
      </div>

      {/* Tersimpan (Centered below 3-column grid as shown in 2_4c136fda.png) */}
      {savedSection && (
        <section id={savedSection.anchor} class="pakrpp-saved-centered" aria-labelledby="section-saved-heading">
          <div class="pakrpp-tree-section__head pakrpp-tree-section__head--center">
            <h3 id="section-saved-heading">{savedSection.label}</h3>
          </div>
          <ul class="pakrpp-tree-list pakrpp-tree-list--center" data-pakrpp-saved-root-list>
            <li class="pakrpp-tree-list__empty" data-pakrpp-saved-empty>
              Belum ada publikasi yang disimpan di browser ini. Gunakan aksi Simpan saat membaca artikel.
            </li>
          </ul>
          {savedSection.moreLink && (
            <div class="pakrpp-tree-section__foot pakrpp-tree-section__foot--center">
              <a href={savedSection.moreLink.href} class="pakrpp-more-link">
                {savedSection.moreLink.label} →
              </a>
            </div>
          )}
        </section>
      )}
    </div>
  </div>

  {/* VIEWPORT STAGE 03: TENTANG · SISTEM · LEGAL (3_b7c3348c.png) */}
  <div
    id="stage-03"
    class="pakrpp-viewport-stage"
    data-pakrpp-viewport-stage="03"
    data-stage-index="3"
    data-stage-badge="03 · SISTEM"
    data-stage-title="03 · Tentang, Sistem & Legal"
    data-stage-anchors="about,system,legal,stage-03"
    aria-label="03 Tentang, Sistem, dan Legal"
  >
    <div class="pakrpp-viewport-stage__inner pakrpp-viewport-stage__inner--stage03">
      <div class="pakrpp-index-grid pakrpp-index-grid--3col">
        {aboutSection && (
          <section id={aboutSection.anchor} class="pakrpp-tree-section" aria-labelledby="section-about-heading">
            <div class="pakrpp-tree-section__body">
              <div class="pakrpp-tree-section__head">
                <h3 id="section-about-heading">{aboutSection.label}</h3>
              </div>
              <ul class="pakrpp-tree-list">
                {(aboutSection.items ?? []).map((item) => (
                  <li class="pakrpp-tree-item">
                    <div class="pakrpp-tree-item__row">
                      <a href={item.href} class="pakrpp-tree-item__link">{item.label}</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {systemSection && (
          <section id={systemSection.anchor} class="pakrpp-tree-section" aria-labelledby="section-system-heading">
            <div class="pakrpp-tree-section__body">
              <div class="pakrpp-tree-section__head">
                <h3 id="section-system-heading">{systemSection.label}</h3>
              </div>
              <ul class="pakrpp-tree-list">
                {(systemSection.items ?? []).map((item) => (
                  <li class="pakrpp-tree-item">
                    <div class="pakrpp-tree-item__row">
                      <a href={item.href} class="pakrpp-tree-item__link">{item.label}</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {legalSection && (
          <section id={legalSection.anchor} class="pakrpp-tree-section" aria-labelledby="section-legal-heading">
            <div class="pakrpp-tree-section__body">
              <div class="pakrpp-tree-section__head">
                <h3 id="section-legal-heading">{legalSection.label}</h3>
              </div>
              <ul class="pakrpp-tree-list">
                {(legalSection.items ?? []).map((item) => (
                  <li class="pakrpp-tree-item">
                    <div class="pakrpp-tree-item__row">
                      <a href={item.href} class="pakrpp-tree-item__link">{item.label}</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </div>
    </div>
  </div>

  {/* VIEWPORT STAGE 04: SOSIAL (4_bb5f39c1.png) */}
  {socialSection && (
    <div
      id="stage-04"
      class="pakrpp-viewport-stage"
      data-pakrpp-viewport-stage="04"
      data-stage-index="4"
      data-stage-badge="04 · SOSIAL"
      data-stage-title="04 · Sosial"
      data-stage-anchors="social,stage-04"
      aria-label="04 Sosial"
    >
      <div class="pakrpp-viewport-stage__inner pakrpp-viewport-stage__inner--stage04">
        <section id={socialSection.anchor} class="pakrpp-social-stage" aria-labelledby="section-social-heading">
          <h3 id="section-social-heading" class="gaga-visually-hidden">{socialSection.label}</h3>
          <ul class="pakrpp-social-list">
            {(socialSection.items ?? []).map((item) => (
              <li class="pakrpp-social-item">
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pakrpp-social-link"
                >
                  <span class="pakrpp-social-link__name">{item.label}</span>
                  {item.meta && <span class="pakrpp-social-link__meta">{item.meta}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  )}
</div>

<script>
  import { readArray } from '@gaga/engine-runtime/runtime/storage';
  import { isSavedItem, type SavedItem } from '@gaga/engine-runtime/reader';
  import { onRuntimeEvent } from '@gaga/engine-runtime/runtime/events';
  import { storageKeys } from '../../config/systems';

  function syncSavedRootSection() {
    const listEl = document.querySelector<HTMLUListElement>('[data-pakrpp-saved-root-list]');
    if (!listEl) return;

    const saved = readArray<SavedItem>(storageKeys.saved, isSavedItem).slice(0, 5);
    if (saved.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'pakrpp-tree-list__empty';
      empty.dataset.pakrppSavedEmpty = '';
      empty.textContent = 'Belum ada bacaan tersimpan di perangkat ini.';
      listEl.replaceChildren(empty);
      return;
    }

    const nodes = saved.map((entry) => {
      const li = document.createElement('li');
      li.className = 'pakrpp-tree-item';
      const row = document.createElement('div');
      row.className = 'pakrpp-tree-item__row';
      const a = document.createElement('a');
      a.className = 'pakrpp-tree-item__link';
      a.href = entry.href;
      a.textContent = entry.title || entry.href;
      row.append(a);
      li.appendChild(row);
      return li;
    });

    listEl.replaceChildren(...nodes);
  }

  function initRootViewportSynchronizer() {
    const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-pakrpp-viewport-stage]'));
    if (!stages.length) return;

    function applyStageContext(stage: HTMLElement) {
      const stageId = stage.dataset.pakrppViewportStage ?? '01';
      const stageIndex = stage.dataset.stageIndex ?? '1';
      const badge = stage.dataset.stageBadge ?? '01 · TERBARU';
      const title = stage.dataset.stageTitle ?? 'PakRPP';
      const anchors = (stage.dataset.stageAnchors ?? '')
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);

      // 1. Sync Gaga Dynamic Global Notch
      const statusBadge = document.querySelector<HTMLElement>('[data-gaga-island-status-badge]');
      const peekTitle = document.querySelector<HTMLElement>('[data-gaga-island-peek-title]');
      const focusTitle = document.querySelector<HTMLElement>('[data-gaga-island-focus-title]');

      if (statusBadge) {
        statusBadge.textContent = badge;
        statusBadge.dataset.gagaDefaultBadge = badge;
      }
      if (peekTitle) peekTitle.textContent = title;
      if (focusTitle) focusTitle.textContent = document.querySelector('h1')?.textContent?.trim() || 'PakRPP';

      for (const pill of document.querySelectorAll<HTMLAnchorElement>('[data-gaga-island-anchor]')) {
        const href = pill.getAttribute('href') ?? '';
        const anchorName = href.replace(/^\/?#/, '');
        const active = anchors.includes(anchorName);
        pill.classList.toggle('gaga-is-current', active);
      }

      // 2. Sync Gaga Dynamic Outline Peek (Bottom Pill & Sheet)
      const sheetIdx = document.querySelector<HTMLElement>('[data-gaga-outline-sheet-current-index]');
      const sheetLbl = document.querySelector<HTMLElement>('[data-gaga-outline-sheet-current-label]');
      if (sheetIdx) sheetIdx.textContent = stageIndex;
      if (sheetLbl) sheetLbl.textContent = title;

      for (const tocLink of document.querySelectorAll<HTMLAnchorElement>('[data-gaga-info-field="outline"] a')) {
        const href = tocLink.getAttribute('href') ?? '';
        const targetSlug = href.replace(/^#/, '');
        const isCurrent = targetSlug === `stage-${stageId}` || anchors.includes(targetSlug);
        tocLink.dataset.gagaActive = String(isCurrent);
        if (isCurrent) {
          tocLink.setAttribute('aria-current', 'location');
        } else {
          tocLink.removeAttribute('aria-current');
        }
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        let bestEntry: IntersectionObserverEntry | null = null;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
            bestEntry = entry;
          }
        }
        if (bestEntry && bestEntry.target instanceof HTMLElement) {
          applyStageContext(bestEntry.target);
        }
      },
      {
        root: document.querySelector('[data-gaga-main-region]'),
        threshold: [0.35, 0.6]
      }
    );

    for (const stage of stages) {
      observer.observe(stage);
    }

    // Smoothly scroll to the parent viewport stage when clicking root anchor links or Outline Peek links
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href*="#"]') : null;
      // Skip navigation must keep the browser's native target focus behavior.
      if (!target || target.classList.contains('gaga-skip-link')) return;
      const href = target.getAttribute('href') ?? '';
      if (!href.startsWith('#') && !href.startsWith('/#')) return;
      const id = href.replace(/^\/?#/, '');
      if (!id) return;
      const targetEl = document.getElementById(id);
      if (!targetEl) return;
      const stage = targetEl.closest<HTMLElement>('[data-pakrpp-viewport-stage]') ?? targetEl;
      event.preventDefault();
      stage.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', `#${id}`);
      if (stage.hasAttribute('data-pakrpp-viewport-stage')) {
        applyStageContext(stage);
      }
    });
  }

  function bootRootIndex() {
    syncSavedRootSection();
    onRuntimeEvent('quickActionsSyncRequested', syncSavedRootSection);
    window.addEventListener('pageshow', syncSavedRootSection);
    window.addEventListener('storage', event => { if (event.key === storageKeys.saved || event.key === null) syncSavedRootSection(); });
    initRootViewportSynchronizer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootRootIndex, { once: true });
  } else {
    bootRootIndex();
  }
</script>

<style is:global>
  .gaga-main-region:has([data-pakrpp-root-index]) {
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
  }

  /* Ensure full width for the 4-stage home layout inside main-pane */
  .main-pane:has([data-pakrpp-root-index]),
  .content-panel:has([data-pakrpp-root-index]),
  .gaga-markdown-content:has([data-pakrpp-root-index]) {
    max-width: 100%;
    width: 100%;
  }
</style>

<style>
  .pakrpp-root-index {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding-block: 0;
    font-variant-numeric: tabular-nums;
  }

  .pakrpp-viewport-stage {
    min-block-size: 100svh;
    min-block-size: 100dvh;
    block-size: 100svh;
    block-size: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-block: 3.5rem 3.5rem;
    padding-inline: 1.25rem;
    box-sizing: border-box;
    border: 0;
  }

  .pakrpp-viewport-stage__inner {
    margin-block: auto;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-inline-size: 46rem;
  }

  .pakrpp-viewport-stage__inner--stage01 {
    max-inline-size: 38rem;
  }

  .pakrpp-publication-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .pakrpp-publication-row {
    display: grid;
    grid-template-columns: 2.15rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.35rem;
    padding: clamp(0.18rem, 0.42vh, 0.34rem) 0;
    border: 0;
  }

  .pakrpp-publication-row__num {
    font-family: var(--gaga-font-mono, monospace);
    font-size: 0.75rem;
    color: var(--gaga-muted);
    opacity: 0.72;
  }

  .pakrpp-publication-row__main {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .pakrpp-publication-row__title {
    font-family: var(--gaga-font-body, inherit);
    font-size: clamp(0.86rem, 1.35vh, 0.95rem);
    font-weight: 500;
    color: var(--gaga-ink);
    text-decoration: none;
    line-height: 1.35;
    letter-spacing: var(--gaga-article-letter-spacing, 0em);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pakrpp-publication-row__title:hover {
    text-decoration: underline;
  }

  .pakrpp-section__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(1rem, 2.2vh, 1.75rem);
    padding-top: 0;
  }

  .pakrpp-tree-section__foot {
    display: flex;
    align-items: center;
    margin-top: 1.35rem;
    padding-top: 0;
  }

  .pakrpp-tree-section__foot--center {
    justify-content: center;
    margin-top: 1.15rem;
  }

  .pakrpp-more-link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--gaga-ink);
    text-decoration: none;
  }

  .pakrpp-more-link:hover {
    text-decoration: underline;
  }

  .pakrpp-more-link--secondary {
    color: var(--gaga-muted);
  }

  .pakrpp-index-grid {
    display: grid;
    gap: 2.25rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .pakrpp-index-grid--3col {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .pakrpp-tree-section {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
