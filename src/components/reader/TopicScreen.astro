---
import { getTopicGroups, toArticlePreview, type TopicGroup } from '../../lib/content';
import { contentDefaults } from '../../config/content';
import { i18nCount } from '../../config/i18n';
import { resolveContentDateLocale } from '@gaga/engine-capabilities/content';

interface Props {
  group?: TopicGroup;
  topic?: string;
  dateLocale?: Intl.LocalesArgument;
}

const { group, topic, dateLocale = resolveContentDateLocale(contentDefaults.defaultLanguage, contentDefaults.dateLocale) } = Astro.props;
// Existing MDX supplies a topic label; the active route selects its published group.
const path = Astro.url.pathname.replace(/\/+$/, '');
const safeGroup = group ?? (await getTopicGroups()).find(candidate => candidate.href === path && candidate.topic === topic);
if (!safeGroup) throw new Error(`Published topic group is missing for ${path}`);
---
<section class="gaga-index-screen gaga-topic-screen" data-gaga-topic-screen={safeGroup.slug} data-gaga-topic-count={safeGroup.count} data-gaga-topic-id={safeGroup.contentId} aria-labelledby="topic-title">
  <div class="gaga-screen-section-head">
    <h2 id="topic-title">{safeGroup.topic}</h2>
    <p>{i18nCount('article', safeGroup.count)}</p>
  </div>
  <ol class="gaga-mission-list" aria-label={`Artikel dalam topik ${safeGroup.topic}`} data-gaga-preview-scope>
    {safeGroup.articles.map((article, index) => {
      const preview = toArticlePreview(article, dateLocale, contentDefaults.preview);
      return (
        <li class="gaga-mission-item" data-gaga-motion>
          <a
            href={preview.href}
            class="gaga-mission-link"
            data-gaga-preview
            data-gaga-preview-title={preview.title}
            data-gaga-preview-href={preview.href}
            data-gaga-preview-snippet={preview.snippet}
            data-gaga-preview-topics={preview.topics}
            data-gaga-preview-tags={preview.tags}
            data-gaga-preview-read-time={preview.readTime}
            data-gaga-preview-date={preview.date}
            data-gaga-preview-updated={preview.updated}
            data-gaga-preview-author={preview.author}
          >
            <span class="gaga-mission-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="gaga-mission-title">{preview.title}</span>
          </a>
        </li>
      );
    })}
  </ol>
</section>
