---
import type { GagaMediaCredit } from './types.js';
import type { GagaResponsiveImageCandidate, GagaResponsiveImageSource } from './media-types.js';
import { isSafeMediaLink, isSafeMediaSource } from './media-security.js';

interface Props {
  src: string;
  alt?: string;
  decorative?: boolean;
  width: number | string;
  height: number | string;
  candidates?: GagaResponsiveImageCandidate[];
  sources?: GagaResponsiveImageSource[];
  sizes?: string;
  caption?: string;
  credit?: GagaMediaCredit;
  loading?: 'eager' | 'lazy';
  decoding?: 'sync' | 'async' | 'auto';
  fetchPriority?: 'high' | 'low' | 'auto';
  critical?: boolean;
  class?: string;
}

const {
  src,
  alt,
  decorative = false,
  width,
  height,
  candidates = [],
  sources = [],
  sizes,
  caption,
  credit,
  loading,
  decoding = 'async',
  fetchPriority,
  critical = false,
  class: className = ''
} = Astro.props;

if (!src || !isSafeMediaSource(src)) throw new Error('MediaFigure requires a safe HTTP(S), blob, or relative src.');
if (!decorative && !alt?.trim()) throw new Error('MediaFigure requires alt unless decorative is true.');
if (!Number.isFinite(Number(width)) || Number(width) <= 0 || !Number.isFinite(Number(height)) || Number(height) <= 0) throw new Error('MediaFigure requires positive width and height.');
if (candidates.some((candidate) => !candidate.src?.trim() || !isSafeMediaSource(candidate.src) || !Number.isFinite(candidate.width) || candidate.width <= 0)) throw new Error('MediaFigure candidates require safe src and positive width.');
if (sources.some((source) => !Array.isArray(source.candidates) || source.candidates.length === 0 || source.candidates.some((candidate) => !candidate.src?.trim() || !isSafeMediaSource(candidate.src) || !Number.isFinite(candidate.width) || candidate.width <= 0))) throw new Error('MediaFigure responsive sources require valid safe candidates.');
if (credit?.href && !isSafeMediaLink(credit.href)) throw new Error('MediaFigure credit href is unsafe.');

const renderedAlt = decorative ? '' : alt;
const hasCaption = Boolean(caption || credit);
const renderedLoading = loading ?? (critical ? 'eager' : 'lazy');
const renderedFetchPriority = fetchPriority ?? (critical ? 'high' : 'auto');
const srcset = (items: GagaResponsiveImageCandidate[]) => items.map((candidate) => `${candidate.src} ${candidate.width}w`).join(', ');
---
<figure class:list={['gaga-media', 'gaga-media--figure', className]} data-gaga-media-kind="figure" data-gaga-media-critical={critical ? 'true' : undefined}>
  <picture>
    {sources.map((source) => <source type={source.type} media={source.media} sizes={source.sizes ?? sizes} srcset={srcset(source.candidates)} />)}
    <img
      src={src}
      srcset={candidates.length ? srcset(candidates) : undefined}
      sizes={candidates.length ? sizes : undefined}
      alt={renderedAlt}
      width={width}
      height={height}
      loading={renderedLoading}
      decoding={decoding}
      fetchpriority={renderedFetchPriority}
    />
  </picture>
  {hasCaption ? (
    <figcaption data-gaga-media-caption>
      {caption ? <span>{caption}</span> : null}
      {credit ? (
        <small data-gaga-media-credit>
          {credit.label ? <span>{credit.label}</span> : null}
          {credit.href ? <a href={credit.href}>{credit.text}</a> : <span>{credit.text}</span>}
        </small>
      ) : null}
    </figcaption>
  ) : null}
</figure>
