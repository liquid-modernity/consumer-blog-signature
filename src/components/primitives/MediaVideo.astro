---
import type { GagaMediaCredit, GagaMediaFallback, GagaMediaSource, GagaMediaTrack, GagaMediaTranscript } from './types.js';
import { isSafeMediaLink, isSafeMediaSource } from './media-security.js';

interface Props {
  sources: GagaMediaSource[];
  width?: number | string;
  height?: number | string;
  poster?: string;
  caption?: string;
  fallback?: GagaMediaFallback;
  tracks?: GagaMediaTrack[];
  transcript?: GagaMediaTranscript;
  credit?: GagaMediaCredit;
  preload?: 'none' | 'metadata' | 'auto';
  playsInline?: boolean;
  class?: string;
}

const {
  sources,
  width,
  height,
  poster,
  caption,
  fallback,
  tracks = [],
  transcript,
  credit,
  preload = 'metadata',
  playsInline = true,
  class: className = ''
} = Astro.props;

if (!Array.isArray(sources) || sources.length === 0) throw new Error('MediaVideo requires at least one source.');
if (sources.some((source) => !source.src || !isSafeMediaSource(source.src))) throw new Error('MediaVideo sources require safe HTTP(S), blob, or relative src.');
if ((width !== undefined && (!Number.isFinite(Number(width)) || Number(width) <= 0)) || (height !== undefined && (!Number.isFinite(Number(height)) || Number(height) <= 0))) throw new Error('MediaVideo dimensions must be positive numbers.');
if ((width !== undefined && height === undefined) || (width === undefined && height !== undefined)) throw new Error('MediaVideo requires both width and height when either is provided.');
if (tracks.some((track) => !track.src?.trim() || !track.kind || !isSafeMediaSource(track.src))) throw new Error('MediaVideo tracks require safe src and kind.');
if (tracks.some((track) => track.kind === 'subtitles' && !track.srclang?.trim())) throw new Error('MediaVideo subtitle tracks require srclang.');
if (poster && !isSafeMediaSource(poster)) throw new Error('MediaVideo poster is unsafe.');
if (fallback?.href && !isSafeMediaLink(fallback.href)) throw new Error('MediaVideo fallback href is unsafe.');
if (transcript?.href && !isSafeMediaLink(transcript.href)) throw new Error('MediaVideo transcript href is unsafe.');
if (credit?.href && !isSafeMediaLink(credit.href)) throw new Error('MediaVideo credit href is unsafe.');

const hasCaption = Boolean(caption || transcript || credit);
---
<figure class:list={['gaga-media', 'gaga-media--video', className]} data-gaga-media-kind="video">
  <video controls preload={preload} poster={poster} width={width} height={height} playsinline={playsInline}>
    {sources.map((source) => <source src={source.src} type={source.type} media={source.media} />)}
    {tracks.map((track) => (
      <track src={track.src} kind={track.kind} label={track.label} srclang={track.srclang} default={track.default} />
    ))}
    {fallback ? (
      <>
        {fallback.text}
        {fallback.href ? <a href={fallback.href}>{fallback.href}</a> : null}
      </>
    ) : null}
  </video>
  {hasCaption ? (
    <figcaption data-gaga-media-caption>
      {caption ? <span>{caption}</span> : null}
      {transcript ? <a href={transcript.href} data-gaga-media-transcript>{transcript.label}</a> : null}
      {credit ? (
        <small data-gaga-media-credit>
          {credit.label ? <span>{credit.label}</span> : null}
          {credit.href ? <a href={credit.href}>{credit.text}</a> : <span>{credit.text}</span>}
        </small>
      ) : null}
    </figcaption>
  ) : null}
</figure>
