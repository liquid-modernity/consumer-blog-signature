---
import Icon from '../ui/Icon.astro';

interface CarouselSlide {
  src?: string;
  alt: string;
  title?: string;
  caption?: string;
  credit?: string;
}

interface Props {
  slides: CarouselSlide[];
  title?: string;
  id?: string;
}

const {
  slides,
  title = 'Image Carousel',
  id = `carousel-${Math.random().toString(36).substring(2, 9)}`
} = Astro.props;
---
<section class="gaga-media-carousel" data-gaga-media="carousel" id={id} aria-label={title} tabindex="0">
  <div class="gaga-media-carousel__header">
    <div class="gaga-media-carousel__info">
      <span class="gaga-media-carousel__kicker">CURATED EXHIBIT</span>
      <h3 class="gaga-media-carousel__title">{title}</h3>
    </div>
    <div class="gaga-media-carousel__nav" aria-label="Carousel navigation">
      <span class="gaga-media-carousel__counter" data-gaga-carousel-counter aria-live="polite">
        1 / {slides.length}
      </span>
      <button
        type="button"
        class="gaga-media-carousel__btn"
        data-gaga-carousel-prev
        aria-label="Previous slide"
        data-gaga-tooltip="Previous"
      >
        <Icon name="arrow_back" />
      </button>
      <button
        type="button"
        class="gaga-media-carousel__btn"
        data-gaga-carousel-next
        aria-label="Next slide"
        data-gaga-tooltip="Next"
      >
        <Icon name="chevron_right" />
      </button>
    </div>
  </div>

  <div class="gaga-media-carousel__viewport" data-gaga-carousel-viewport>
    <div class="gaga-media-carousel__track" data-gaga-carousel-track>
      {slides.map((slide, index) => (
        <article
          class="gaga-media-carousel__slide"
          data-gaga-carousel-slide
          aria-hidden={index === 0 ? 'false' : 'true'}
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${slides.length}: ${slide.title || slide.alt}`}
        >
          <div class="gaga-media-carousel__media-wrapper">
            {slide.src ? (
              <img
                src={slide.src}
                alt={slide.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                referrerpolicy="no-referrer"
                class="gaga-media-carousel__image"
              />
            ) : (
              <div class="gaga-media-carousel__fallback">
                <div class="gaga-media-carousel__fallback-grid"></div>
                <div class="gaga-media-carousel__fallback-badge">
                  <Icon name="article" />
                  <span>{slide.title || slide.alt}</span>
                </div>
              </div>
            )}
          </div>
          <div class="gaga-media-carousel__meta">
            {slide.title && <h4 class="gaga-media-carousel__slide-title">{slide.title}</h4>}
            {slide.caption && <p class="gaga-media-carousel__slide-caption">{slide.caption}</p>}
            {slide.credit && <small class="gaga-media-carousel__slide-credit">— {slide.credit}</small>}
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="gaga-media-carousel__dots" role="tablist" aria-label="Slide indicators">
    {slides.map((_, index) => (
      <button
        type="button"
        role="tab"
        class={`gaga-media-carousel__dot ${index === 0 ? 'gaga-is-active' : ''}`}
        data-gaga-carousel-dot={index}
        aria-label={`Go to slide ${index + 1}`}
        aria-selected={index === 0 ? 'true' : 'false'}
      ></button>
    ))}
  </div>
</section>

<script>
  function setupCarousels() {
    document.querySelectorAll<HTMLElement>('[data-gaga-media="carousel"]').forEach((carousel) => {
      if (carousel.dataset.wired) return;
      carousel.dataset.wired = 'true';

      const track = carousel.querySelector<HTMLElement>('[data-gaga-carousel-track]');
      const slides = carousel.querySelectorAll<HTMLElement>('[data-gaga-carousel-slide]');
      const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-gaga-carousel-prev]');
      const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-gaga-carousel-next]');
      const counter = carousel.querySelector<HTMLElement>('[data-gaga-carousel-counter]');
      const dots = carousel.querySelectorAll<HTMLButtonElement>('[data-gaga-carousel-dot]');

      let currentIndex = 0;
      const total = slides.length;

      function updateSlide(newIndex: number) {
        currentIndex = (newIndex + total) % total;
        if (track) {
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
        }

        slides.forEach((slide, idx) => {
          slide.setAttribute('aria-hidden', idx === currentIndex ? 'false' : 'true');
        });

        dots.forEach((dot, idx) => {
          dot.classList.toggle('gaga-is-active', idx === currentIndex);
          dot.setAttribute('aria-selected', idx === currentIndex ? 'true' : 'false');
        });

        if (counter) {
          counter.textContent = `${currentIndex + 1} / ${total}`;
        }
      }

      prevBtn?.addEventListener('click', () => updateSlide(currentIndex - 1));
      nextBtn?.addEventListener('click', () => updateSlide(currentIndex + 1));

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => updateSlide(idx));
      });

      // Keyboard arrow keys
      carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          updateSlide(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          updateSlide(currentIndex + 1);
        }
      });

      // Touch swipe support
      let touchStartX = 0;
      let touchEndX = 0;

      carousel.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      carousel.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      }, { passive: true });

      function handleSwipe() {
        const threshold = 40;
        if (touchEndX < touchStartX - threshold) {
          updateSlide(currentIndex + 1);
        } else if (touchEndX > touchStartX + threshold) {
          updateSlide(currentIndex - 1);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCarousels);
  } else {
    setupCarousels();
  }
</script>

<style>
  .gaga-media-carousel {
    margin: 2.5rem 0;
    width: 100%;
    background: var(--gaga-surface);
    border: 1px solid var(--gaga-line);
    border-radius: var(--gaga-radius-md);
    overflow: hidden;
    outline: none;
  }

  .gaga-media-carousel:focus-visible {
    border-color: var(--gaga-blue);
  }

  .gaga-media-carousel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--gaga-line);
    background: var(--gaga-surface-subtle);
  }

  .gaga-media-carousel__kicker {
    font-family: var(--gaga-font-mono);
    font-size: 0.65rem;
    color: var(--gaga-blue);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .gaga-media-carousel__title {
    margin: 0.2rem 0 0;
    font-size: 1.1rem;
    color: var(--gaga-ink);
    font-weight: 700;
  }

  .gaga-media-carousel__nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .gaga-media-carousel__counter {
    font-family: var(--gaga-font-mono);
    font-size: 0.8rem;
    color: var(--gaga-muted);
    margin-right: 0.4rem;
  }

  .gaga-media-carousel__btn {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: var(--gaga-radius-sm);
    border: 1px solid var(--gaga-line);
    background: var(--gaga-surface);
    color: var(--gaga-ink);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .gaga-media-carousel__btn:hover {
    background: var(--gaga-blue);
    color: var(--gaga-bg);
    border-color: var(--gaga-blue);
  }

  .gaga-media-carousel__viewport {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .gaga-media-carousel__track {
    display: flex;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .gaga-media-carousel__slide {
    flex: 0 0 100%;
    min-width: 100%;
    box-sizing: border-box;
  }

  .gaga-media-carousel__media-wrapper {
    width: 100%;
    aspect-ratio: 16/9;
    background: black;
    overflow: hidden;
    position: relative;
  }

  .gaga-media-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gaga-media-carousel__fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    position: relative;
    background: linear-gradient(135deg, var(--gaga-surface-subtle) 0%, var(--gaga-surface-elevated) 100%);
  }

  .gaga-media-carousel__fallback-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--gaga-line) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.3;
  }

  .gaga-media-carousel__fallback-badge {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--gaga-muted);
    font-family: var(--gaga-font-mono);
    font-size: 0.85rem;
  }

  .gaga-media-carousel__meta {
    padding: 1rem 1.25rem;
    background: var(--gaga-surface);
  }

  .gaga-media-carousel__slide-title {
    margin: 0 0 0.3rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--gaga-ink);
  }

  .gaga-media-carousel__slide-caption {
    margin: 0;
    font-size: 0.9rem;
    color: var(--gaga-muted);
    line-height: 1.5;
  }

  .gaga-media-carousel__slide-credit {
    display: block;
    margin-top: 0.4rem;
    color: var(--gaga-tertiary);
    font-family: var(--gaga-font-mono);
  }

  .gaga-media-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.8rem;
    border-top: 1px solid var(--gaga-line);
    background: var(--gaga-surface-subtle);
  }

  .gaga-media-carousel__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1px solid var(--gaga-line);
    background: var(--gaga-muted);
    cursor: pointer;
    padding: 0;
    transition: all 0.15s ease;
  }

  .gaga-media-carousel__dot.gaga-is-active {
    background: var(--gaga-blue);
    border-color: var(--gaga-blue);
    transform: scale(1.3);
  }
</style>
