---
export interface Props {
  title?: string;
  showBack?: boolean;
  backHref?: string;
  readingTime?: string;
  showProgress?: boolean;
  class?: string;
}

const {
  title = "Signature",
  showBack = false,
  backHref = "/",
  readingTime,
  showProgress = false,
  class: className = "",
} = Astro.props;
---

<header class={`gaga-notch-island-action ${className}`} data-notch-island-action>
  <!-- Wing Left: Back navigation / Home / Brand mark -->
  <div class="gaga-notch-island-action__wing-left">
    {showBack ? (
      <a href={backHref} class="gaga-notch-island-action__btn" aria-label="Go back" title="Back">
        <svg class="gaga-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </a>
    ) : (
      <a href="/" class="gaga-notch-island-action__btn" aria-label="Home" title="Consumer Blog Home">
        <svg class="gaga-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </a>
    )}
    <slot name="left" />
  </div>

  <!-- Island Center: Dynamic island aware capsule (Title/Status/Progress) -->
  <div class="gaga-notch-island-action__island-center" data-island-center>
    <slot name="center">
      <span class="gaga-notch-island-action__title-label" data-island-label>{title}</span>
      {readingTime && (
        <span class="gaga-notch-island-action__pill-badge" data-island-badge>{readingTime}</span>
      )}
      {showProgress && (
        <span class="gaga-notch-island-action__progress-indicator" aria-hidden="true" data-progress-active="true" />
      )}
    </slot>
  </div>

  <!-- Wing Right: Action toggles (Search, Bookmark, Share, Theme/Audio) -->
  <div class="gaga-notch-island-action__wing-right">
    <slot name="right">
      <button type="button" class="gaga-notch-island-action__btn" data-action="search" aria-label="Quick Search" title="Search (Cmd+K)">
        <svg class="gaga-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <button type="button" class="gaga-notch-island-action__btn" data-action="theme" aria-label="Toggle Theme" title="Toggle Theme">
        <svg class="gaga-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>
    </slot>
  </div>
</header>
