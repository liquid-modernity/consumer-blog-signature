---
import Icon from '../ui/Icon.astro';
import { siteConfig } from '../../config/site';
import { identityConfig } from '../../config/identity';
import { i18nLabel } from '../../config/i18n';
import { actionById } from '../../config/actions';
import { experienceConfig, experienceSurfaceProfile, type ExperienceContext } from '../../config/experience';
import { getEnabledRootSections } from '../../config/pakrpp-architecture';
import { globalNavigationProjection } from '../../config/context-rails';
import { contextualRails, resolveNotchPresentation } from '../../config/contextual-ux.mjs';
interface Props { className?: string; context?: ExperienceContext; pageTitle?: string; workspaceId?: string; }
const { className = '', context = 'default', pageTitle = 'PakRPP' } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const profile = experienceSurfaceProfile(context);
const railPolicy = contextualRails(path);
const actions = profile.notchActionIds.filter(id => !['smart-back', 'settings'].includes(id) && (id !== 'context-info' || railPolicy.right)).map(actionById);
const primary = actions.filter(action => action.id !== 'context-info');
const secondary = actions.filter(action => action.id === 'context-info');
const global = globalNavigationProjection();
const islandLabel = i18nLabel('actionIsland.label');
const toggleLabel = i18nLabel('actionIsland.toggle');
const presentation = resolveNotchPresentation(experienceConfig.notch);
---
<div class={`gaga-action-runtime-container gaga-contextual-notch-container ${className}`} data-gaga-action-runtime-container data-gaga-notch-placement={presentation.placement} data-gaga-notch-shape={presentation.shape} data-gaga-notch-config={JSON.stringify(experienceConfig.notch)}>
  <nav class="gaga-action-runtime gaga-dynamic-island gaga-contextual-notch" data-gaga-action-runtime data-gaga-global-nav data-gaga-context={context} data-gaga-state="collapsed" data-gaga-level="0" aria-label={islandLabel.id} data-gaga-i18n-id={islandLabel.id} data-gaga-i18n-en={islandLabel.en} data-gaga-i18n-target="aria">
    <div class="gaga-action-runtime__shell">
      <div class="gaga-island-bar" data-gaga-island-bar>
        <button type="button" class="gaga-notch-button" data-gaga-action="smart-back" aria-label="Kembali" data-gaga-i18n-id="Kembali" data-gaga-i18n-en="Back" data-gaga-i18n-target="aria" disabled={path === '/'}><Icon name="arrow_back" /></button>
        <a href="/" class="gaga-island-brand" aria-label={`${siteConfig.name} — Beranda`}><img src={identityConfig.faviconSvg} width="20" height="20" alt="" /><span>{siteConfig.name}</span></a>
        <button type="button" class="gaga-action-runtime__toggle gaga-notch-button" data-gaga-action-island-toggle aria-label={toggleLabel.id} data-gaga-i18n-id={toggleLabel.id} data-gaga-i18n-en={toggleLabel.en} data-gaga-i18n-target="aria" aria-expanded="false" aria-controls="gaga-notch-context"><Icon name="menu" /></button>
      </div>
      <section id="gaga-notch-context" class="gaga-notch-context" data-gaga-notch-context hidden inert aria-label="Aksi kontekstual">
        {path !== '/' && <p class="gaga-notch-page-title" data-gaga-island-focus-title>{pageTitle}</p>}
        <div class="gaga-notch-actions" data-gaga-action-runtime-actions>
          {primary.map(action => <button type="button" class="gaga-notch-button" data-gaga-action={action.id === 'search' ? undefined : action.id === 'save' ? 'save-reading' : action.command} data-gaga-notch-search-toggle={action.id === 'search' ? '' : undefined} aria-controls={action.id === 'search' ? 'gaga-notch-search' : undefined} aria-expanded={action.id === 'search' ? 'false' : undefined} title={action.label.id} data-gaga-action-id={action.id} data-gaga-quick-action={action.id} aria-label={action.label.id} data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en} data-gaga-i18n-target="aria" aria-pressed={action.kind === 'toggle' ? 'false' : undefined}><Icon name={action.icon ?? 'article'} /><span class="gaga-visually-hidden" data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en}>{action.label.id}</span></button>)}
          <button type="button" class="gaga-notch-button" data-gaga-action="toggle-reader-preferences" aria-controls="gaga-reader-panel" aria-expanded="false" aria-label="Preferensi pembaca" title="Preferensi pembaca"><Icon name="settings" /><span class="gaga-visually-hidden" data-gaga-i18n-id="Preferensi pembaca" data-gaga-i18n-en="Reader preferences">Preferensi pembaca</span></button>
          <button type="button" class="gaga-notch-button" data-gaga-notch-more aria-label="Navigasi situs" title="Navigasi situs" aria-expanded="false" aria-controls="gaga-notch-system"><Icon name="menu" /><span class="gaga-visually-hidden">Navigasi situs</span></button>
        </div>
        <form id="gaga-notch-search" action="/search" role="search" class="gaga-notch-search" data-gaga-notch-search hidden inert>
          <label for="notch-query" class="gaga-visually-hidden">Cari publikasi</label><input id="notch-query" type="search" name="q" placeholder="Cari publikasi…" required /><button class="gaga-notch-button" type="submit" aria-label="Cari"><Icon name="search" /></button>
        </form>
        {context === 'article' && <span class="gaga-visually-hidden" role="progressbar" aria-label="Progres membaca" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-gaga-reading-progress><span class="gaga-visually-hidden" data-gaga-reading-progress-value>0%</span></span>}
      </section>
      <section id="gaga-notch-system" class="gaga-notch-system" data-gaga-notch-system hidden inert aria-label="Pembaca dan navigasi">
        <div class="gaga-notch-actions">
          {secondary.map(action => <button type="button" class="gaga-notch-button" data-gaga-action={action.command} data-gaga-action-id={action.id} data-gaga-quick-action={action.id} aria-label={action.label.id} data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en} data-gaga-i18n-target="aria"><Icon name={action.icon ?? 'article'} /><span class="gaga-visually-hidden" data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en}>{action.label.id}</span></button>)}
        </div>
        {railPolicy.left && <button type="button" class="gaga-notch-button" data-gaga-action="toggle-left-rail" aria-controls="gaga-left-rail"><Icon name="menu" /><span data-gaga-i18n-id="Navigasi bagian" data-gaga-i18n-en="Section navigation">Navigasi bagian</span></button>}
        {path === '/' && <nav class="gaga-notch-navigation" aria-label="Bagian halaman">{getEnabledRootSections().map(section => <a href={'/#' + section.anchor}>{section.label}</a>)}</nav>}
        <div class="gaga-notch-navigation" aria-label="Navigasi situs">{global.items.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}><Icon name={item.icon} /><span data-gaga-i18n-id={item.label} data-gaga-i18n-en={item.labelEn ?? item.label}>{item.label}</span></a>)}</div>
        <details><summary>Direktori informasi</summary>{global.groups.map(group => <section><h2>{group.label}</h2><ul>{group.items.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></section>)}</details>
      </section>
      <slot name="reader" />
      <div data-gaga-action-runtime-live class="gaga-action-runtime__live" hidden></div>
    </div>
  </nav>
</div>
<script>
  import { actionForCommand } from '../../config/actions';
  import { resolveNotchPresentation } from '../../config/contextual-ux.mjs';
  import { onRuntimeEvent, requestOutline, requestReaderPanel } from '@gaga/engine-runtime/runtime/events';
  import { runSiteCommand } from '../../scripts/systems/site-commands';
  import { getUnifiedScrollMetrics, resolveReadingScrollContext } from '../../scripts/systems/reading-scroll';

  function setupActionRuntime() {
    const candidate = document.querySelector<HTMLElement>('[data-gaga-action-runtime]');
    if (!candidate || candidate.dataset.wired === 'true') return;
    const island = candidate;
    island.dataset.wired = 'true';
    const container = island.closest<HTMLElement>('[data-gaga-action-runtime-container]')!;
    const toggle = island.querySelector<HTMLButtonElement>('[data-gaga-action-island-toggle]')!;
    const context = island.querySelector<HTMLElement>('[data-gaga-notch-context]')!;
    const system = island.querySelector<HTMLElement>('[data-gaga-notch-system]')!;
    const more = island.querySelector<HTMLButtonElement>('[data-gaga-notch-more]')!;
    const reader = island.querySelector<HTMLElement>('[data-gaga-reader-panel]');
    const search = island.querySelector<HTMLElement>('[data-gaga-notch-search]')!;
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    let hoverTimer = 0, touchTimer = 0, unsubscribe: (() => void) | undefined;
    const readerOpen = () => reader?.dataset.gagaState === 'open';
    function setState(state: 'collapsed' | 'peek' | 'expanded', restore = false) {
      if (state !== 'expanded' && readerOpen()) requestReaderPanel({ action: 'close', source: 'click' });
      island.dataset.gagaState = state;
      island.dataset.gagaLevel = state === 'collapsed' ? '0' : state === 'peek' ? '1' : '2';
      context.hidden = state === 'collapsed'; context.inert = context.hidden;
      if (state === 'collapsed') { search.hidden = true; search.inert = true; island.querySelector('[data-gaga-notch-search-toggle]')?.setAttribute('aria-expanded','false'); }
      system.hidden = state !== 'expanded'; system.inert = system.hidden;
      toggle.setAttribute('aria-expanded', String(state !== 'collapsed'));
      more.setAttribute('aria-expanded', String(state === 'expanded'));
      if (state !== 'collapsed') requestOutline({ action: 'close', source: 'notch-open' });
      if (restore) (state === 'peek' ? more : toggle).focus({ preventScroll: true });
    }
    // Existing speech/reader adapters also project the shared application state attribute.
    const stateObserver = new MutationObserver(() => {
      const state = island.dataset.gagaState;
      context.hidden = state === 'collapsed' || state === 'micro'; context.inert = context.hidden;
      system.hidden = state !== 'expanded'; system.inert = system.hidden;
      const level = state === 'expanded' ? '2' : state === 'peek' ? '1' : '0';
      if (island.dataset.gagaLevel !== level) island.dataset.gagaLevel = level;
      toggle.setAttribute('aria-expanded', String(level !== '0')); more.setAttribute('aria-expanded', String(level === '2'));
    });
    stateObserver.observe(island, { attributes: true, attributeFilter: ['data-gaga-state'] });
    function position() {
      const preset = resolveNotchPresentation(JSON.parse(container.dataset.gagaNotchConfig!), innerWidth);
      container.dataset.gagaNotchPlacement = preset.placement; container.dataset.gagaNotchShape = preset.shape;
    }
    function progress() {
      const value = Math.round(getUnifiedScrollMetrics().percentage);
      const bar = island.querySelector<HTMLElement>('[data-gaga-reading-progress]');
      bar?.setAttribute('aria-valuenow', String(value)); bar?.style.setProperty('--reading-progress', value + '%');
      const label = island.querySelector('[data-gaga-reading-progress-value]'); if (label) label.textContent = value + '%';
    }
    function bindScroll() { unsubscribe?.(); unsubscribe = resolveReadingScrollContext()?.scrollContext.addChangeListener(progress); progress(); }
    island.addEventListener('pointerenter', () => { clearTimeout(hoverTimer); if (finePointer.matches && island.dataset.gagaState === 'collapsed') hoverTimer = window.setTimeout(() => setState('peek'), 120); });
    island.addEventListener('pointerleave', () => { clearTimeout(hoverTimer); if (finePointer.matches) hoverTimer = window.setTimeout(() => { if (island.dataset.gagaState === 'peek' && !island.matches(':focus-within')) setState('collapsed'); }, 300); });
    island.addEventListener('touchstart', () => { if (island.dataset.gagaState === 'collapsed') touchTimer = window.setTimeout(() => setState('peek'), 280); }, { passive: true });
    island.addEventListener('touchend', () => clearTimeout(touchTimer), { passive: true });
    island.addEventListener('touchcancel', () => clearTimeout(touchTimer), { passive: true });
    island.addEventListener('click', event => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target || target.closest('[data-gaga-reader-panel]')) return;
      if (target.closest('[data-gaga-action-island-toggle]')) { clearTimeout(hoverTimer); setState(island.dataset.gagaState === 'collapsed' ? 'peek' : 'collapsed'); return; }
      if (target.closest('[data-gaga-notch-search-toggle]')) { search.hidden = !search.hidden; search.inert = search.hidden; target.closest('button')?.setAttribute('aria-expanded', String(!search.hidden)); if (!search.hidden) search.querySelector('input')?.focus(); return; }
      if (target.closest('[data-gaga-notch-more]')) { setState(island.dataset.gagaState === 'expanded' ? 'peek' : 'expanded'); return; }
      if (target.closest('a[href], summary')) return;
      const button = target.closest<HTMLButtonElement>('[data-gaga-action]');
      // Let the single Engine Save listener receive the real click exactly once.
      if (button?.dataset.gagaAction === 'save-reading') return;
      const action = actionForCommand(button?.dataset.gagaAction);
      if (button && action?.command) {
        event.preventDefault(); event.stopPropagation();
        if (action.command === 'toggle-reader-preferences') setState('expanded');
        runSiteCommand(action.command, { source: 'click', target: button, pointer: { x: event.clientX, y: event.clientY } });
        return;
      }
      if (target.closest('[data-gaga-island-bar]')) setState('expanded');
    });
    island.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      event.preventDefault(); event.stopPropagation();
      if (!search.hidden) { search.hidden = true; search.inert = true; const opener=island.querySelector<HTMLElement>('[data-gaga-notch-search-toggle]'); opener?.setAttribute('aria-expanded','false'); opener?.focus(); return; }
      if (readerOpen()) requestReaderPanel({ action: 'close', source: 'keyboard' });
      else setState(island.dataset.gagaState === 'expanded' ? 'peek' : 'collapsed', true);
    });
    document.addEventListener('pointerdown', event => {
      if (event.target instanceof Node && !island.contains(event.target)) {
        const closedReader = readerOpen();
        setState('collapsed');
        if (closedReader) requestAnimationFrame(() => toggle.focus({ preventScroll: true }));
      }
    }, { passive: true });
    onRuntimeEvent('readerPanelCommand', detail => { if (detail.action === 'open' || detail.action === 'toggle' && !readerOpen()) setState('expanded'); });
    onRuntimeEvent('layoutChanged', () => { position(); bindScroll(); });
    window.addEventListener('resize', position, { passive: true });
    window.addEventListener('pagehide', () => { stateObserver.disconnect(); unsubscribe?.(); clearTimeout(hoverTimer); clearTimeout(touchTimer); }, { once: true });
    position(); bindScroll(); setState('collapsed');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupActionRuntime, { once: true }); else setupActionRuntime();
</script>
<style is:global>
  :root { --gaga-island-ink:#f7f6f2; --gaga-island-bg:#151513; --gaga-island-hover:#363632; --gaga-island-muted:#c5c5ba; }
  .gaga-app-frame .gaga-contextual-notch-container { inset: auto; top: var(--gaga-safe-area-top, 0px); left: 50%; transform: translateX(-50%); inline-size: max-content; max-inline-size: calc(100vw - 1rem); padding: 0; }
  .gaga-app-frame .gaga-contextual-notch-container[data-gaga-notch-placement='bottom'] { top: auto; bottom: calc(var(--gaga-safe-area-bottom, 0px) + .5rem); }
  .gaga-app-frame .gaga-contextual-notch-container[data-gaga-notch-placement='left'] { top: 50%; left: .5rem; transform: translateY(-50%); }
  .gaga-app-frame .gaga-contextual-notch-container[data-gaga-notch-placement='right'] { top: 50%; left: auto; right: .5rem; transform: translateY(-50%); }
  .gaga-contextual-notch { max-inline-size: calc(100vw - 1rem); color: var(--gaga-island-ink); }
  .gaga-contextual-notch .gaga-action-runtime__shell { display: block; max-block-size: calc(100dvh - 1rem - var(--gaga-safe-area-top, 0px)); overflow: auto; padding: .125rem .25rem; border: 0; border-radius: 0 0 1.1rem 1.1rem; background: var(--gaga-island-bg); color: var(--gaga-island-ink); animation: none !important; transform: none; box-shadow: 0 .35rem 1.25rem #0003; }
  .gaga-contextual-notch-container[data-gaga-notch-shape='island'] .gaga-action-runtime__shell { border-radius: 1rem; margin-block-start: .5rem; }
  .gaga-contextual-notch-container[data-gaga-notch-shape='pill'] .gaga-action-runtime__shell { border-radius: 1.5rem; }
  .gaga-contextual-notch .gaga-island-bar { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; gap: .25rem; min-block-size: 2.75rem; }
  .gaga-contextual-notch .gaga-island-brand { display: inline-flex; gap: .5rem; justify-content: center; align-items: center; min-block-size: 2.75rem; padding-inline: .4rem; color: inherit; text-decoration: none; font: 600 .9rem var(--gaga-font-ui); }
  .gaga-contextual-notch .gaga-island-brand img { flex: none; object-fit: contain; }
  .gaga-contextual-notch .gaga-notch-button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-block-size: 2.75rem; min-inline-size: 2.75rem; max-inline-size: 100%; padding: .45rem .65rem; border: 0; border-radius: .6rem; background: transparent; color: inherit; font: inherit; font-size: .85rem; cursor: pointer; opacity: 1; visibility: visible; pointer-events: auto; }
  .gaga-contextual-notch .gaga-notch-button:disabled { opacity: .4; cursor: default; }
  .gaga-contextual-notch :is(button,a,summary):focus-visible { outline: 2px solid #fff; outline-offset: -3px; }
  .gaga-contextual-notch .gaga-notch-button:is(:hover,[aria-pressed='true']) { background: var(--gaga-island-hover); }
  .gaga-contextual-notch .gaga-notch-context, .gaga-contextual-notch .gaga-notch-system { inline-size: min(28rem, calc(100vw - 2.25rem)); padding: .5rem .25rem; }
  .gaga-contextual-notch [hidden] { display: none !important; }
  .gaga-contextual-notch .gaga-notch-page-title { margin: 0 0 .6rem; font-size: .9rem; line-height: 1.45; overflow-wrap: anywhere; }
  .gaga-contextual-notch .gaga-notch-actions { display: flex; flex-wrap: wrap; gap: .4rem; }
  .gaga-contextual-notch [role='progressbar'] { display: block; margin-block-start: .6rem; font: .75rem var(--gaga-font-mono); }
  .gaga-contextual-notch .gaga-notch-navigation { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .4rem; margin-block: .75rem; }
  .gaga-contextual-notch a { color: inherit; }
  .gaga-contextual-notch .gaga-notch-navigation a { display: flex; align-items: center; gap: .4rem; padding: .5rem; min-block-size: 2.75rem; border-radius: .5rem; text-decoration: underline; text-underline-offset:.18em; }
  .gaga-contextual-notch :is(a[aria-current],a:hover) { background: var(--gaga-island-hover); }
  .gaga-contextual-notch summary { padding: .75rem .25rem; min-block-size: 2.75rem; cursor: pointer; }
  .gaga-contextual-notch details h2 { font-size: .9rem; }
  .gaga-contextual-notch details ul { padding-inline-start: 1.25rem; }
  .gaga-contextual-notch details a { display: inline-block; padding-block: .5rem; }
  .gaga-contextual-notch .gaga-reader-panel { --gaga-surface: #242421; --gaga-surface-2: #242421; --gaga-surface-subtle: #1b1b18; --gaga-blue: var(--gaga-island-ink); --gaga-muted: var(--gaga-island-muted); --gaga-line: #56564e; position: static; inset: auto; display: none; inline-size: min(28rem, calc(100vw - 2.25rem)); width: auto; max-block-size: none; max-height: none; overflow: visible; transform: none; opacity: 1; border: 0; border-radius: 0; box-shadow: none; background: var(--gaga-island-bg); color: var(--gaga-island-ink); transition: none; }
  .gaga-contextual-notch .gaga-reader-panel[data-gaga-state='open'] { display: block; transform: none; }
  .gaga-contextual-notch:not([data-gaga-reader-closing]):has([data-gaga-reader-panel][data-gaga-state='open']) .gaga-notch-context,
  .gaga-contextual-notch:not([data-gaga-reader-closing]):has([data-gaga-reader-panel][data-gaga-state='open']) .gaga-notch-system > :not(.gaga-notch-actions),
  .gaga-contextual-notch:not([data-gaga-reader-closing]):has([data-gaga-reader-panel][data-gaga-state='open']) .gaga-notch-system .gaga-notch-actions > :not([data-gaga-action='toggle-reader-preferences']) { display: none; }
  .gaga-contextual-notch:not([data-gaga-reader-closing]):has([data-gaga-reader-panel][data-gaga-state='open']) .gaga-island-bar { display:none; }
  .gaga-contextual-notch .gaga-reader-panel :is(h2,legend,label,summary,button,span) { color: inherit; }
  .gaga-contextual-notch .gaga-reader-panel button { min-block-size: 2.75rem; min-inline-size: 2.75rem; border-color: #77776c; background: #242421; }
  .gaga-contextual-notch .gaga-reader-panel button[data-gaga-active='true'] { background: var(--gaga-island-ink); color: var(--gaga-island-bg); }
  .gaga-contextual-notch .gaga-reader-panel button[data-gaga-active='true']:focus-visible { outline-color: var(--gaga-island-ink); }
  .gaga-contextual-notch .gaga-notch-search { display:flex; gap:.25rem; margin-block:.5rem; }
  .gaga-contextual-notch input:focus-visible { outline:2px solid var(--gaga-island-ink); outline-offset:-3px; }
  .gaga-contextual-notch .gaga-notch-search input::placeholder { color:var(--gaga-island-muted); opacity:1; }
  .gaga-contextual-notch .gaga-notch-search input { min-inline-size:0; inline-size:100%; border:0; border-radius:.5rem; padding:.7rem; color:var(--gaga-island-ink); background:var(--gaga-island-hover); font:inherit; }
  .gaga-contextual-notch[data-gaga-live-state='speaking'] :is(.gaga-notch-context,.gaga-notch-system) { display:none; }
  .gaga-contextual-notch :is(.gaga-notch-context,.gaga-notch-system,.gaga-reader-panel) { animation:gaga-island-reveal .18s ease-out; }
  @keyframes gaga-island-reveal { from { opacity:.5; transform:translateY(-3px); } to { opacity:1; transform:translateY(0); } }
  @media(prefers-reduced-motion:reduce) { .gaga-contextual-notch *, .gaga-contextual-notch-container { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>
