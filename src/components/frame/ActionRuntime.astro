---
import Icon from '../ui/Icon.astro';

interface Props {
  className?: string;
  context?: 'article' | 'archive' | 'graph' | 'topic' | 'default';
}

const { className = '', context = 'default' } = Astro.props;

type ActionItem = {
  id: string;
  command: string;
  label: string;
  icon: string;
  shortcut?: string;
  tier: 'primary' | 'secondary';
};

const getActionsForContext = (ctx: string): { primary: ActionItem[]; secondary: ActionItem[] } => {
  if (ctx === 'article') {
    return {
      primary: [
        { id: 'back', command: 'smart-back', label: 'Kembali', icon: 'arrow_back', shortcut: 'Alt+←', tier: 'primary' },
        { id: 'share', command: 'share-page', label: 'Bagikan', icon: 'ios_share', shortcut: 'Ctrl+S', tier: 'primary' },
        { id: 'focus', command: 'toggle-focus-mode', label: 'Fokus', icon: 'width_full', shortcut: 'F', tier: 'primary' }
      ],
      secondary: [
        { id: 'highlight', command: 'highlight', label: 'Sorot', icon: 'edit', shortcut: 'H', tier: 'secondary' },
        { id: 'speak', command: 'speak', label: 'Dengarkan', icon: 'volume_up', shortcut: 'S', tier: 'secondary' },
        { id: 'intelligence', command: 'toggle-context-surface', label: 'Intelijen', icon: 'info', tier: 'secondary' },
        { id: 'personalize', command: 'personalize', label: 'Personalisasi', icon: 'settings', shortcut: 'P', tier: 'secondary' }
      ]
    };
  }

  if (ctx === 'archive') {
    return {
      primary: [
        { id: 'back', command: 'smart-back', label: 'Kembali', icon: 'arrow_back', shortcut: 'Alt+←', tier: 'primary' },
        { id: 'share', command: 'share-page', label: 'Bagikan', icon: 'ios_share', shortcut: 'Ctrl+S', tier: 'primary' },
        { id: 'search', command: 'open-search', label: 'Cari', icon: 'search', shortcut: '⌘K', tier: 'primary' }
      ],
      secondary: [
        { id: 'personalize', command: 'personalize', label: 'Personalisasi', icon: 'settings', shortcut: 'P', tier: 'secondary' }
      ]
    };
  }

  if (ctx === 'graph') {
    return {
      primary: [
        { id: 'back', command: 'smart-back', label: 'Kembali', icon: 'arrow_back', shortcut: 'Alt+←', tier: 'primary' },
        { id: 'share', command: 'share-page', label: 'Bagikan', icon: 'ios_share', shortcut: 'Ctrl+S', tier: 'primary' },
        { id: 'reset-graph', command: 'reset-knowledge-graph', label: 'Reset Graf', icon: 'sync', shortcut: 'R', tier: 'primary' }
      ],
      secondary: [
        { id: 'personalize', command: 'personalize', label: 'Personalisasi', icon: 'settings', shortcut: 'P', tier: 'secondary' }
      ]
    };
  }

  return {
    primary: [
      { id: 'back', command: 'smart-back', label: 'Kembali', icon: 'arrow_back', shortcut: 'Alt+←', tier: 'primary' },
      { id: 'share', command: 'share-page', label: 'Bagikan', icon: 'ios_share', shortcut: 'Ctrl+S', tier: 'primary' }
    ],
    secondary: [
      { id: 'personalize', command: 'personalize', label: 'Personalisasi', icon: 'settings', shortcut: 'P', tier: 'secondary' }
    ]
  };
};

const { primary, secondary } = getActionsForContext(context);
const allActions = [...primary, ...secondary];
---
<div class={`gaga-action-runtime-container ${className}`} data-gaga-action-runtime-container>
  <nav
    class="gaga-action-runtime"
    aria-label="Gaga Dynamic Notch Island"
    data-gaga-action-runtime
    data-gaga-context={context}
    data-gaga-state="collapsed"
    data-gaga-live-state="idle"
  >
    <div class="gaga-action-runtime__shell" role="toolbar" aria-label="Reading & Page Actions">
      {context === 'article' ? (
        <span class="gaga-action-runtime__progress-track" aria-hidden="true">
          <span class="gaga-action-runtime__progress-fill"></span>
        </span>
      ) : null}

      <div class="gaga-action-runtime__actions" data-gaga-action-runtime-actions>
        {allActions.map((act, index) => (
          <button
            type="button"
            class={`gaga-action-runtime__btn ${index === 0 ? 'gaga-action-runtime__btn--anchor' : ''}`}
            data-gaga-action={act.command}
            data-gaga-action-id={act.id}
            data-gaga-action-tier={act.tier}
            data-gaga-tooltip={act.shortcut ? `${act.label} (${act.shortcut})` : act.label}
            aria-label={act.shortcut ? `${act.label} (${act.shortcut})` : act.label}
          >
            <span class="gaga-action-runtime__icon" aria-hidden="true">
              <Icon name={act.icon} />
            </span>
            <span class="gaga-action-runtime__label">{act.label}</span>
          </button>
        ))}
      </div>

      <div class="gaga-action-runtime__status" data-gaga-action-runtime-status aria-live="polite">
        {context === 'article' ? (
          <span
            class="gaga-action-runtime__reading-progress"
            data-gaga-reading-progress
            role="progressbar"
            aria-label="Progres membaca"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <span data-gaga-reading-progress-value>0%</span>
          </span>
        ) : (
          <span class="gaga-action-runtime__context-label">Actions</span>
        )}
      </div>

      <button
        type="button"
        class="gaga-action-runtime__toggle"
        data-gaga-action-island-toggle
        aria-expanded="false"
        aria-label="Buka aksi halaman"
      >
        <span aria-hidden="true"><Icon name="menu" /></span>
      </button>

      <div class="gaga-action-runtime__live" data-gaga-action-runtime-live hidden></div>
    </div>
  </nav>
</div>

<script>
  import { onRuntimeEvent } from '@gaga/engine-web/runtime/events';
  import { runSiteCommand } from '../../scripts/systems/site-commands';
  import { getUnifiedScrollMetrics, resolveReadingScrollContext } from '../../scripts/systems/reading-scroll';

  function setupActionRuntime() {
    const runtime = document.querySelector<HTMLElement>('[data-gaga-action-runtime]');
    if (!runtime || runtime.dataset.wired === 'true') return;
    runtime.dataset.wired = 'true';

    const toggle = runtime.querySelector<HTMLButtonElement>('[data-gaga-action-island-toggle]');
    const progress = runtime.querySelector<HTMLElement>('[data-gaga-reading-progress]');
    const progressValue = runtime.querySelector<HTMLElement>('[data-gaga-reading-progress-value]');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let unsubscribeScroll: (() => void) | null = null;
    let lastScrollTop = 0;
    let scheduled = false;
    let hoverTimer = 0;

    const isSpeaking = () => runtime.dataset.gagaLiveState === 'speaking';
    const isExpanded = () => runtime.dataset.gagaState === 'expanded';

    function setState(state: 'micro' | 'collapsed' | 'expanded') {
      if (isSpeaking() && state !== 'expanded') return;
      runtime.dataset.gagaState = state;
      toggle?.setAttribute('aria-expanded', state === 'expanded' ? 'true' : 'false');
      if (toggle) toggle.setAttribute('aria-label', state === 'expanded' ? 'Tutup aksi halaman' : 'Buka aksi halaman');
    }

    function updateProgress() {
      scheduled = false;
      if (!progress || !progressValue) return;
      const metrics = getUnifiedScrollMetrics();
      const rounded = Math.round(metrics.percentage);
      runtime.style.setProperty('--gaga-action-progress', `${Math.max(0, Math.min(1, metrics.percentage / 100))}`);
      progressValue.textContent = `${rounded}%`;
      progress.setAttribute('aria-valuenow', String(rounded));

      const delta = metrics.scrollTop - lastScrollTop;
      if (!isExpanded() && !isSpeaking()) {
        if (metrics.scrollTop > 120 && delta > 10) setState('micro');
        else if (delta < -7 || metrics.scrollTop < 72) setState('collapsed');
      }
      lastScrollTop = metrics.scrollTop;
    }

    function scheduleProgress() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateProgress);
    }

    function bindReadingProgress() {
      unsubscribeScroll?.();
      const context = resolveReadingScrollContext();
      unsubscribeScroll = context?.scrollContext.addChangeListener(scheduleProgress) ?? null;
      lastScrollTop = getUnifiedScrollMetrics().scrollTop;
      scheduleProgress();
    }

    runtime.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const islandToggle = target.closest<HTMLButtonElement>('[data-gaga-action-island-toggle]');
      if (islandToggle) {
        setState(isExpanded() ? 'collapsed' : 'expanded');
        return;
      }

      const button = target.closest<HTMLButtonElement>('[data-gaga-action]');
      if (!button) return;
      const rawAction = button.dataset.gagaAction;
      if (!rawAction) return;

      const command = rawAction === 'personalize' ? 'toggle-reader-preferences' : rawAction;
      runSiteCommand(command as any, {
        source: 'action-runtime',
        target: button,
        pointer: { x: event.clientX, y: event.clientY }
      });

      if (rawAction !== 'speak' && rawAction !== 'toggle-focus-mode' && rawAction !== 'personalize') {
        setState('collapsed');
      }
    });

    runtime.addEventListener('pointerenter', () => {
      if (!finePointer.matches || isSpeaking()) return;
      window.clearTimeout(hoverTimer);
      setState('expanded');
    });

    runtime.addEventListener('pointerleave', () => {
      if (!finePointer.matches || isSpeaking()) return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        if (!runtime.matches(':focus-within')) setState('collapsed');
      }, 220);
    });

    document.addEventListener('pointerdown', (event) => {
      if (!isExpanded() || runtime.contains(event.target as Node) || isSpeaking()) return;
      setState('collapsed');
    }, { passive: true });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isExpanded() && !isSpeaking()) setState('collapsed');
    });

    if (progress) {
      bindReadingProgress();
      onRuntimeEvent('layoutChanged', bindReadingProgress);
      window.addEventListener('resize', scheduleProgress, { passive: true });
    }

    window.addEventListener('pagehide', () => {
      unsubscribeScroll?.();
      window.clearTimeout(hoverTimer);
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupActionRuntime, { once: true });
  } else {
    setupActionRuntime();
  }
</script>
