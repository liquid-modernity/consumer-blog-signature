---
import Icon from '../ui/Icon.astro';
import { actionById } from '../../config/actions';
import { experienceSurfaceProfile, type ExperienceContext } from '../../config/experience';
import { i18nLabel } from '../../config/i18n';
import { globalNavigationProjection } from '../../config/context-rails';
import {
  getEnabledRootSections,
   getEnabledTopics,
  styleArchetypeRegistry
} from '../../config/pakrpp-architecture';
import { routes } from '../../config/routes';
import { normalizeSitePath } from '../../lib/url-semantics';

interface Props {
  className?: string;
  context?: ExperienceContext;
  pageTitle?: string;
  workspaceId?: string;
}

const {
  className = '',
  context = 'default',
  pageTitle = 'PakRPP',
  workspaceId = 'page'
} = Astro.props;

const currentPath = normalizeSitePath(Astro.url.pathname);
const profile = experienceSurfaceProfile(context);
const actions = profile.notchActionIds
  .map((id) => actionById(id))
  .filter((action) => Boolean(action.command));

const global = globalNavigationProjection();
const globalItems = global.items;
const infoGroups = global.groups;
const archetypes = styleArchetypeRegistry;
const notchThemes = [
  { id: 'default', label: 'Blueprint', summary: 'Tema gelap biru struktural khas PakRPP' },
  { id: 'dark', label: 'Gelap', summary: 'Tema gelap monokrom untuk fokus baca malam' },
  { id: 'paper', label: 'Kertas', summary: 'Tema terang hangat menyerupai kertas cetak' },
  { id: 'sepia', label: 'Sepia', summary: 'Tema klasik hangat untuk bacaan panjang' }
] as const;
const archetypeShortLabels: Record<string, string> = {
  editorial: 'Editorial',
  brutalism: 'Brutalism',
  blueprintism: 'Blueprint',
  enterprise: 'Institusional'
};
const rootSections = getEnabledRootSections();
const canonicalTopics = getEnabledTopics();

const isCurrent = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath === href || currentPath.startsWith(`${href}/`);

const isInfoActive = infoGroups.some((group) => group.items.some((item) => isCurrent(item.href)));

// Determine semantic context mode for the Dynamic Island
type IslandContextMode = 'article' | 'index' | 'topics' | 'archive' | 'knowledge' | 'saved' | 'system';

const islandMode: IslandContextMode = (() => {
  if (context === 'article' || currentPath.startsWith('/publications/')) return 'article';
  if (currentPath === '/' || currentPath === '/latest' || currentPath === '/publications') return 'index';
  if (currentPath.startsWith('/topics')) return 'topics';
  if (currentPath.startsWith('/archive')) return 'archive';
  if (currentPath.startsWith('/knowledge') || currentPath.startsWith('/graphs') || currentPath.startsWith('/tags')) return 'knowledge';
  if (currentPath.startsWith('/saved') || currentPath.startsWith('/library')) return 'saved';
  return 'system';
})();

const contextBadgeMap: Record<IslandContextMode, string> = {
  article: 'BACA',
  index: 'INDEKS',
  topics: 'TOPIK',
  archive: 'ARSIP',
  knowledge: 'PENGETAHUAN',
  saved: 'TERSIMPAN',
  system: workspaceId.toUpperCase()
};

const activeBadgeText = contextBadgeMap[islandMode];

// Select up to 3 contextual quick items for the Peek state
const peekQuickLinks = (() => {
  if (islandMode === 'index') {
    return [
      { label: 'Cari', href: '/search', icon: 'search' },
      { label: 'Publikasi', href: routes.publications.index, icon: 'article' },
      { label: 'Topik', href: routes.topics.index, icon: 'grid_view' }
    ];
  }
  if (islandMode === 'topics' || islandMode === 'archive') {
    return canonicalTopics.map((t) => ({
      label: t.label,
      href: routes.topics.detail(t.slug),
      icon: 'grid_view'
    }));
  }
  if (islandMode === 'knowledge') {
    return [
      { label: 'Graf', href: routes.knowledge.graph, icon: 'account_tree' },
      { label: 'Indeks', href: routes.knowledge.index, icon: 'lan' },
      { label: 'Rujukan', href: routes.knowledge.references, icon: 'book' }
    ];
  }
  return [
    { label: 'Beranda', href: '/', icon: 'home' },
    { label: 'Cari', href: '/search', icon: 'search' },
    { label: 'Tersimpan', href: routes.discovery.saved, icon: 'bookmark' }
  ];
})();

const islandLabel = i18nLabel('actionIsland.label');
const toolbarLabel = i18nLabel('actionIsland.toolbar');
const progressLabel = i18nLabel('actionIsland.progress');
const toggleLabel = i18nLabel('actionIsland.toggle');
const actionsLabel = i18nLabel('actionIsland.actions');
---
<div
  data-gaga-surface="action-runtime"
  data-gaga-signature-surface="dynamic-global-navigation"
  class={`gaga-action-runtime-container ${className}`}
  data-gaga-action-runtime-container
>
  <nav
    class="gaga-action-runtime gaga-dynamic-island"
    aria-label={islandLabel.id}
    data-gaga-i18n-key={islandLabel.key}
    data-gaga-i18n-id={islandLabel.id}
    data-gaga-i18n-en={islandLabel.en}
    data-gaga-i18n-target="aria"
    data-gaga-action-runtime
    data-gaga-global-nav
    data-gaga-context={context}
    data-gaga-island-mode={islandMode}
    data-gaga-state="collapsed"
    data-gaga-live-state="idle"
  >
    <div
      class="gaga-action-runtime__shell"
      role="toolbar"
      aria-label={toolbarLabel.id}
      data-gaga-i18n-key={toolbarLabel.key}
      data-gaga-i18n-id={toolbarLabel.id}
      data-gaga-i18n-en={toolbarLabel.en}
      data-gaga-i18n-target="aria"
    >
      {context === 'article' ? (
        <svg class="gaga-action-runtime__perimeter" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="gaga-action-runtime__perimeter-track" pathLength="1" d="M0.5 0.5 H99.5 V29 Q99.5 39.5 89 39.5 H11 Q0.5 39.5 0.5 29 Z" />
          <path class="gaga-action-runtime__perimeter-progress" pathLength="1" d="M0.5 0.5 H99.5 V29 Q99.5 39.5 89 39.5 H11 Q0.5 39.5 0.5 29 Z" />
        </svg>
      ) : null}

      {/* STAGE 1 & 2 BAR: IDLE COMPACT + PEEK BAR */}
      <div class="gaga-island-bar" data-gaga-island-bar>
        <a
          class="gaga-island-brand"
          href="/"
          aria-label="PakRPP Knowledge Publication System"
          data-gaga-tooltip="PakRPP"
        >
          <span class="gaga-island-brand__sensor" aria-hidden="true"></span>
          <span class="gaga-island-brand__name">PakRPP</span>
        </a>

        {/* PEEK LAYER: Shown on Hover / Long-Press (data-gaga-state="peek") */}
        <div class="gaga-island-peek" data-gaga-island-peek>
          <span class="gaga-island-peek__sep" aria-hidden="true"></span>
          <span class="gaga-island-peek__title" data-gaga-island-peek-title>
            {islandMode === 'article' ? pageTitle : activeBadgeText}
          </span>

          {islandMode === 'article' ? (
            <div class="gaga-island-peek__actions">
              {actions.slice(0, 3).map((action) => (
                <button
                  type="button"
                  class="gaga-island-chip"
                  data-gaga-action={action.command}
                  data-gaga-action-id={action.id}
                  aria-label={action.label.id}
                  title={action.label.id}
                >
                  {action.icon && <Icon name={action.icon} />}
                  <span>{action.label.id}</span>
                </button>
              ))}
            </div>
          ) : (
            <div class="gaga-island-peek__actions">
              {peekQuickLinks.map((item) => (
                <a
                  href={item.href}
                  class:list={['gaga-island-chip', isCurrent(item.href) && 'gaga-is-current']}
                >
                  <Icon name={item.icon} />
                  <span>{item.label}</span>
                </a>
              ))}
            </div>
          )}
        </div>

        {/* IDLE STATUS INDICATOR (Right side of Compact Capsule) */}
        <div class="gaga-action-runtime__status" data-gaga-action-runtime-status aria-live="polite">
          {context === 'article' ? (
            <span
              class="gaga-action-runtime__reading-progress"
              data-gaga-reading-progress
              role="progressbar"
              aria-label={progressLabel.id}
              data-gaga-i18n-key={progressLabel.key}
              data-gaga-i18n-id={progressLabel.id}
              data-gaga-i18n-en={progressLabel.en}
              data-gaga-i18n-target="aria"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
            >
              <span data-gaga-reading-progress-value>0%</span>
            </span>
          ) : (
            <span
              class="gaga-action-runtime__context-label"
              data-gaga-island-status-badge
              data-gaga-default-badge={activeBadgeText}
              data-gaga-i18n-key={actionsLabel.key}
              data-gaga-i18n-id={activeBadgeText}
              data-gaga-i18n-en={activeBadgeText}
            >
              {activeBadgeText}
            </span>
          )}
        </div>

        {/* EXPAND / COLLAPSE TRIGGER */}
        <button
          type="button"
          class="gaga-action-runtime__toggle"
          data-gaga-action-island-toggle
          aria-expanded="false"
          aria-label={toggleLabel.id}
          data-gaga-i18n-key={toggleLabel.key}
          data-gaga-i18n-id={toggleLabel.id}
          data-gaga-i18n-en={toggleLabel.en}
          data-gaga-i18n-target="aria"
        >
          <span aria-hidden="true"><Icon name="menu" /></span>
        </button>

        <div class="gaga-action-runtime__live" data-gaga-action-runtime-live hidden></div>
      </div>

      {/* STAGE 3: EXPANDED CONTEXT-AWARE DYNAMIC ISLAND CARD */}
      <div class="gaga-island-expanded" data-gaga-notch-tray>
        {/* ZONE A: CONTEXT-AWARE PRIMARY DECK */}
        <section class="gaga-island-zone gaga-island-zone--context" aria-label="Konteks Halaman Aktif">
          <div class="gaga-island-zone__header">
            <span class="gaga-island-zone__kicker">
              KONTEKS AKTIF · {activeBadgeText}
            </span>
            <span class="gaga-island-zone__page-title" data-gaga-island-focus-title>
              {pageTitle}
            </span>
          </div>

          {/* Context-specific controls based on islandMode */}
          {islandMode === 'index' && (
            <div class="gaga-island-context-deck">
              <div class="gaga-island-anchor-pills" role="group" aria-label="Loncat ke bagian halaman utama">
                {rootSections.map((sec) => (
                  <a href={`/#${sec.anchor}`} class="gaga-island-pill" data-gaga-island-anchor>
                    #{sec.label}
                  </a>
                ))}
              </div>
            </div>
          )}

          {(islandMode === 'topics' || islandMode === 'archive') && (
            <div class="gaga-island-context-deck">
              <div class="gaga-island-anchor-pills" role="group" aria-label="Filter Topik & Arsip">
                {canonicalTopics.map((topic) => (
                  <a
                    href={routes.topics.detail(topic.slug)}
                    class:list={['gaga-island-pill', isCurrent(routes.topics.detail(topic.slug)) && 'gaga-is-current']}
                  >
                    Topik: {topic.label}
                  </a>
                ))}
                <a href={routes.archive.index} class:list={['gaga-island-pill', isCurrent(routes.archive.index) && 'gaga-is-current']}>
                  Arsip Kronologis
                </a>
                <a href={routes.archive.year(2026)} class:list={['gaga-island-pill', isCurrent(routes.archive.year(2026)) && 'gaga-is-current']}>
                  2026
                </a>
                <a href={routes.archive.year(2025)} class:list={['gaga-island-pill', isCurrent(routes.archive.year(2025)) && 'gaga-is-current']}>
                  2025
                </a>
              </div>
            </div>
          )}

          {islandMode === 'knowledge' && (
            <div class="gaga-island-context-deck">
              <div class="gaga-island-anchor-pills" role="group" aria-label="Eksplorasi Pengetahuan">
                <a href={routes.knowledge.graph} class:list={['gaga-island-pill', isCurrent(routes.knowledge.graph) && 'gaga-is-current']}>
                  Graf Pengetahuan
                </a>
                <a href={routes.knowledge.index} class:list={['gaga-island-pill', isCurrent(routes.knowledge.index) && 'gaga-is-current']}>
                  Indeks Sistematis
                </a>
                <a href={routes.knowledge.tags} class:list={['gaga-island-pill', isCurrent(routes.knowledge.tags) && 'gaga-is-current']}>
                  Tag Lintas Topik
                </a>
                <a href={routes.knowledge.references} class:list={['gaga-island-pill', isCurrent(routes.knowledge.references) && 'gaga-is-current']}>
                  Rujukan Primer
                </a>
              </div>
            </div>
          )}

          {/* Contextual runtime actions for the active surface */}
          <div class="gaga-action-runtime__actions gaga-island-runtime-actions" data-gaga-action-runtime-actions>
            {actions.map((action, index) => (
              <button
                type="button"
                class={`gaga-action-runtime__btn ${index === 0 ? 'gaga-action-runtime__btn--anchor' : ''}`}
                data-gaga-action={action.command}
                data-gaga-action-id={action.id}
                data-gaga-quick-action={action.id}
                data-gaga-active="false"
                data-gaga-tooltip={action.label.id}
                aria-label={action.label.id}
                data-gaga-i18n-key={action.label.key}
                data-gaga-i18n-id={action.label.id}
                data-gaga-i18n-en={action.label.en}
                data-gaga-i18n-target="aria"
              >
                {action.icon ? (
                  <span class="gaga-action-runtime__icon" aria-hidden="true"><Icon name={action.icon} /></span>
                ) : null}
                <span class="gaga-action-runtime__label" data-gaga-i18n-key={action.label.key} data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en}>{action.label.id}</span>
              </button>
            ))}
          </div>
        </section>

        {/* ZONE B: GLOBAL NAVIGATION & SYSTEM DIRECTORY */}
        <section class="gaga-island-zone gaga-island-zone--nav" aria-label="Navigasi Global">
          <div class="gaga-island-global-nav">
            {globalItems.map((item) => (
              <a
                class:list={['gaga-island-nav-item', isCurrent(item.href) && 'gaga-is-current']}
                href={item.href}
                aria-label={item.label}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                data-gaga-global-destination={item.id}
              >
                <Icon name={item.icon} />
                <span>{item.label}</span>
              </a>
            ))}

            <button
              class:list={['gaga-island-nav-item', 'gaga-notch-info-trigger', isInfoActive && 'gaga-is-current']}
              type="button"
              aria-label="Direktori Informasi"
              aria-expanded="false"
              aria-haspopup="dialog"
              data-gaga-info-trigger
            >
              <Icon name="info" />
              <span>Direktori</span>
            </button>
          </div>

          <div
            class="gaga-notch-info-flyout"
            role="dialog"
            aria-label="Information & publication surface"
            data-gaga-info-flyout
            hidden
          >
            <div class="gaga-notch-info-flyout__head">
              <span class="gaga-notch-info-flyout__kicker">DIREKTORI SISTEM · PAKRPP</span>
              <button
                class="gaga-notch-info-flyout__close"
                type="button"
                aria-label="Close information"
                data-gaga-info-close
              >
                <Icon name="close" />
              </button>
            </div>
            <div class="gaga-notch-info-flyout__groups">
              {infoGroups.map((group) => (
                <section class="gaga-notch-info-flyout__group">
                  <p>{group.label}</p>
                  <div class="gaga-notch-info-flyout__links">
                    {group.items.map((link) => (
                      <a
                        href={link.href}
                        class:list={['gaga-notch-info-flyout__link', isCurrent(link.href) && 'gaga-is-current']}
                      >
                        <Icon name={link.icon} />
                        <span>{link.label}</span>
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        </section>

        {/* ZONE C: DYNAMIC STYLE ARCHETYPES & APPEARANCE */}
        <section class="gaga-island-zone gaga-island-zone--archetypes" aria-label="Kustomisasi Tema, Arketipe Desain & Token Tampilan">
          <div class="gaga-notch-appearance-grid">
            <div class="gaga-notch-appearance-group" role="group" aria-label="Tema Warna">
              <span class="gaga-notch-appearance-group__label">TEMA</span>
              <div class="gaga-notch-archetypes">
                {notchThemes.map((t) => (
                  <button
                    type="button"
                    class="gaga-notch-archetype-btn"
                    data-gaga-reader-pref="theme"
                    data-gaga-reader-value={t.id}
                    title={t.summary}
                    aria-pressed="false"
                  >
                    {t.label}
                  </button>
                ))}
              </div>
            </div>

            <div class="gaga-notch-appearance-group" role="group" aria-label="Arketipe Desain">
              <span class="gaga-notch-appearance-group__label">ARKETIPE</span>
              <div class="gaga-notch-archetypes">
                {archetypes.map((arch) => (
                  <button
                    type="button"
                    class="gaga-notch-archetype-btn"
                    data-gaga-reader-pref="identity"
                    data-gaga-reader-value={arch.id}
                    title={arch.summary}
                    aria-pressed="false"
                  >
                    {archetypeShortLabels[arch.id] ?? arch.label}
                  </button>
                ))}
              </div>
            </div>

            <button
              type="button"
              class="gaga-notch-archetype-btn gaga-notch-archetype-btn--tokens"
              data-gaga-action="toggle-reader-preferences"
              title="Buka panel penuh untuk kustomisasi tipografi, ukuran teks, kerapatan, dan token tampilan"
            >
              <Icon name="settings" />
              <span>Token &amp; Tampilan</span>
            </button>
          </div>
        </section>
      </div>
    </div>
  </nav>
</div>

<script>
  import { onRuntimeEvent } from '@gaga/engine-runtime/runtime/events';
  import { runSiteCommand } from '../../scripts/systems/site-commands';
  import { getUnifiedScrollMetrics, resolveReadingScrollContext } from '../../scripts/systems/reading-scroll';
  import {
    applyIdentity,
    applyTheme,
    readIdentityPreference,
    readThemePreference
  } from '../../scripts/systems/theme';

  type IslandState = 'micro' | 'collapsed' | 'peek' | 'expanded';

  function setupActionRuntime() {
    const runtime = document.querySelector<HTMLElement>('[data-gaga-action-runtime]');
    if (!runtime || runtime.dataset.wired === 'true') return;
    const island = runtime;
    island.dataset.wired = 'true';

    // Synchronize active Theme and Design Archetype buttons inside the Notch
    applyTheme(readThemePreference());
    applyIdentity(readIdentityPreference());

    const toggle = island.querySelector<HTMLButtonElement>('[data-gaga-action-island-toggle]');
    const infoTrigger = island.querySelector<HTMLButtonElement>('[data-gaga-info-trigger]');
    const infoFlyout = island.querySelector<HTMLElement>('[data-gaga-info-flyout]');
    const progress = island.querySelector<HTMLElement>('[data-gaga-reading-progress]');
    const progressValue = island.querySelector<HTMLElement>('[data-gaga-reading-progress-value]');
    const statusBadge = island.querySelector<HTMLElement>('[data-gaga-island-status-badge]');
    const peekTitle = island.querySelector<HTMLElement>('[data-gaga-island-peek-title]');
    const focusTitle = island.querySelector<HTMLElement>('[data-gaga-island-focus-title]');
    const defaultBadge = statusBadge?.dataset.gagaDefaultBadge ?? 'INDEKS';
    const defaultTitle = focusTitle?.textContent?.trim() ?? 'PakRPP';

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let unsubscribeScroll: (() => void) | null = null;
    let lastScrollTop = 0;
    let scheduled = false;
    let hoverTimer = 0;
    let longPressTimer = 0;
    let intentTimer = 0;

    const isSpeaking = () => island.dataset.gagaLiveState === 'speaking';
    const isExpanded = () => island.dataset.gagaState === 'expanded';
    const isPeek = () => island.dataset.gagaState === 'peek';

    function setInfoOpen(open: boolean) {
      if (!infoFlyout || !infoTrigger) return;
      infoFlyout.toggleAttribute('hidden', !open);
      infoTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) setState('expanded');
    }

    function setState(state: IslandState) {
      if (isSpeaking() && state !== 'expanded') return;
      island.dataset.gagaState = state;
      toggle?.setAttribute('aria-expanded', state === 'expanded' ? 'true' : 'false');
      if (state !== 'expanded' && infoFlyout && !infoFlyout.hasAttribute('hidden')) {
        infoFlyout.setAttribute('hidden', '');
        infoTrigger?.setAttribute('aria-expanded', 'false');
      }
    }

    function acknowledgeIntent() {
      if (isExpanded() || isSpeaking()) return;
      island.dataset.gagaIntent = 'aware';
      window.clearTimeout(intentTimer);
      intentTimer = window.setTimeout(() => {
        delete island.dataset.gagaIntent;
      }, 900);
    }

    function updateProgress() {
      scheduled = false;
      const metrics = getUnifiedScrollMetrics();
      if (progress && progressValue) {
        const percentage = Math.max(0, Math.min(100, metrics.percentage));
        const rounded = Math.round(percentage);
        const progressRatio = percentage / 100;
        island.style.setProperty('--gaga-action-progress-offset', `${1 - progressRatio}`);
        progressValue.textContent = `${rounded}%`;
        progress.setAttribute('aria-valuenow', String(rounded));
      }

      const delta = metrics.scrollTop - lastScrollTop;
      if (!isExpanded() && !isPeek() && !isSpeaking()) {
        if (metrics.scrollTop > 140 && delta > 10) setState('micro');
        else if (delta < -6 || metrics.scrollTop < 84) {
          setState('collapsed');
          acknowledgeIntent();
        }
      }
      lastScrollTop = metrics.scrollTop;
    }

    function scheduleProgress() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateProgress);
    }

    function bindReadingProgress() {
      unsubscribeScroll?.();
      const context = resolveReadingScrollContext();
      unsubscribeScroll = context?.scrollContext.addChangeListener(scheduleProgress) ?? null;
      lastScrollTop = getUnifiedScrollMetrics().scrollTop;
      scheduleProgress();
    }

    // Hover -> Peek (Stage 2), Click -> Expanded (Stage 3)
    island.addEventListener('pointerenter', () => {
      acknowledgeIntent();
      if (!finePointer.matches || isSpeaking() || isExpanded()) return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        if (!isExpanded()) setState('peek');
      }, 65);
    });

    island.addEventListener('pointerleave', () => {
      if (!finePointer.matches || isSpeaking()) return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        if (isPeek() && !island.matches(':focus-within')) {
          setState('collapsed');
        }
      }, 240);
    });

    // Touch long-press -> Peek, tap -> Expanded
    island.addEventListener('touchstart', () => {
      if (isExpanded() || isSpeaking()) return;
      window.clearTimeout(longPressTimer);
      longPressTimer = window.setTimeout(() => {
        if (!isExpanded()) setState('peek');
      }, 280);
    }, { passive: true });

    island.addEventListener('touchend', () => {
      window.clearTimeout(longPressTimer);
    }, { passive: true });

    island.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      // Allow links inside the island to navigate normally
      const anchor = target.closest<HTMLAnchorElement>('a[href]');
      if (anchor) {
        if (anchor.hasAttribute('data-gaga-island-anchor')) {
          setState('collapsed');
        }
        return;
      }

      const infoBtn = target.closest<HTMLButtonElement>('[data-gaga-info-trigger]');
      if (infoBtn) {
        event.stopPropagation();
        setInfoOpen(infoFlyout ? infoFlyout.hasAttribute('hidden') : false);
        return;
      }

      const closeBtn = target.closest<HTMLButtonElement>('[data-gaga-info-close]');
      if (closeBtn) {
        event.stopPropagation();
        setInfoOpen(false);
        infoTrigger?.focus();
        return;
      }

      // Theme & Archetype buttons inside the Notch are handled by theme.ts on document;
      // keep the Notch open so the user can live-preview themes and archetypes.
      const prefBtn = target.closest<HTMLButtonElement>('[data-gaga-reader-pref]');
      if (prefBtn) {
        return;
      }

      const islandToggle = target.closest<HTMLButtonElement>('[data-gaga-action-island-toggle]');
      if (islandToggle) {
        setState(isExpanded() ? 'collapsed' : 'expanded');
        return;
      }

      const button = target.closest<HTMLButtonElement>('[data-gaga-action]');
      const command = button?.dataset.gagaAction;
      if (button && command) {
        // Stop propagation so @gaga/engine-runtime's document listener does not double-toggle the Reader Panel
        event.preventDefault();
        event.stopPropagation();

        if (command !== 'speak' && command !== 'toggle-focus-mode') {
          setState('collapsed');
        }

        runSiteCommand(command as any, {
          source: 'action-runtime',
          target: button,
          pointer: { x: event.clientX, y: event.clientY }
        });
        return;
      }

      // Clicking the capsule background/status in collapsed or peek state expands to Full Dynamic Island
      if (!isExpanded()) {
        setState('expanded');
      }
    });

    // Context-aware Live Activity sync when hovering article previews on the page
    document.addEventListener('pointerover', (event) => {
      const previewTarget = event.target instanceof Element
        ? event.target.closest<HTMLElement>('[data-gaga-preview]')
        : null;
      if (!previewTarget) return;

      const meta = previewTarget.dataset.gagaPreviewMeta;
      const title = previewTarget.dataset.gagaPreviewTitle;
      const readTime = previewTarget.dataset.gagaPreviewReadTime;
      const pubType = previewTarget.dataset.gagaPreviewType;

      if (statusBadge && (pubType || readTime)) {
        statusBadge.textContent = [pubType, readTime].filter(Boolean).join(' · ');
      }
      if (peekTitle && title) {
        peekTitle.textContent = title;
      }
      if (focusTitle && meta && title) {
        focusTitle.textContent = `${title} (${meta})`;
      }
      acknowledgeIntent();
    }, { passive: true });

    document.addEventListener('pointerout', (event) => {
      const fromPreview = event.target instanceof Element
        ? event.target.closest<HTMLElement>('[data-gaga-preview]')
        : null;
      if (!fromPreview) return;
      const related = event.relatedTarget instanceof Element
        ? event.relatedTarget.closest<HTMLElement>('[data-gaga-preview]')
        : null;
      if (related) return;

      if (statusBadge) statusBadge.textContent = defaultBadge;
      if (peekTitle) peekTitle.textContent = defaultTitle;
      if (focusTitle) focusTitle.textContent = defaultTitle;
    }, { passive: true });

    island.addEventListener('focusin', acknowledgeIntent);

    document.addEventListener('pointerdown', (event) => {
      if ((!isExpanded() && !isPeek()) || island.contains(event.target as Node) || isSpeaking()) return;
      setState('collapsed');
    }, { passive: true });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && (isExpanded() || isPeek()) && !isSpeaking()) {
        setState('collapsed');
      }
    });

    bindReadingProgress();
    onRuntimeEvent('layoutChanged', bindReadingProgress);
    window.addEventListener('resize', scheduleProgress, { passive: true });

    window.addEventListener('pagehide', () => {
      unsubscribeScroll?.();
      window.clearTimeout(hoverTimer);
      window.clearTimeout(longPressTimer);
      window.clearTimeout(intentTimer);
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupActionRuntime, { once: true });
  } else {
    setupActionRuntime();
  }
</script>

