---
import { contextualSurfaceRoles } from '../../config/contextual-surfaces.mjs';
import Icon from '../ui/Icon.astro';
import SuperShare from '../reader/SuperShare.astro';
import { siteConfig } from '../../config/site';
import { identityConfig } from '../../config/identity';
import { i18nLabel } from '../../config/i18n';
import { actionById } from '../../config/actions';
import { experienceConfig, experienceSurfaceProfile, type ExperienceContext } from '../../config/experience';
import { globalNavigationProjection } from '../../config/context-rails';
import { resolveNotchPresentation } from '../../config/contextual-ux.mjs';
interface Props { contextAvailability?: {left:boolean;right:boolean;leftLabel?:string}; className?: string; context?: ExperienceContext; pageTitle?: string; workspaceId?: string; }
const { contextAvailability = {left:false,right:false}, className = '', context = 'default', pageTitle = 'PakRPP' } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const profile = experienceSurfaceProfile(context);
const railPolicy = contextAvailability;
const actions = profile.notchActionIds.filter(id => !['smart-back', 'settings'].includes(id) && (id !== 'context-info' || railPolicy.right)).map(actionById);
const primary = actions;
const global = globalNavigationProjection();
const islandLabel = i18nLabel('actionIsland.label');
const toggleLabel = i18nLabel('actionIsland.toggle');
const presentation = resolveNotchPresentation(experienceConfig.notch);
---
<div class={`gaga-action-runtime-container gaga-contextual-notch-container ${className}`} data-gaga-action-runtime-container data-gaga-notch-placement={presentation.placement} data-gaga-notch-shape={presentation.shape} data-gaga-notch-config={JSON.stringify(experienceConfig.notch)}>
  <nav class="gaga-action-runtime gaga-dynamic-island gaga-contextual-notch" data-gaga-action-runtime data-gaga-global-nav data-gaga-context={context} data-gaga-state="collapsed" data-gaga-level="0" aria-label={islandLabel.id} data-gaga-i18n-id={islandLabel.id} data-gaga-i18n-en={islandLabel.en} data-gaga-i18n-target="aria">
    <div class="gaga-action-runtime__shell" data-gaga-context-surface={contextualSurfaceRoles.command}>
      <div class="gaga-island-bar" data-gaga-island-bar data-gaga-notch-spine>
        <button type="button" class="gaga-notch-button" data-gaga-action="smart-back" aria-label="Kembali" data-gaga-i18n-id="Kembali" data-gaga-i18n-en="Back" data-gaga-i18n-target="aria" disabled={path === '/'}><Icon name="arrow_back" /></button>
        <a href="/" class="gaga-island-brand" aria-label={`${siteConfig.name} — Beranda`}><img src={identityConfig.faviconSvg} width="20" height="20" alt="" /><span>{siteConfig.name}</span><small data-gaga-notch-capability-label hidden></small></a>
        <button type="button" class="gaga-action-runtime__toggle gaga-notch-button" data-gaga-action-island-toggle aria-label={toggleLabel.id} data-gaga-i18n-id={toggleLabel.id} data-gaga-i18n-en={toggleLabel.en} data-gaga-i18n-target="aria" aria-expanded="false" aria-controls="gaga-notch-context"><Icon name="menu" /></button>
      </div>
      <section id="gaga-notch-context" class="gaga-notch-context" data-gaga-notch-context hidden inert aria-label="Aksi kontekstual">
        {path !== '/' && <p class="gaga-notch-page-title" data-gaga-island-focus-title hidden>{pageTitle}</p>}
        <div class="gaga-notch-actions" data-gaga-action-runtime-actions>
          {primary.map(action => <button type="button" class="gaga-notch-button" data-gaga-action={action.id === 'search' ? undefined : action.id === 'save' ? 'save-reading' : action.command} data-gaga-notch-search-toggle={action.id === 'search' ? '' : undefined} data-gaga-document-outline-action={action.id === 'outline' ? '' : undefined} hidden={action.id === 'outline'} aria-controls={action.id === 'search' ? 'gaga-notch-search' : action.id === 'outline' ? 'gaga-outline-peek' : undefined} aria-expanded={action.id === 'search' ? 'false' : undefined} title={action.label.id} data-gaga-action-id={action.id} data-gaga-quick-action={action.id} aria-label={action.label.id} data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en} data-gaga-i18n-target="aria" aria-pressed={action.kind === 'toggle' ? 'false' : undefined}><Icon name={action.icon ?? 'article'} /><span class="gaga-visually-hidden" data-gaga-i18n-id={action.label.id} data-gaga-i18n-en={action.label.en}>{action.label.id}</span></button>)}
          <button type="button" class="gaga-notch-button" data-gaga-action="toggle-reader-preferences" aria-controls="gaga-reader-panel" aria-expanded="false" aria-label="Preferensi pembaca" title="Preferensi pembaca"><Icon name="settings" /><span class="gaga-visually-hidden" data-gaga-i18n-id="Preferensi pembaca" data-gaga-i18n-en="Reader preferences">Preferensi pembaca</span></button>
          <button type="button" class="gaga-notch-button" data-gaga-notch-more aria-label="Navigasi situs" title="Navigasi situs" aria-expanded="false" aria-controls="gaga-notch-system"><Icon name="menu" /><span class="gaga-visually-hidden">Navigasi situs</span></button>
        </div>
        <form id="gaga-notch-search" action="/search" role="search" class="gaga-notch-search" data-gaga-notch-search hidden inert>
          <label for="notch-query" class="gaga-visually-hidden">Cari publikasi dan dokumen</label><input id="notch-query" type="search" name="q" placeholder="Cari publikasi dan dokumen…" required /><button class="gaga-notch-button" type="submit" aria-label="Cari"><Icon name="search" /></button>
        <div id="gaga-search-suggestions" data-gaga-search-suggestions role="listbox" aria-label="Hasil pencarian"></div><a data-gaga-search-all href="/search" hidden>Lihat semua hasil</a><span role="status" aria-live="polite"></span></form>
        {['article', 'document'].includes(context) && <span class="gaga-visually-hidden" role="progressbar" aria-label="Progres membaca" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-gaga-reading-progress><span class="gaga-visually-hidden" data-gaga-reading-progress-value>0%</span></span>}
      </section>
      <section id="gaga-notch-system" class="gaga-notch-system" data-gaga-notch-system hidden inert aria-label="Pembaca dan navigasi">
        <div class="gaga-notch-actions" data-gaga-notch-overflow>
        </div>
        {railPolicy.left && <button type="button" class="gaga-notch-button" data-gaga-action="toggle-left-rail" aria-controls="gaga-left-rail"><Icon name="menu" /><span>{contextAvailability.leftLabel ?? 'Informasi'}</span></button>}
        <div class="gaga-notch-navigation" aria-label="Navigasi situs">{global.items.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}><Icon name={item.icon} /><span data-gaga-i18n-id={item.label} data-gaga-i18n-en={item.labelEn ?? item.label}>{item.label}</span></a>)}</div>
        <details><summary>Direktori informasi</summary>{global.groups.map(group => <section><h2>{group.label}</h2><ul>{group.items.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></section>)}</details>
      </section>
      <SuperShare />
      <slot name="reader" />
      <div data-gaga-action-runtime-live class="gaga-action-runtime__live" hidden></div>
    </div>
  </nav>
</div>
<script>
import {initNotch} from '../../scripts/systems/notch';
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initNotch,{once:true});else initNotch();
</script>
<style is:global>
  .gaga-app-frame .gaga-contextual-notch-container { inset: auto; top: calc(var(--gaga-viewport-top,0px) + var(--gaga-safe-area-top,0px)); left: calc(var(--gaga-viewport-left,0px) + var(--gaga-safe-area-left) + (var(--gaga-viewport-inline-size,100%) - var(--gaga-safe-area-left) - var(--gaga-safe-area-right)) / 2); transform: translateX(-50%); inline-size: max-content; max-inline-size: calc(var(--gaga-viewport-inline-size,100vw) - var(--gaga-safe-area-left) - var(--gaga-safe-area-right) - 2rem); padding: 0; }
  .gaga-app-frame .gaga-contextual-notch-container[data-gaga-notch-placement='bottom'] { top: auto; bottom: calc(var(--gaga-viewport-bottom,0px) + var(--gaga-safe-area-bottom,0px) + .5rem); }
  .gaga-app-frame .gaga-contextual-notch-container[data-gaga-notch-placement='left'] { top: calc(var(--gaga-viewport-top,0px) + var(--gaga-viewport-block-size,100dvh) / 2); left: calc(var(--gaga-viewport-left,0px) + var(--gaga-safe-area-left) + .5rem); transform: translateY(-50%); }
  .gaga-app-frame .gaga-contextual-notch-container[data-gaga-notch-placement='right'] { top: calc(var(--gaga-viewport-top,0px) + var(--gaga-viewport-block-size,100dvh) / 2); left: auto; right: calc(var(--gaga-viewport-right,0px) + var(--gaga-safe-area-right) + .5rem); transform: translateY(-50%); }
  .gaga-contextual-notch { max-inline-size: min(var(--gaga-notch-max,352px),100%); color: var(--gaga-island-ink); }
  .gaga-contextual-notch .gaga-action-runtime__shell { display: block; max-block-size: calc(var(--gaga-viewport-block-size,100dvh) - 1rem - var(--gaga-safe-area-top) - var(--gaga-safe-area-bottom)); overflow: auto; padding: calc(var(--gaga-context-space) / 3) calc(var(--gaga-context-space) * .66); border: 0; border-radius: 0 0 var(--gaga-context-radius) var(--gaga-context-radius); background: var(--gaga-island-bg); color: var(--gaga-island-ink); animation: none !important; transform: none; box-shadow: var(--gaga-context-shadow); }
  .gaga-contextual-notch-container[data-gaga-notch-shape='island'] .gaga-action-runtime__shell { border-radius: var(--gaga-context-radius); margin-block-start: .5rem; }
  .gaga-contextual-notch-container[data-gaga-notch-shape='pill'] .gaga-action-runtime__shell { border-radius: calc(var(--gaga-context-radius) * 1.5); }
  .gaga-contextual-notch .gaga-island-bar { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; gap: .25rem; min-block-size: 2.75rem; }
  .gaga-contextual-notch .gaga-island-brand { display: inline-flex; gap: .5rem; justify-content: center; align-items: center; min-block-size: 2.75rem; padding-inline: .4rem; color: inherit; text-decoration: none; font: 600 .9rem var(--gaga-font-ui); }
  .gaga-contextual-notch .gaga-island-brand img { flex: none; object-fit: contain; }
  .gaga-contextual-notch .gaga-notch-button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-block-size: 2.75rem; min-inline-size: 2.75rem; max-inline-size: 100%; padding: .45rem .65rem; border: 0; border-radius: .6rem; background: transparent; color: inherit; font: inherit; font-size: .85rem; cursor: pointer; opacity: 1; visibility: visible; pointer-events: auto; }
  .gaga-contextual-notch .gaga-notch-button:disabled { opacity: .4; cursor: default; }
  .gaga-contextual-notch :is(button,a,summary):focus-visible { outline: 2px solid var(--gaga-context-focus); outline-offset: -3px; }
  .gaga-contextual-notch .gaga-notch-button:is(:hover,[aria-pressed='true']) { background: var(--gaga-island-hover); }
  .gaga-contextual-notch .gaga-notch-context, .gaga-contextual-notch .gaga-notch-system { inline-size: 100%; padding: var(--gaga-context-space) calc(var(--gaga-context-space) / 2); }
  .gaga-contextual-notch [hidden] { display: none !important; }
  .gaga-contextual-notch .gaga-notch-page-title { margin: 0 0 .6rem; font-size: .9rem; line-height: 1.45; overflow-wrap: anywhere; }
  .gaga-contextual-notch .gaga-notch-actions { display: flex; flex-wrap: wrap; gap: var(--gaga-context-space); }
  .gaga-contextual-notch [role='progressbar'] { display: block; margin-block-start: .6rem; font: .75rem var(--gaga-font-mono); }
  .gaga-contextual-notch .gaga-notch-navigation { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .4rem; margin-block: .75rem; }
  .gaga-contextual-notch a { color: inherit; }
  .gaga-contextual-notch .gaga-notch-navigation a { display: flex; align-items: center; gap: .4rem; padding: .5rem; min-block-size: 2.75rem; border-radius: .5rem; text-decoration: underline; text-underline-offset:.18em; }
  .gaga-contextual-notch :is(a[aria-current],a:hover) { background: var(--gaga-island-hover); }
  .gaga-contextual-notch summary { padding: .75rem .25rem; min-block-size: 2.75rem; cursor: pointer; }
  .gaga-contextual-notch details h2 { font-size: .9rem; }
  .gaga-contextual-notch details ul { padding-inline-start: 1.25rem; }
  .gaga-contextual-notch details a { display: inline-block; padding-block: .5rem; }
  .gaga-contextual-notch .gaga-reader-panel { --gaga-surface: var(--gaga-context-elevated); --gaga-surface-2: var(--gaga-context-elevated); --gaga-surface-subtle: var(--gaga-context-surface); --gaga-blue: var(--gaga-island-ink); --gaga-muted: var(--gaga-island-muted); --gaga-line: var(--gaga-context-divider); position: static; inset: auto; display: none; inline-size: 100%; width: auto; max-block-size: none; max-height: none; overflow: visible; transform: none; opacity: 1; border: 0; border-radius: 0; box-shadow: none; background: var(--gaga-island-bg); color: var(--gaga-island-ink); transition: none; }
  .gaga-contextual-notch .gaga-reader-panel[data-gaga-state='open'] { display: block; transform: none; }


  .gaga-contextual-notch .gaga-reader-panel :is(h2,legend,label,summary,button,span) { color: inherit; }
  .gaga-contextual-notch .gaga-reader-panel button { min-block-size: 2.75rem; min-inline-size: 2.75rem; border-color: var(--gaga-context-divider); background: var(--gaga-context-elevated); }
  .gaga-contextual-notch .gaga-reader-panel button[data-gaga-active='true'] { background: var(--gaga-island-ink); color: var(--gaga-island-bg); }
  .gaga-contextual-notch .gaga-reader-panel button[data-gaga-active='true']:focus-visible { outline-color: var(--gaga-island-ink); }
  .gaga-contextual-notch .gaga-notch-search { display:flex; gap:.25rem; margin-block:.5rem; }
  .gaga-contextual-notch input:focus-visible { outline:2px solid var(--gaga-island-ink); outline-offset:-3px; }
  .gaga-contextual-notch .gaga-notch-search input::placeholder { color:var(--gaga-island-muted); opacity:1; }
  .gaga-contextual-notch .gaga-notch-search input { min-inline-size:0; inline-size:100%; border:0; border-radius:.5rem; padding:.7rem; color:var(--gaga-island-ink); background:var(--gaga-island-hover); font:inherit; }
  .gaga-contextual-notch[data-gaga-live-state='speaking'] :is(.gaga-notch-context,.gaga-notch-system) { display:none; }
  .gaga-contextual-notch :is(.gaga-notch-context,.gaga-notch-system,.gaga-reader-panel) { animation:gaga-context-emerge var(--gaga-context-motion-duration) var(--gaga-context-motion-easing); }
  .gaga-contextual-notch .gaga-action-runtime__live { inline-size:100%; }
  .gaga-contextual-notch .gaga-speech-dock__inner { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.5rem; align-items:center; }
  .gaga-contextual-notch .gaga-speech-dock__info { min-inline-size:0; }
  .gaga-contextual-notch .gaga-speech-dock__text { display:block; max-inline-size:100%; color:var(--gaga-island-muted); }
  .gaga-contextual-notch .gaga-speech-dock__badge { color:var(--gaga-island-ink); font:600 .75rem var(--gaga-font-ui); }
  .gaga-contextual-notch .gaga-action-runtime__live .gaga-speech-dock__btn { min-block-size:44px; min-inline-size:44px; color:var(--gaga-island-ink); background:transparent; }
  .gaga-contextual-notch .gaga-action-runtime__live .gaga-speech-dock__btn:focus-visible { outline:2px solid var(--gaga-island-ink); outline-offset:-3px; }
  .gaga-contextual-notch .gaga-speech-dock__inner progress { grid-column:1/-1; grid-row:2; inline-size:100%; block-size:3px; accent-color:var(--gaga-island-ink); }
  @media(prefers-reduced-motion:reduce) { .gaga-contextual-notch *, .gaga-contextual-notch-container { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
  .gaga-island-brand small { font:inherit;color:var(--gaga-context-muted); }
  .gaga-contextual-notch[data-gaga-notch-capability='search'] [data-gaga-action-runtime-actions] { display:none; }
  .gaga-contextual-notch .gaga-notch-search { display:grid;grid-template-columns:minmax(0,1fr) auto; }
  [data-gaga-search-suggestions],[data-gaga-search-all],.gaga-notch-search [role='status'] { grid-column:1/-1; }
  [data-gaga-search-suggestions] :is(a,button) { display:flex;align-items:center;inline-size:100%;min-block-size:44px;padding:var(--gaga-context-space);color:inherit;white-space:normal;text-align:start;text-decoration:none; }
  [data-gaga-search-suggestions] [aria-selected='true'] { background:var(--gaga-context-hover);text-decoration:underline; }
  .gaga-contextual-notch .gaga-right-rail[data-gaga-projection='sheet'] { position:static;inset:auto;transform:none;inline-size:100%;max-block-size:calc(var(--gaga-viewport-block-size,100dvh) - 2rem - var(--gaga-safe-area-top) - var(--gaga-safe-area-bottom));margin:0;padding:0;pointer-events:auto;background:inherit;color:inherit;box-shadow:none;--gaga-ink:var(--gaga-context-text);--gaga-muted:var(--gaga-context-muted);--gaga-tertiary:var(--gaga-context-muted); }
</style>

<style is:global>.gaga-notch-button[hidden] { display: none; } .gaga-island-brand span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-inline-size: 11rem; }</style>
