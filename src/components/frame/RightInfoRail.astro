---
import RailToggle from '../navigation/RailToggle.astro';
import SummaryBlock from '../information/SummaryBlock.astro';
import ContextDiscoveryBlock from '../information/ContextDiscoveryBlock.astro';
import Icon from '../ui/Icon.astro';
import RightRailMeta from './RightRailMeta.astro';
import type { RightRailInput } from './component-inputs';

interface Props {
  rail: RightRailInput;
  workspaceId: string;
  contextRole: string;
  contextPriority: 'discovery' | 'metadata' | 'system';
}

const { rail, workspaceId, contextRole, contextPriority } = Astro.props;
const cleanCurrentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isRootPage = cleanCurrentPath === '/';
const hasDiscovery = (rail.discovery?.length ?? 0) > 0;
const hasSummary = Boolean(rail.snippet);
const outlineItems = rail.outlineItems ?? [];
const contextSignalCount = (rail.facts?.length ?? 0) + (rail.discovery?.length ?? 0) + (hasSummary ? 1 : 0) + (rail.cta ? 1 : 0);
const contextRichness = contextSignalCount >= 5 ? 'rich' : contextSignalCount >= 2 ? 'standard' : 'minimal';
const railHeaderLabel = isRootPage ? rail.labels.railLabel : rail.labels.outlineTitle;
const railHeaderRole = isRootPage ? contextRole : 'table-of-contents';
---

<button
  class="gaga-context-surface__scrim"
  type="button"
  aria-label={rail.labels.closeInformation.id}
  data-gaga-i18n-key={rail.labels.closeInformation.key}
  data-gaga-i18n-id={rail.labels.closeInformation.id}
  data-gaga-i18n-en={rail.labels.closeInformation.en}
  data-gaga-i18n-target="aria"
  data-gaga-context-surface-scrim
  hidden
></button>

<aside
  id="gaga-right-rail"
  class="gaga-right-rail"
  data-gaga-right-rail
  data-gaga-context-inspector
  data-gaga-state="expanded"
  data-gaga-context-surface-state="closed"
  data-gaga-signature-surface="context-right-rail"
  data-gaga-workspace={workspaceId}
  data-gaga-context-role={railHeaderRole}
  data-gaga-context-priority={contextPriority}
  data-gaga-context-richness={contextRichness}
  aria-label={railHeaderLabel.id}
  data-gaga-i18n-key={railHeaderLabel.key}
  data-gaga-i18n-id={railHeaderLabel.id}
  data-gaga-i18n-en={railHeaderLabel.en}
  data-gaga-i18n-target="aria"
  data-gaga-info-kind={rail.kind}
  aria-live="off"
>
  <div class="gaga-right-rail__head">
    <div class="gaga-right-rail__identity">
      <p
        data-gaga-i18n-key={railHeaderLabel.key}
        data-gaga-i18n-id={railHeaderLabel.id}
        data-gaga-i18n-en={railHeaderLabel.en}
      >
        {railHeaderLabel.id}
      </p>
      <span>{railHeaderRole}</span>
    </div>

    <RailToggle action={rail.railToggle} />

    <button
      class="gaga-context-surface__close"
      type="button"
      aria-label={rail.labels.closeInformation.id}
      data-gaga-i18n-key={rail.labels.closeInformation.key}
      data-gaga-i18n-id={rail.labels.closeInformation.id}
      data-gaga-i18n-en={rail.labels.closeInformation.en}
      data-gaga-i18n-target="aria"
      data-gaga-context-surface-close
    >
      <Icon name="close" />
    </button>
  </div>

  <div class="gaga-right-rail__body">
    {!isRootPage && outlineItems.length > 0 ? (
      <nav
        class="gaga-info-block gaga-right-rail__outline"
        aria-label={rail.labels.outlineTitle.id}
        data-gaga-right-rail-outline
      >
        <h2>
          <Icon name="outline" />
          <span
            data-gaga-i18n-key={rail.labels.outlineTitle.key}
            data-gaga-i18n-id={rail.labels.outlineTitle.id}
            data-gaga-i18n-en={rail.labels.outlineTitle.en}
          >
            {rail.labels.outlineTitle.id}
          </span>
        </h2>
        <ol class="gaga-toc-list" data-gaga-info-field="outline">
          {outlineItems.map((item) => (
            <li>
              <a href={`#${item.slug}`}>{item.text}</a>
              {item.children?.length ? (
                <ol>
                  {item.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              ) : null}
            </li>
          ))}
        </ol>
      </nav>
    ) : null}
  </div>
</aside>
