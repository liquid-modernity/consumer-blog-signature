---
import GagaDock from './GagaDock.astro';
import GlobalNavigationRail from './GlobalNavigationRail.astro';
import ReaderPreferences from '../reader/ReaderPreferences.astro';
import ActionRuntime from './ActionRuntime.astro';
import SkipLink from '../ui/SkipLink.astro';
import type { AppShellInput } from './component-inputs';
import { designContract } from '../../config/design';
import { experienceSurfaceProfile, resolveExperienceContext } from '../../config/experience';

interface Props {
  pageId: string;
  pageTitle: string;
  contentKind?: string;
  contentClass?: string;
  mainElement?: 'main' | 'div';
  shell: AppShellInput;
  workspaceId?: string;
  workspaceMode?: string;
  contextIntent?: string;
  leftContextRole?: string;
  rightContextRole?: string;
  mobileContextMode?: string;
  contextPriority?: string;
  continuityEligible?: boolean;
  freshnessStatus?: string;
  freshnessVolatility?: string;
  lastReviewed?: string;
  reviewAfter?: string;
  coverageMode?: string;
  coverageStatus?: string;
  coverageActive?: boolean;
  coverageUpdatedAt?: string;
}

const {
  pageId,
  pageTitle,
  contentKind = 'page',
  contentClass = contentKind,
  mainElement = 'main',
  shell,
  workspaceId = 'page',
  workspaceMode = 'reference',
  contextIntent = 'reference',
  leftContextRole = 'navigation',
  rightContextRole = 'reference',
  mobileContextMode = 'navigation-and-context',
  contextPriority = 'metadata',
  continuityEligible = false,
  freshnessStatus = 'unknown',
  freshnessVolatility = 'unknown',
  lastReviewed,
  reviewAfter,
  coverageMode = 'standard',
  coverageStatus = 'inactive',
  coverageActive = false,
  coverageUpdatedAt
} = Astro.props;

const showActionRuntime = pageId !== 'landing';

const runtimeContext = resolveExperienceContext({
  pathname: Astro.url.pathname,
  pageId,
  contentKind,
  contentClass
});
const surfaceProfile = experienceSurfaceProfile(runtimeContext);
const showGagaDock = surfaceProfile.dockMode === 'workspace';
---
<SkipLink />
<div
  class="gaga-app-frame"
  data-gaga-app-frame
  data-gaga-page-id={pageId}
  data-gaga-page-title={pageTitle}
  data-gaga-content-kind={contentKind}
  data-gaga-content-class={contentClass}
  data-gaga-design-language={designContract.language}
  data-gaga-workspace={workspaceId}
  data-gaga-workspace-mode={workspaceMode}
  data-gaga-context-intent={contextIntent}
  data-gaga-context-left={leftContextRole}
  data-gaga-context-right={rightContextRole}
  data-gaga-context-mobile={mobileContextMode}
  data-gaga-context-priority={contextPriority}
  data-gaga-continuity-eligible={String(continuityEligible)}
  data-gaga-freshness-status={freshnessStatus}
  data-gaga-freshness-volatility={freshnessVolatility}
  data-gaga-last-reviewed={lastReviewed}
  data-gaga-review-after={reviewAfter}
  data-gaga-coverage-mode={coverageMode}
  data-gaga-coverage-status={coverageStatus}
  data-gaga-coverage-active={String(coverageActive)}
  data-gaga-coverage-updated-at={coverageUpdatedAt}
>
  <GlobalNavigationRail />
  <slot name="before-main" />
  {mainElement === 'main' ? (
    <main id="gaga-main" class="gaga-main-region" data-gaga-main-region tabindex="-1">
      {showActionRuntime && <ActionRuntime context={runtimeContext} />}
      <slot />
      <slot name="after-content" />
    </main>
  ) : (
    <div id="gaga-main" class="gaga-main-region" data-gaga-main-region tabindex="-1">
      {showActionRuntime && <ActionRuntime context={runtimeContext} />}
      <slot />
      <slot name="after-content" />
    </div>
  )}
  <slot name="after-main" />
  {showGagaDock ? <GagaDock dock={shell.gagaDock} /> : null}
  <ReaderPreferences preferences={shell.readerPreferences} />
</div>
<script>
  import '../../scripts/app';
</script>
