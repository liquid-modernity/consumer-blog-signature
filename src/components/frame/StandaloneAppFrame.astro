---
import DocumentWorkspace from '../reader/DocumentWorkspace.astro';
import { documentExperience } from '../../config/document-experience';
import type { ScreenInfo } from '../../lib/screen-info';
import { getArticles, getAuthors, getTagGroups, getTopicGroups } from '../../lib/content';
import { getEditorialSections } from '../../lib/editorial';
import { resolveGagaWorkspace } from '../../config/workspaces';
import { resolveGagaShellContext } from '../../config/shell-context';
import { projectContextRail } from '../../config/context-rails';
import AppFrameBase from './AppFrameBase.astro';
import LeftRail from './LeftRail.astro';
import RightInfoRail from './RightInfoRail.astro';
import ArticleOutlinePeek from './ArticleOutlinePeek.astro';
import PageMetadataTable from '../information/PageMetadataTable.astro';
import {
  createAppShellInput,
  createLeftRailInput,
  createRightRailInput,
  normalizeCurrentPath
} from './site-composition';

interface Props {
  pageId: string;
  pageTitle: string;
  contentKind?: string;
  contentClass?: string;
  info: ScreenInfo;
}

const {
  pageId,
  pageTitle,
  contentKind = 'page',
  contentClass = contentKind,
  info
} = Astro.props;
const currentPath = normalizeCurrentPath(Astro.url.pathname);
const workspace = resolveGagaWorkspace(currentPath, contentKind);
const shellContext = resolveGagaShellContext(workspace);
const shell = createAppShellInput(currentPath);
const [articles, authors, topicGroups, tagGroups, editorialSections] = await Promise.all([
  getArticles(),
  getAuthors(),
  getTopicGroups(),
  getTagGroups(),
  getEditorialSections()
]);
const rail = createLeftRailInput(currentPath, projectContextRail({
  currentPath,
  workspace,
  info,
  articles,
  authors,
  topicGroups,
  tagGroups,
  sections: editorialSections
}));
const rightRail = createRightRailInput(info);
const resolvedOutlineItems = rightRail.outlineItems.length > 0
  ? rightRail.outlineItems
  : [{ slug: '_top', text: pageTitle, depth: 2, children: [] }];
const outlineRail = { ...rightRail, outlineItems: resolvedOutlineItems };
const articleOutline = resolvedOutlineItems.length > 0;
---
<AppFrameBase
  pageId={pageId}
  pageTitle={pageTitle}
  contentKind={contentKind}
  contentClass={contentClass}
  shell={shell}
  workspaceId={workspace.id}
  workspaceMode={workspace.mode}
  contextIntent={shellContext.intent}
  leftContextRole={shellContext.left}
  rightContextRole={shellContext.right}
  mobileContextMode={shellContext.mobile}
  contextPriority={shellContext.rightPriority}
>
  <Fragment slot="before-main">
    <LeftRail rail={rail} workspaceId={workspace.id} contextRole={shellContext.left} />
  </Fragment>

  <div class="main-pane">
    <div class="content-panel">
      {documentExperience(currentPath) ? <DocumentWorkspace title={pageTitle}><slot /></DocumentWorkspace> : <slot />}
      {currentPath !== '/' ? <PageMetadataTable rail={rightRail} /> : null}
    </div>
  </div>

  <Fragment slot="after-main">
    <RightInfoRail
      rail={rightRail}
      workspaceId={workspace.id}
      contextRole={shellContext.right}
      contextPriority={shellContext.rightPriority}
    />
    {articleOutline ? <ArticleOutlinePeek rail={outlineRail} /> : null}
  </Fragment>
</AppFrameBase>
