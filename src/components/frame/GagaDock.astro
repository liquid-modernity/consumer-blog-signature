---
import QuickAction from '../navigation/QuickAction.astro';
import type { GagaDockInput } from './component-inputs';

interface Props {
  dock: GagaDockInput;
}

const { dock } = Astro.props;
---
<nav
  class="gaga-dock"
  data-gaga-dock
  data-gaga-state="collapsed"
  aria-label={dock.label.id} data-gaga-surface="dock"
  data-gaga-i18n-key={dock.label.key}
  data-gaga-i18n-id={dock.label.id}
  data-gaga-i18n-en={dock.label.en}
  data-gaga-i18n-target="aria"
  style={`--gaga-dock-action-capacity: ${dock.actionCapacity}`}
>
  <div class="gaga-dock__surface">
    {dock.items.map((item) => <QuickAction action={item} currentPath={dock.currentPath} />)}
  </div>
</nav>
