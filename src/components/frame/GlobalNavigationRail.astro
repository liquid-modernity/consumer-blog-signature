---
import Icon from '../ui/Icon.astro';
import { normalizeSitePath } from '../../lib/url-semantics';
import { globalNavigationProjection } from '../../config/context-rails';

const currentPath = normalizeSitePath(Astro.url.pathname);
const global = globalNavigationProjection();
const items = global.items;
const infoGroups = global.groups;

const isCurrent = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath === href || currentPath.startsWith(`${href}/`);

const isInfoActive = infoGroups.some((group) => group.items.some((item) => isCurrent(item.href)));
---
<nav
  class="gaga-global-nav"
  data-gaga-global-nav
  data-gaga-signature-surface="dynamic-global-navigation"
  aria-label="Global navigation"
>
  <a
    class="gaga-global-nav__brand"
    href="/landing"
    aria-label="Consumer Blog Signature"
    data-gaga-tooltip="Signature"
  >G</a>

  <div class="gaga-global-nav__items">
    {items.map((item) => (
      <a
        class="gaga-global-nav__item"
        href={item.href}
        aria-label={item.label}
        aria-current={isCurrent(item.href) ? 'page' : undefined}
        data-gaga-tooltip={item.label}
        data-gaga-global-destination={item.id}
      >
        <Icon name={item.icon} />
      </a>
    ))}

    <div class="gaga-global-nav__info-wrapper" data-gaga-info-wrapper>
      <button
        class:list={['gaga-global-nav__item', 'gaga-global-nav__info-trigger', isInfoActive && 'gaga-is-current']}
        type="button"
        aria-label="Information"
        aria-expanded="false"
        aria-haspopup="dialog"
        data-gaga-info-trigger
        data-gaga-tooltip="Information"
      >
        <Icon name="info" />
      </button>

      <div
        class="gaga-global-nav__info-flyout"
        role="dialog"
        aria-label="Information & publication surface"
        data-gaga-info-flyout
        hidden
      >
        <div class="gaga-global-nav__info-head">
          <div>
            <span class="gaga-global-nav__info-kicker">PUBLICATION</span>
            <h3 class="gaga-global-nav__info-title">Information</h3>
          </div>
          <button
            class="gaga-global-nav__info-close"
            type="button"
            aria-label="Close information"
            data-gaga-info-close
          >
            <Icon name="close" />
          </button>
        </div>

        <div class="gaga-global-nav__info-groups">
          {infoGroups.map((group) => (
            <section class="gaga-global-nav__info-group">
              <p>{group.label}</p>
              <div class="gaga-global-nav__info-grid">
                {group.items.map((link) => (
                  <a
                    href={link.href}
                    class:list={['gaga-global-nav__info-link', isCurrent(link.href) && 'gaga-is-current']}
                  >
                    <div class="gaga-global-nav__info-link-icon"><Icon name={link.icon} /></div>
                    <div class="gaga-global-nav__info-link-body">
                      <span class="gaga-global-nav__info-link-label">{link.label}</span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>

  <button
    class="gaga-global-nav__item gaga-global-nav__settings"
    type="button"
    aria-label="Personalize"
    data-gaga-action="toggle-reader-preferences"
    data-gaga-tooltip="Personalize"
  >
    <Icon name="settings" />
  </button>
</nav>

<script>
  function setupInfoSurface() {
    const trigger = document.querySelector<HTMLButtonElement>('[data-gaga-info-trigger]');
    const flyout = document.querySelector<HTMLElement>('[data-gaga-info-flyout]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-gaga-info-close]');
    if (!trigger || !flyout || trigger.dataset.gagaWired === 'true') return;

    trigger.dataset.gagaWired = 'true';

    const setOpen = (open: boolean) => {
      flyout.toggleAttribute('hidden', !open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(flyout.hasAttribute('hidden'));
    });

    closeBtn?.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(false);
      trigger.focus();
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!flyout.contains(target) && !trigger.contains(target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !flyout.hasAttribute('hidden')) {
        setOpen(false);
        trigger.focus();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupInfoSurface, { once: true });
  } else {
    setupInfoSurface();
  }
</script>
