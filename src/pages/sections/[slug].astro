---
import GagaSiteLayout from '../../components/gaga/GagaSiteLayout.astro';
import SectionFront from '../../components/reader/SectionFront.astro';
import { getTopicGroups } from '../../lib/content';
import { getEditorialSectionFront, getEditorialSections } from '../../lib/editorial';

export const prerender = true;

export async function getStaticPaths() {
  const sections = await getEditorialSections();
  return sections.map((section) => ({
    params: { slug: section.slug },
    props: { slug: section.slug }
  }));
}

const { slug } = Astro.props;
const resolved = await getEditorialSectionFront(slug);

if (!resolved) {
  return Astro.redirect('/404');
}

const relatedTopics = (await getTopicGroups()).filter(topic => topic.articles.some(article => article.section?.trim() === resolved.section.name));
const entryData = {
  title: resolved.section.name,
  description: `Latest editorial coverage in ${resolved.section.name}.`,
  summary: `${resolved.section.count} published stories in ${resolved.section.name}.`,
  contentKind: 'index',
  contentClass: 'section',
  language: 'id',
  status: 'published',
  visibility: 'public',
  draft: false,
  noindex: false
};
---

<GagaSiteLayout entryData={entryData}>
  <SectionFront section={resolved.section} projection={resolved.projection} />
  {relatedTopics.length > 0 && <nav aria-label="Topik dalam ruang editorial"><h2 id="topik-terkait">Topik terkait</h2><ul>{relatedTopics.map(topic => <li><a href={topic.href}>{topic.topic}</a></li>)}</ul></nav>}
</GagaSiteLayout>
