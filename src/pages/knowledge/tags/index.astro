---
import GagaSiteLayout from '../../../components/gaga/GagaSiteLayout.astro';
import { getTagGroups } from '../../../lib/content';
import { routes } from '../../../config/routes';

export const prerender = true;

const tagGroups = await getTagGroups();

const entryData = {
  title: 'Tag Pengetahuan',
  subtitle: 'Deskriptor granular lintas topik untuk menemukan irisan konsep.',
  description: 'Indeks seluruh tag pengetahuan pada sistem publikasi PAKRPP.',
  summary: 'Topik ≠ Tag. Topik adalah klasifikasi utama (Pelaporan, Teknologi, Anomali), sedangkan Tag adalah deskriptor granular lintas topik.',
  contentKind: 'index',
  contentClass: 'index',
  contentId: 'pakrpp.knowledge.tags',
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <section class="pakrpp-ktags" aria-label="Daftar Tag Pengetahuan">
    <p class="pakrpp-ktags__meta">
      {tagGroups.length} deskriptor tag aktif · <a href={routes.topics.index}>Lihat Klasifikasi Topik →</a>
    </p>
    <ul class="pakrpp-ktags__list">
      {tagGroups.map((group) => (
        <li class="pakrpp-ktags__item">
          <a href={routes.knowledge.tagDetail(group.slug)} class="pakrpp-ktags__link">
            <span>#{group.tag}</span>
            <span class="pakrpp-ktags__count">{group.count} publikasi</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</GagaSiteLayout>

<style>
  .pakrpp-ktags {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .pakrpp-ktags__meta {
    margin: 0;
    font-size: 0.82rem;
    opacity: 0.78;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.22));
  }
  .pakrpp-ktags__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .pakrpp-ktags__item {
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.16));
    padding: 0.6rem 0;
  }
  .pakrpp-ktags__link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }
  .pakrpp-ktags__link:hover {
    text-decoration: underline;
  }
  .pakrpp-ktags__count {
    font-family: var(--gaga-font-mono, monospace);
    font-size: 0.76rem;
    opacity: 0.6;
  }
</style>
