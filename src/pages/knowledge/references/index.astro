---
import GagaSiteLayout from '../../../components/gaga/GagaSiteLayout.astro';
import {
  referenceRegistry,
  resolveCanonicalTopic
} from '../../../config/pakrpp-architecture';
import { routes } from '../../../config/routes';

export const prerender = true;

const entryData = {
  title: 'Objek Referensi',
  subtitle: 'Sumber primer, standar, monograf, dan dokumen acuan sebagai first-class knowledge objects.',
  description: 'Daftar objek referensi primer pada sistem pengetahuan PAKRPP (/knowledge/references).',
  summary: 'Referensi ≠ sekadar daftar pustaka di kaki artikel. Setiap referensi adalah objek pengetahuan mandiri yang dapat dirujuk lintas publikasi.',
  contentKind: 'index',
  contentClass: 'index',
  contentId: 'pakrpp.knowledge.references',
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <section class="pakrpp-refs" aria-label="Repositori Objek Referensi">
    <p class="pakrpp-refs__meta">
      {referenceRegistry.length} objek referensi terverifikasi · <a href={routes.knowledge.root}>← Pengetahuan</a>
    </p>

    <ol class="pakrpp-refs__list">
      {referenceRegistry.map((ref, idx) => (
        <li class="pakrpp-refs__item">
          <span class="pakrpp-refs__idx">{String(idx + 1).padStart(2, '0')}</span>
          <div class="pakrpp-refs__body">
            <a href={routes.knowledge.referenceDetail(ref.slug)} class="pakrpp-refs__title">
              {ref.title}
            </a>
            <p class="pakrpp-refs__summary">{ref.summary}</p>
            <p class="pakrpp-refs__info">
              {[
                `ID: ${ref.id}`,
                `Tipe: ${ref.sourceType.toUpperCase()}`,
                `Tahun: ${ref.year}`,
                `Penulis: ${ref.authors.join(', ')}`,
                `Topik: ${ref.topics.map((t) => resolveCanonicalTopic(t)?.label ?? t).join(', ')}`,
                `Dirujuk oleh ${ref.citedByPublications.length} publikasi`
              ].join(' · ')}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</GagaSiteLayout>

<style>
  .pakrpp-refs {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .pakrpp-refs__meta {
    margin: 0;
    font-size: 0.82rem;
    opacity: 0.78;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.22));
  }
  .pakrpp-refs__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pakrpp-refs__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.65rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.16));
  }
  .pakrpp-refs__idx {
    font-family: var(--gaga-font-mono, monospace);
    font-size: 0.82rem;
    opacity: 0.6;
  }
  .pakrpp-refs__title {
    font-size: 1.02rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .pakrpp-refs__title:hover {
    text-decoration: underline;
  }
  .pakrpp-refs__summary {
    margin: 0.35rem 0;
    font-size: 0.88rem;
    opacity: 0.82;
  }
  .pakrpp-refs__info {
    margin: 0;
    font-size: 0.76rem;
    opacity: 0.65;
  }
</style>
