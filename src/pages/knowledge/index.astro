---
import GagaSiteLayout from '../../components/gaga/GagaSiteLayout.astro';
import {
  curationRegistry,
  navigationConfig,
  referenceRegistry,
  seriesRegistry
} from '../../config/pakrpp-architecture';
import { getTagGroups } from '../../lib/content';
import { toCanonicalPublications } from '../../lib/pakrpp-content';
import { routes } from '../../config/routes';

export const prerender = true;

const [publications, tags] = await Promise.all([
  toCanonicalPublications(),
  getTagGroups()
]);

const knowledgeSection = navigationConfig.sections.find((s) => s.id === 'knowledge');
const totalRelations = publications.reduce((sum, pub) => sum + pub.relations.length, 0);

const entryData = {
  title: 'Pengetahuan',
  subtitle: 'Model navigasi relasional: Graf, Indeks Sistematis, Tag lintas topik, dan Objek Referensi.',
  description: 'Pusat navigasi pengetahuan PAKRPP: Graf, Indeks, Tag, dan Referensi.',
  summary: 'Topik ≠ Tag · Indeks ≠ Peta Situs · Referensi ≠ sekadar daftar pustaka artikel · Graf ≠ dekorasi visual.',
  contentKind: 'index',
  contentClass: 'index',
  contentId: 'pakrpp.knowledge.root',
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <section class="pakrpp-knowledge-hub" aria-label="Jalur Navigasi Pengetahuan">
    <div class="pakrpp-knowledge-hub__grid">
      {(knowledgeSection?.items ?? []).map((item, idx) => (
        <article class="pakrpp-knowledge-card">
          <div class="pakrpp-knowledge-card__head">
            <span class="pakrpp-knowledge-card__num">{String(idx + 1).padStart(2, '0')}</span>
            <h2><a href={item.href}>{item.label}</a></h2>
          </div>
          {item.meta && <p class="pakrpp-knowledge-card__desc">{item.meta}</p>}
        </article>
      ))}
    </div>

    <div class="pakrpp-knowledge-hub__sub">
      <div>
        <h3>Seri Editorial ({seriesRegistry.length})</h3>
        <ul>
          {seriesRegistry.map((s) => (
            <li>
              <a href="/series">{s.title}</a> — <span>{s.description}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Koleksi / Curations ({curationRegistry.length})</h3>
        <ul>
          {curationRegistry.map((c) => (
            <li>
              <a href="/collections">{c.title}</a> — <span>{c.description}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Tag Granular ({tags.length})</h3>
        <p>
          {tags.map((t, i) => (
            <>
              {i > 0 && ' · '}
              <a href={routes.knowledge.tagDetail(t.slug)}>#{t.tag} ({t.count})</a>
            </>
          ))}
        </p>
      </div>
    </div>
  </section>
</GagaSiteLayout>

<style>
  .pakrpp-knowledge-hub {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    font-variant-numeric: tabular-nums;
  }
  .pakrpp-knowledge-hub__principle {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
    opacity: 0.85;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.22));
  }
  .pakrpp-knowledge-hub__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .pakrpp-knowledge-card {
    padding: 1rem 0;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.2));
  }
  .pakrpp-knowledge-card__head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .pakrpp-knowledge-card__num,
  .pakrpp-knowledge-card__path {
    font-family: var(--gaga-font-mono, monospace);
    font-size: 0.76rem;
    opacity: 0.6;
  }
  .pakrpp-knowledge-card__path {
    margin-left: auto;
  }
  .pakrpp-knowledge-card h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .pakrpp-knowledge-card a {
    color: inherit;
    text-decoration: none;
  }
  .pakrpp-knowledge-card a:hover {
    text-decoration: underline;
  }
  .pakrpp-knowledge-card__desc {
    margin: 0.4rem 0 0;
    font-size: 0.84rem;
    opacity: 0.75;
  }
  .pakrpp-knowledge-hub__sub {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .pakrpp-knowledge-hub__sub h3 {
    margin: 0 0 0.45rem;
    font-size: 0.92rem;
  }
  .pakrpp-knowledge-hub__sub ul {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.88rem;
  }
  .pakrpp-knowledge-hub__sub a {
    color: inherit;
  }
</style>
