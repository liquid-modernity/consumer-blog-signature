---
import GagaSiteLayout from '../../../components/gaga/GagaSiteLayout.astro';
import {
  resolveCanonicalTopic,
  resolvePublicationType
} from '../../../config/pakrpp-architecture';
import { getArchiveYears } from '../../../lib/pakrpp-content';
import { routes } from '../../../config/routes';

export const prerender = true;

export async function getStaticPaths() {
  const archiveYears = await getArchiveYears();
  return archiveYears.map((group) => ({
    params: { year: group.year },
    props: { group }
  }));
}

const { group } = Astro.props;
if (!group) {
  return Astro.redirect('/404');
}

const entryData = {
  title: `Arsip ${group.year}`,
  subtitle: `Tampilan temporal untuk publikasi tahun ${group.year}.`,
  description: `Daftar publikasi tahun ${group.year} pada sistem PAKRPP.`,
  summary: `Arsip adalah tampilan temporal (/archive/${group.year}), bukan ontologi konten.`,
  contentKind: 'page',
  contentClass: 'archive-year',
  contentId: `pakrpp.archive.${group.year}`,
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <section class="pakrpp-archive-year" aria-label={`Arsip Tahun ${group.year}`}>
    <div class="pakrpp-archive-year__nav">
      <a href={routes.archive.index}>← Semua Arsip (/archive)</a>
      <span aria-hidden="true">·</span>
      <span>{group.count} publikasi pada tahun {group.year}</span>
    </div>

    {group.months.length > 0 && (
      <div class="pakrpp-archive-year__months">
        <span>Bulan tersedia:</span>
        {group.months.map((m, idx) => (
          <>
            {idx > 0 && <span aria-hidden="true">·</span>}
            <a href={m.href}>{m.label} ({m.count})</a>
          </>
        ))}
      </div>
    )}

    <ol class="pakrpp-archive-year__list" data-gaga-preview-scope>
      {group.publications.map((pub, idx) => {
        const pubType = resolvePublicationType(pub.type);
        const topicLabels = pub.topics
          .map((t) => resolveCanonicalTopic(t)?.label ?? t)
          .join(', ');
        return (
          <li class="pakrpp-archive-year__item">
            <span class="pakrpp-archive-year__idx">{String(idx + 1).padStart(2, '0')}</span>
            <div>
              <a
                href={pub.canonicalHref}
                class="pakrpp-archive-year__title"
                data-gaga-preview
                data-gaga-preview-title={pub.title}
                data-gaga-preview-href={pub.canonicalHref}
                data-gaga-preview-snippet={pub.summary ?? ''}
                data-gaga-preview-topics={topicLabels}
                data-gaga-preview-tags={pub.tags.join(', ')}
                data-gaga-preview-read-time={pub.readTime ?? ''}
                data-gaga-preview-date={pub.publishedAt ?? ''}
              >
                {pub.title}
              </a>
              <p class="pakrpp-archive-year__meta">
                {[pubType.label, topicLabels, pub.publishedAt, pub.readTime].filter(Boolean).join(' · ')}
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</GagaSiteLayout>

<style>
  .pakrpp-archive-year {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .pakrpp-archive-year__nav,
  .pakrpp-archive-year__months {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
    opacity: 0.8;
  }
  .pakrpp-archive-year__months {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.2));
  }
  .pakrpp-archive-year__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pakrpp-archive-year__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.65rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.15));
  }
  .pakrpp-archive-year__idx {
    font-family: var(--gaga-font-mono, monospace);
    font-size: 0.8rem;
    opacity: 0.6;
  }
  .pakrpp-archive-year__title {
    font-size: 1rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }
  .pakrpp-archive-year__title:hover {
    text-decoration: underline;
  }
  .pakrpp-archive-year__meta {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    opacity: 0.65;
  }
</style>
