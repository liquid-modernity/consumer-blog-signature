---
import GagaSiteLayout from '../../../components/gaga/GagaSiteLayout.astro';
import {
  resolveCanonicalTopic,
  resolvePublicationType
} from '../../../config/pakrpp-architecture';
import { getArchiveYears } from '../../../lib/pakrpp-content';
import { routes } from '../../../config/routes';

export const prerender = true;

export async function getStaticPaths() {
  const archiveYears = await getArchiveYears();
  return archiveYears.flatMap((yearGroup) =>
    yearGroup.months.map((monthGroup) => ({
      params: { year: yearGroup.year, month: monthGroup.month },
      props: { monthGroup }
    }))
  );
}

const { monthGroup } = Astro.props;
if (!monthGroup) {
  return Astro.redirect('/404');
}

const entryData = {
  title: `Arsip ${monthGroup.label}`,
  subtitle: `Tampilan temporal publikasi untuk periode ${monthGroup.label}.`,
  description: `Daftar publikasi periode ${monthGroup.label} di PAKRPP.`,
  summary: `Arsip temporal untuk ${monthGroup.label}.`,
  contentKind: 'page',
  contentClass: 'archive-month',
  contentId: `pakrpp.archive.${monthGroup.year}.${monthGroup.month}`,
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <section class="pakrpp-archive-month" aria-label={`Arsip ${monthGroup.label}`}>
    <div class="pakrpp-archive-month__nav">
      <a href={routes.archive.year(monthGroup.year)}>← Arsip {monthGroup.year}</a>
      <span aria-hidden="true">·</span>
      <a href={routes.archive.index}>Semua Arsip</a>
      <span aria-hidden="true">·</span>
      <span>{monthGroup.count} publikasi</span>
    </div>

    <ol class="pakrpp-archive-month__list" data-gaga-preview-scope>
      {monthGroup.publications.map((pub, idx) => {
        const pubType = resolvePublicationType(pub.type);
        const topicLabels = pub.topics
          .map((t) => resolveCanonicalTopic(t)?.label ?? t)
          .join(', ');
        return (
          <li class="pakrpp-archive-month__item">
            <span class="pakrpp-archive-month__idx">{String(idx + 1).padStart(2, '0')}</span>
            <div>
              <a href={pub.canonicalHref} class="pakrpp-archive-month__title">
                {pub.title}
              </a>
              <p class="pakrpp-archive-month__meta">
                {[pubType.label, topicLabels, pub.publishedAt, pub.readTime].filter(Boolean).join(' · ')}
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</GagaSiteLayout>

<style>
  .pakrpp-archive-month {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .pakrpp-archive-month__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
    opacity: 0.8;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.2));
  }
  .pakrpp-archive-month__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pakrpp-archive-month__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.65rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.15));
  }
  .pakrpp-archive-month__idx {
    font-family: var(--gaga-font-mono, monospace);
    font-size: 0.8rem;
    opacity: 0.6;
  }
  .pakrpp-archive-month__title {
    font-size: 1rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }
  .pakrpp-archive-month__title:hover {
    text-decoration: underline;
  }
  .pakrpp-archive-month__meta {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    opacity: 0.65;
  }
</style>
