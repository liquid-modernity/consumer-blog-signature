---
import GagaSiteLayout from '../components/gaga/GagaSiteLayout.astro';
import {
  resolveCanonicalTopic,
  resolvePublicationType
} from '../config/pakrpp-architecture';
import { toCanonicalPublications } from '../lib/pakrpp-content';
import { routes } from '../config/routes';

export const prerender = true;

const publications = await toCanonicalPublications();

const entryData = {
  title: 'Semua Publikasi Terbaru',
  subtitle: 'Tampilan penemuan (discovery view) kronologis untuk seluruh publikasi.',
  description: 'Daftar kronologis seluruh publikasi terbaru di PAKRPP.',
  summary: '/latest adalah discovery view. Objek publikasi kanonik tetap berada di /publications dan /publications/:slug.',
  contentKind: 'index',
  contentClass: 'index',
  contentId: 'pakrpp.discovery.latest',
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <section class="pakrpp-latest-view" aria-label="Daftar Publikasi Terbaru">
    <p class="pakrpp-latest-view__note">
      Menampilkan {publications.length} publikasi secara kronologis · <a href={routes.publications.index}>Lihat Repositori Objek (/publications) →</a>
    </p>
    <ol class="pakrpp-latest-view__list" data-gaga-preview-scope>
      {publications.map((pub, index) => {
        const pubType = resolvePublicationType(pub.type);
        const topicLabels = pub.topics
          .map((t) => resolveCanonicalTopic(t)?.label ?? t)
          .join(', ');
        const contextLabel = [pubType.label, topicLabels, pub.readTime].filter(Boolean).join(' · ');
        return (
          <li class="pakrpp-latest-view__item">
            <span class="pakrpp-latest-view__num">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <a
                href={pub.canonicalHref}
                class="pakrpp-latest-view__title"
                data-gaga-preview
                data-gaga-preview-title={pub.title}
                data-gaga-preview-href={pub.canonicalHref}
                data-gaga-preview-snippet={pub.summary ?? ''}
                data-gaga-preview-meta={contextLabel}
                data-gaga-preview-type={pubType.label}
                data-gaga-preview-topics={topicLabels}
                data-gaga-preview-tags={pub.tags.join(', ')}
                data-gaga-preview-read-time={pub.readTime ?? ''}
                data-gaga-preview-date={pub.publishedAt ?? ''}
                data-gaga-preview-author={pub.authors.join(', ')}
              >
                {pub.title}
              </a>
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</GagaSiteLayout>

<style>
  .pakrpp-latest-view {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .pakrpp-latest-view__note {
    margin: 0;
    font-size: 0.82rem;
    opacity: 0.75;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.22));
  }
  .pakrpp-latest-view__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pakrpp-latest-view__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.65rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.15));
  }
  .pakrpp-latest-view__num {
    font-family: var(--gaga-font-mono, monospace);
    font-size: 0.8rem;
    opacity: 0.6;
  }
  .pakrpp-latest-view__title {
    font-size: 1rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }
  .pakrpp-latest-view__title:hover {
    text-decoration: underline;
  }
  .pakrpp-latest-view__meta {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    opacity: 0.65;
  }
</style>
