---
import '../styles/tokens.css';
import '../styles/signature.scss';
import StandaloneAppFrame from '../components/frame/StandaloneAppFrame.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import ResponsiveImage from '../components/media/ResponsiveImage.astro';
import MediaCarousel from '../components/media/MediaCarousel.astro';
import MediaGallery from '../components/media/MediaGallery.astro';
import VideoPlayer from '../components/media/VideoPlayer.astro';
import AudioPlayer from '../components/media/AudioPlayer.astro';
import InteractiveEmbed from '../components/media/InteractiveEmbed.astro';
import RelatedKnowledge from '../components/knowledge/RelatedKnowledge.astro';
import { normalizeContentMetadata } from '@gaga/engine/content';
import type { ScreenInfo } from '../lib/screen-info';

const title = 'Akal Imitasi & Arsitektur Pengetahuan: Merancang Ruang Publikasi Generasi Baru';
const subtitle = 'Mengubah pola pikir dari sekadar halaman dokumentasi statis menjadi ruang kerja pengetahuan kontekstual yang adaptif, imersif, dan terintegrasi.';
const description = 'Laporan khusus tentang bagaimana Consumer Blog Signature memadukan rel navigasi stabil, kanvas baca bernutrisi tinggi, rel intelijen kontekstual, dan runtime aksi universal.';

const metadata = normalizeContentMetadata({
  title,
  seoTitle: `${title} • Consumer Signature`,
  subtitle,
  description,
  summary: description,
  language: 'id',
  author: 'Editorial Team',
  canonical: '/article',
  contentKind: 'article',
  contentClass: 'article-flagship',
  publishedAt: '2026-10-11',
  updatedAt: '2026-10-11',
  readTime: '8 min read',
  topics: ['Product Architecture', 'Reader Experience'],
  tags: ['architecture', 'ux', 'rich-media', 'knowledge-graph']
});

const info: ScreenInfo = {
  kind: 'article',
  outlineItems: [
    { slug: 'dekonstruksi-paradigma', text: '01. Dekonstruksi Paradigma Halaman' },
    { slug: 'pemisahan-aksi-global', text: '02. Pemisahan Aksi Global dan Konteks Pengetahuan' },
    { slug: 'integrasi-media-interaktif', text: '03. Integrasi Media Interaktif dan Graf Semantik' },
    { slug: 'kesimpulan-arsitektur', text: '04. Kesimpulan Arsitektur Pengetahuan' }
  ],
  snippet: 'Merancang ruang publikasi generasi baru yang memadukan rel navigasi global, kanvas baca fokus, rel intelijen kontekstual, dan runtime aksi universal.',
  publishedDate: { text: '11 Oktober 2026', datetime: '2026-10-11' },
  updatedAtDisplay: { text: 'Hari ini', datetime: '2026-10-11' },
  readTime: '8 min read',
  topics: ['Product Architecture', 'Reader Experience'],
  tags: ['architecture', 'ux', 'rich-media', 'knowledge-graph'],
  author: 'Editorial Team',
  discovery: [
    { title: 'Softcoded Systems Scale Better', href: '/softcoded-systems-scale-better-than-theme-forks', meta: 'Article · 5 min' },
    { title: 'Designing Context-Aware Reading Surface', href: '/designing-context-aware-reading-surface', meta: 'Article · 6 min' }
  ]
};

const carouselSlides = [
  {
    alt: 'Arsitektur Blueprint Ruang Kerja',
    title: 'Visualisasi Workspace Blueprint',
    caption: 'Konfigurasi rel navigasi vertikal ikon-saja berdampingan dengan rel konteks kiri dan intelijen kanan.',
    credit: 'Gaga Engineering Design Studio'
  },
  {
    alt: 'Topografi Tipografi Editorial',
    title: 'Skala Tipografi Bebas-Pills',
    caption: 'Menghilangkan pill badge berlebihan untuk mendukung kejelasan hierarki teks murni bergaya kuratorial.',
    credit: 'Editorial Typography Archive'
  },
  {
    alt: 'Graf Pengetahuan Semantik',
    title: 'Pemetaan Relasi Entitas',
    caption: 'Menghubungkan artikel ke topik, penulis, dan sumber bukti secara organik tanpa pemisah artifisial.',
    credit: 'Semantic Intelligence Lab'
  }
];

const galleryItems = [
  {
    alt: 'Desain Kanvas Baca Fokus',
    title: 'Kanvas Baca Ergonomis',
    caption: 'Lebar membaca 65–75ch dengan proporsi leading longgar untuk ketahanan fokus jangka panjang.'
  },
  {
    alt: 'Runtime Aksi Kontekstual',
    title: 'Aksi Halaman Universal',
    caption: 'Smart Back, Smart Share, Focus Mode, Highlight, dan Narasi Suara selalu terjangkau dalam 1 ketukan.'
  },
  {
    alt: 'Rel Intelijen Kontekstual',
    title: 'Menjawab: Apa yang Harus Diketahui?',
    caption: 'Daftar isi interaktif, ringkasan kontekstual, dan tautan eksplorasi pengetahuan terkait.'
  }
];
---
<html lang="id-ID">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead metadata={metadata} pathname="/article" title={title} includeWebSiteSchema={false} />
    <style is:global>
      /* Smooth reading progress indicator */
      .gaga-reading-progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: var(--gaga-blue);
        width: 0%;
        z-index: 999;
        transition: width 0.08s ease-out;
        pointer-events: none;
      }

      /* Editorial Longform Typography */
      .gaga-flagship-article {
        max-width: var(--gaga-content-width, 44rem);
        margin-inline: auto;
        padding-block: 1rem 4rem;
        color: var(--gaga-ink);
      }

      .gaga-flagship-article__breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--gaga-font-mono);
        font-size: 0.72rem;
        color: var(--gaga-muted);
        margin-bottom: 1.25rem;
      }

      .gaga-flagship-article__breadcrumb a {
        color: inherit;
        text-decoration: none;
      }

      .gaga-flagship-article__breadcrumb a:hover {
        color: var(--gaga-blue);
      }

      .gaga-flagship-article__kicker {
        font-family: var(--gaga-font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gaga-blue);
        font-weight: 700;
        margin-bottom: 0.6rem;
      }

      .gaga-flagship-article__title {
        font-family: var(--gaga-font-display, serif);
        font-size: clamp(2.2rem, 4.5vw, 3.4rem);
        line-height: 1.08;
        letter-spacing: -0.025em;
        margin: 0 0 1rem;
        font-weight: 700;
        color: var(--gaga-ink);
        text-wrap: balance;
      }

      .gaga-flagship-article__subtitle {
        font-size: 1.2rem;
        line-height: 1.55;
        color: var(--gaga-muted);
        margin: 0 0 1.5rem;
        font-weight: 400;
      }

      /* Rich Author Identity Card */
      .gaga-flagship-article__author-card {
        display: flex;
        align-items: center;
        gap: 1.15rem;
        margin: 1.6rem 0 1.4rem;
        padding: 1rem 1.25rem;
        border-radius: var(--gaga-radius-md, 8px);
        background: var(--gaga-surface-subtle, rgba(0, 0, 0, 0.02));
        border: 1px solid var(--gaga-line, rgba(0, 0, 0, 0.08));
      }

      .gaga-flagship-article__author-avatar {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        background: var(--gaga-blue, #2563eb);
        color: #ffffff;
        display: grid;
        place-items: center;
        font-family: var(--gaga-font-mono, monospace);
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.05em;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
      }

      .gaga-flagship-article__author-info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .gaga-flagship-article__author-row {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
      }

      .gaga-flagship-article__author-name {
        font-weight: 700;
        font-size: 0.98rem;
        color: var(--gaga-ink, #0f172a);
      }

      .gaga-flagship-article__verified-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--gaga-font-mono, monospace);
        font-size: 0.72rem;
        color: var(--gaga-blue, #2563eb);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .gaga-flagship-article__badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gaga-blue, #2563eb);
      }

      .gaga-flagship-article__author-bio {
        margin: 0;
        font-size: 0.82rem;
        color: var(--gaga-muted, #64748b);
        line-height: 1.45;
      }

      /* Zero-Pill Unboxed Metadata */
      .gaga-flagship-article__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.65rem;
        padding-block: 0.85rem;
        border-block: 1px solid var(--gaga-line);
        margin-bottom: 2.5rem;
        font-size: 0.82rem;
        color: var(--gaga-muted);
        font-family: var(--gaga-font-mono);
      }

      .gaga-flagship-article__meta-sep {
        color: var(--gaga-tertiary, #cbd5e1);
      }

      .gaga-meta-link {
        color: var(--gaga-blue, #2563eb);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .gaga-meta-tag {
        color: var(--gaga-ink, #0f172a);
        font-weight: 500;
      }

      /* Editorial Prose & Drop Cap - Connected directly to Gaga Reader Runtime */
      .gaga-flagship-article__prose {
        font-family: var(--gaga-article-font-family, var(--gaga-font-body, sans-serif));
        font-size: var(--gaga-article-font-size, 1.1rem);
        line-height: var(--gaga-article-line-height, 1.82);
        letter-spacing: var(--gaga-article-letter-spacing, normal);
        max-width: var(--gaga-article-measure, 44rem);
        color: var(--gaga-ink);
        transition: font-size 0.2s ease, line-height 0.2s ease, letter-spacing 0.2s ease;
      }

      .gaga-flagship-article__lead::first-letter {
        font-family: var(--gaga-font-display, serif);
        font-size: 3.8rem;
        float: left;
        line-height: 0.8;
        padding-right: 0.6rem;
        padding-top: 0.2rem;
        color: var(--gaga-blue);
        font-weight: 700;
      }

      .gaga-flagship-article__prose h2 {
        font-family: var(--gaga-font-display, serif);
        font-size: 1.75rem;
        font-weight: 700;
        margin: 3.2rem 0 1.2rem;
        padding-top: 1.6rem;
        border-top: 1px solid var(--gaga-line);
        letter-spacing: -0.015em;
        color: var(--gaga-ink);
      }

      .gaga-flagship-article__prose p {
        margin: 1.35rem 0;
      }

      /* Pull Quote */
      .gaga-editorial-quote {
        margin: 2.8rem 0;
        padding: 1.75rem 2.25rem;
        border-block: 1px solid var(--gaga-line-strong);
        background: var(--gaga-surface-subtle);
        border-left: 3px solid var(--gaga-blue);
      }

      .gaga-editorial-quote blockquote {
        margin: 0;
        font-family: var(--gaga-font-display, serif);
        font-style: italic;
        font-size: 1.35rem;
        line-height: 1.55;
        color: var(--gaga-ink);
      }

      .gaga-editorial-quote cite {
        display: block;
        margin-top: 0.9rem;
        font-family: var(--gaga-font-mono);
        font-size: 0.75rem;
        font-style: normal;
        color: var(--gaga-muted);
        letter-spacing: 0.06em;
      }

      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        *, ::before, ::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- Reading Progress Bar -->
    <div class="gaga-reading-progress-bar" id="gaga-reading-progress-bar"></div>

    <StandaloneAppFrame
      pageId="article-benchmark"
      pageTitle={title}
      contentKind="article"
      contentClass="article-flagship"
      info={info}
    >
      <article
        class="gaga-flagship-article"
        id="article-root"
        data-gaga-article-shell
        data-gaga-article-route="/article"
        data-gaga-language="id-ID"
        data-gaga-article-title={title}
        data-gaga-article-author="Tim Riset Editorial & Rekayasa Gaga"
        data-gaga-article-topic="Arsitektur Produk"
      >
        <!-- Breadcrumbs -->
        <nav class="gaga-flagship-article__breadcrumb" aria-label="Breadcrumb navigation">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <a href="/topics/experience">Arsitektur Produk</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Laporan Khusus</span>
        </nav>

        <!-- Editorial Header -->
        <header class="gaga-flagship-article__header">
          <div class="gaga-flagship-article__kicker">SPECIAL BENCHMARK REPORT · ARSITEKTUR SISTEM</div>
          <h1 class="gaga-flagship-article__title">{title}</h1>
          <p class="gaga-flagship-article__subtitle">{subtitle}</p>

          <!-- Rich Author Identity -->
          <div class="gaga-flagship-article__author-card">
            <div class="gaga-flagship-article__author-avatar" aria-hidden="true">
              <span class="gaga-flagship-article__avatar-initials">ER</span>
            </div>
            <div class="gaga-flagship-article__author-info">
              <div class="gaga-flagship-article__author-row">
                <span class="gaga-flagship-article__author-name">Tim Riset Editorial & Rekayasa Gaga</span>
                <span class="gaga-flagship-article__verified-badge" title="Tinjauan Komite Editorial">
                  <span class="gaga-flagship-article__badge-dot" aria-hidden="true"></span> Terverifikasi Redaksi
                </span>
              </div>
              <p class="gaga-flagship-article__author-bio">
                Divisi Riset Interaksi Kognitif & Arsitektur Publikasi Digital · Gaga Engineering Systems Group
              </p>
            </div>
          </div>

          <!-- Zero-Pill Unboxed Metadata -->
          <div class="gaga-flagship-article__meta">
            <span class="gaga-flagship-article__meta-item">
              <strong>Dipublikasikan:</strong> 11 Oktober 2026
            </span>
            <span class="gaga-flagship-article__meta-sep" aria-hidden="true">·</span>
            <span class="gaga-flagship-article__meta-item">
              <strong>Estimasi Baca:</strong> 8 min bacaan (~2.150 kata)
            </span>
            <span class="gaga-flagship-article__meta-sep" aria-hidden="true">·</span>
            <span class="gaga-flagship-article__meta-item">
              <strong>Topik Utama:</strong> <a href="/topics/experience" class="gaga-meta-link">Arsitektur Produk</a>
            </span>
            <span class="gaga-flagship-article__meta-sep" aria-hidden="true">·</span>
            <span class="gaga-flagship-article__meta-item">
              <strong>Relasi Pengetahuan:</strong>
              <span class="gaga-meta-tag">Sistem Kontekstual</span> /
              <span class="gaga-meta-tag">Ergonomi Kognitif</span> /
              <span class="gaga-meta-tag">Graf Semantik</span>
            </span>
          </div>
        </header>

        <!-- Audio Narration Player -->
        <AudioPlayer
          title="Narasi Lengkap: Akal Imitasi & Arsitektur Pengetahuan"
          author="Editorial Voice Synthesis"
          duration="08:24"
        />

        <!-- Hero Responsive Image with Fullscreen Lightbox -->
        <ResponsiveImage
          alt="Paviliun Arsitektur Perpustakaan Pengetahuan Kontemporer"
          caption="Ruang baca arsitektural yang memadukan pencahayaan alami, struktur batu monolitik, dan ketenangan kontemplatif."
          credit="Curatorial Archival Studio"
          aspectRatio="16/9"
          layout="wide"
        />

        <!-- Article Prose Body -->
        <div class="gaga-flagship-article__prose" id="article-content">
          <p class="gaga-flagship-article__lead">
            Pergeseran mendasar dalam arsitektur publikasi digital kontemporer tidak lagi berkisar pada estetika dekoratif, melainkan pada bagaimana sistem informasi menghargai kognisi pembaca. Selama lebih dari dua dekade, situs web penerbitan dan portal pengetahuan terjebak dalam dikotomi sempit: antara template dokumentasi yang kaku dengan deretan menu panjang yang menakutkan, atau blog komersial yang dipenuhi badge warna-warni dan elemen mengganggu.
          </p>

          <h2 id="dekonstruksi-paradigma">01. Dekonstruksi Paradigma Halaman</h2>
          <p>
            Ketika pembaca membuka sebuah tulisan bernilai tinggi, pertanyaan utama yang muncul bukanlah "bahasa pemrograman apa yang dipakai", melainkan dua orientasi kognitif mendasar: <em>Di mana saya bisa pergi?</em> dan <em>Apa yang perlu saya pahami sekarang?</em>
          </p>
          <p>
            Dengan memisahkan kedua pertanyaan ini secara tegas ke dalam dua permukaan terpisah—Rel Konteks Kiri yang menjawab navigasi rute ("Where can I go?"), dan Rel Intelijen Kanan yang menyajikan ringkasan intisari serta daftar isi ("What should I know?")—antarmuka tidak lagi bersaing memperebutkan perhatian mata. Keduanya secara default berada dalam status <strong>collapsed</strong> pada layar desktop, memberikan ketenangan total bagi kanvas membaca utama.
          </p>

          <!-- Editorial Pull Quote -->
          <div class="gaga-editorial-quote">
            <blockquote>
              "Sistem publikasi yang berkelas tidak pernah memaksa pembaca mempelajari tombol-tombolnya; antarmukanya beroperasi dalam hening, hanya hadir ketika dipanggil oleh niat sadar."
            </blockquote>
            <cite>— PRINSIP DESAIN CONSUMER SIGNATURE</cite>
          </div>

          <!-- Curated Exhibit Carousel -->
          <MediaCarousel
            title="Eksplorasi Dimensi Visual & Interaksi Workspace"
            slides={carouselSlides}
          />

          <h2 id="pemisahan-aksi-global">02. Pemisahan Aksi Global dan Konteks Pengetahuan</h2>
          <p>
            Sebagian besar situs berita atau dokumentasi mencampuradukkan tautan rute umum dengan kontrol membaca. Hal tersebut menciptakan kelelahan visual (visual fatigue). Melalui Global Navigation Rail yang berorientasi vertikal dan beroperasi dengan ikon bersih, navigasi utama (Beranda, Pencarian, Topik, Pustaka, Arsip, dan Informasi) terkonsentrasi di sisi paling kiri sebagai fondasi yang kokoh.
          </p>
          <p>
            Sebaliknya, kontrol utilitas aktif pembaca diwujudkan dalam <strong>Action Runtime</strong> yang universal. Aksi Smart Back mengerti riwayat navigasi Anda; Smart Share menyalin tautan secara cerdas; Focus Mode memperluas kanvas dan meredupkan gangguan; Highlight menyimpan anotasi lokal; serta Narasi Suara membacakan artikel secara langsung.
          </p>

          <!-- Interactive Embed Showcase -->
          <InteractiveEmbed
            title="Matriks Penyelarasan Kognitif Interaktif"
            caption="Uji coba simulasi metrik relasi pengetahuan dan latensi komputasi antarmuka."
            aspectRatio="16/9"
          />

          <h2 id="integrasi-media-interaktif">03. Integrasi Media Interaktif dan Graf Semantik</h2>
          <p>
            Media bukan sekadar gambar dekoratif pelengkap teks. Setiap komponen media—mulai dari gambar responsif, korsel kuratorial, galeri masonry, hingga video dan audio—harus mendukung interaksi penuh melalui sentuhan jari, keyboard, aksesibilitas screen reader, serta kemampuan perbesaran layar penuh (fullscreen lightbox).
          </p>

          <!-- Video Broadcast Component -->
          <VideoPlayer
            title="Dokumenter: Menemukan Kembali Keheningan Membaca"
            caption="Rekaman diskusi panel perancangan tipografi dan arsitektur publikasi tanpa gangguan."
            duration="04:12"
          />

          <!-- Gallery Component -->
          <MediaGallery
            title="Katalog Monograf Desain & Tipografi"
            items={galleryItems}
            columns={3}
          />

          <h2 id="kesimpulan-arsitektur">04. Kesimpulan Arsitektur Pengetahuan</h2>
          <p>
            Masa depan penerbitan digital adalah perpaduan antara keanggunan majalah cetak kelas atas dengan ketajaman sistem basis pengetahuan cerdas. Melalui fondasi yang dapat dikonfigurasi penuh, arsitektur ini siap menjadi standar baku bagi publikasi korporat, institusi riset, maupun media editorial independen.
          </p>
        </div>

        <!-- Semantic Related Knowledge Section -->
        <RelatedKnowledge
          graphNodeId="consumer.article.context-aware-reading"
        />
      </article>
    </StandaloneAppFrame>

    <!-- Reading Scroll Progress Script -->
    <script>
      function setupReadingProgress() {
        const progressBar = document.getElementById('gaga-reading-progress-bar');
        if (!progressBar) return;

        let ticking = false;

        function updateProgress() {
          const scrollElement = document.querySelector('.gaga-main-region') as HTMLElement | null;
          let scrollTop = 0;
          let scrollHeight = 0;
          let clientHeight = 0;

          if (scrollElement && scrollElement.scrollTop > 0) {
            scrollTop = scrollElement.scrollTop;
            scrollHeight = scrollElement.scrollHeight;
            clientHeight = scrollElement.clientHeight;
          } else {
            scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
            scrollHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
            clientHeight = window.innerHeight;
          }

          const maxScroll = Math.max(1, scrollHeight - clientHeight);
          const percentage = Math.min(100, Math.max(0, (scrollTop / maxScroll) * 100));
          if (progressBar) {
            progressBar.style.width = `${percentage}%`;
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateProgress);
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        const scrollContainer = document.querySelector('.gaga-main-region');
        if (scrollContainer) {
          scrollContainer.addEventListener('scroll', onScroll, { passive: true });
        }
        updateProgress();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReadingProgress);
      } else {
        setupReadingProgress();
      }
    </script>
  </body>
</html>
