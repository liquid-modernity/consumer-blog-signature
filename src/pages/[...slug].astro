---
import '../styles/tokens.css';
import '../styles/signature.scss';
import { getCollection, render } from 'astro:content';
import Head from '../components/starlight/Head.astro';
import PageFrame from '../components/starlight/PageFrame.astro';
import Sidebar from '../components/starlight/Sidebar.astro';
import ContentPanel from '../components/starlight/ContentPanel.astro';
import PageTitle from '../components/starlight/PageTitle.astro';
import MarkdownContent from '../components/starlight/MarkdownContent.astro';
import { normalizeContentMetadata } from '@gaga/engine/content';

export const prerender = true;

export async function getStaticPaths() {
  const toRouteSlug = (id: string): string | undefined => {
    let slug = id
      .replace(/\.(md|mdx)$/i, '')
      .replace(/^\/+|\/+$/g, '');

    if (slug === 'index') return undefined;
    if (slug.endsWith('/index')) slug = slug.slice(0, -'/index'.length);

    return slug || undefined;
  };

  const entries = await getCollection('docs');
  const paths = entries.map((entry) => ({
    params: {
      slug: toRouteSlug(entry.id)
    },
    props: {
      entry
    }
  }));

  if (!paths.some((path) => path.params.slug === undefined)) {
    throw new Error('[GAGA] Root content route is missing. Expected src/content/docs/index.md or index.mdx.');
  }

  return paths;
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
const metadata = normalizeContentMetadata(entry.data as Record<string, unknown>);
const language = metadata.language === 'en' ? 'en' : 'id-ID';
---

<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head />
  </head>
  <body>
    <PageFrame>
      <Fragment slot="sidebar">
        <Sidebar />
      </Fragment>

      <div class="main-pane">
        <ContentPanel>
          <PageTitle />
        </ContentPanel>
        <ContentPanel>
          <MarkdownContent>
            <Content />
          </MarkdownContent>
        </ContentPanel>
      </div>
    </PageFrame>
  </body>
</html>
