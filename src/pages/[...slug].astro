---
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../config/site';
import { presence } from '../lib/presence';
import { projectPresenceRoutes } from '../features/personal-presence/model.mjs';
import { resolvePresenceContent } from '../lib/presence-content';
import PresenceContent from '../components/reader/PresenceContent.astro';
import GagaSiteLayout from '../components/gaga/GagaSiteLayout.astro';
import { normalizeGagaRouteContext } from '../gaga/content/runtime-route';

export const prerender = true;

export async function getStaticPaths() {
  const toRouteSlug = (id: string): string | undefined => {
    let slug = id
      .replace(/\.(md|mdx)$/i, '')
      .replace(/^\/+|\/+$/g, '');

    if (slug === 'index') return undefined;
    if (slug.endsWith('/index')) slug = slug.slice(0, -'/index'.length);

    return slug || undefined;
  };

  const entries = await getCollection('docs');
  const paths: any[]=projectPresenceRoutes(presence,entries,toRouteSlug);

  if (!paths.some((path) => path.params.slug === undefined)) {
    throw new Error('[GAGA] Root content route is missing. Expected src/content/docs/index.md or index.mdx.');
  }

  return paths;
}

const { entry, capability } = Astro.props;
if (!entry && !capability) throw Error('Missing public route source');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const presenceData = capability ? await resolvePresenceContent(capability) : {id:'',title:'',summary:'',language:siteConfig.defaultLanguage,sections:[]};
const entryData = capability ? {...(entry?.data??{}),title:entry?.data.title??presenceData.title,summary:entry?.data.summary??presenceData.summary,description:entry?.data.description??presenceData.summary,contentKind:'page',contentId:presenceData.id,canonical:capability.canonicalUrl,status:'published',visibility:'public',language:entry?.data.language??presenceData.language??siteConfig.defaultLanguage} : entry.data;
const headings=rendered?.headings??presenceData?.sections.map((section:any)=>({depth:2,text:section.label.id,slug:section.id}))??[];
---
<GagaSiteLayout entryData={entryData} routeContext={normalizeGagaRouteContext({ ...Astro.locals.gagaRoute, toc: { items: headings.map((h:any)=>({depth:h.depth,text:h.text,slug:h.slug})) } })}>
 {capability ? <PresenceContent capability={capability} content={presenceData}>{Content&&<Content />}</PresenceContent> : Content&&<Content />}
</GagaSiteLayout>
