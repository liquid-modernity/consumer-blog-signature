---
import { getCollection, render } from 'astro:content';
import GagaSiteLayout from '../components/gaga/GagaSiteLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const toRouteSlug = (id: string): string | undefined => {
    let slug = id
      .replace(/\.(md|mdx)$/i, '')
      .replace(/^\/+|\/+$/g, '');

    if (slug === 'index') return undefined;
    if (slug.endsWith('/index')) slug = slug.slice(0, -'/index'.length);

    return slug || undefined;
  };

  const entries = await getCollection('docs');
  const paths = entries.map((entry) => ({
    params: {
      slug: toRouteSlug(entry.id)
    },
    props: {
      entry
    }
  }));

  if (!paths.some((path) => path.params.slug === undefined)) {
    throw new Error('[GAGA] Root content route is missing. Expected src/content/docs/index.md or index.mdx.');
  }

  return paths;
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
const entryData = entry.data as Record<string, unknown>;
---

<GagaSiteLayout entryData={entryData} routeContext={Astro.locals.gagaRoute}>
  <Content />
</GagaSiteLayout>
