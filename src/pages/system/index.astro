---
import GagaSiteLayout from '../../components/gaga/GagaSiteLayout.astro';
import { navigationConfig } from '../../config/pakrpp-architecture';
import { routes } from '../../config/routes';

export const prerender = true;

const systemSection = navigationConfig.sections.find((s) => s.id === 'system');

const entryData = {
  title: 'Sistem & Antarmuka Mesin',
  subtitle: 'Pemisahan tegas antara antarmuka manusia (/system/*) dan antarmuka mesin (/sitemap.xml, /rss.xml, /robots.txt).',
  description: 'Indeks halaman sistem PAKRPP: Peta Situs manusia, langganan RSS, dan status sistem.',
  summary: '/system/sitemap untuk manusia vs /sitemap.xml untuk crawler; /system/rss untuk langganan vs /rss.xml untuk feed XML.',
  contentKind: 'system',
  contentClass: 'system',
  contentId: 'pakrpp.system.root',
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <section class="pakrpp-sys-hub" aria-label="Antarmuka Sistem">
    <h2>Antarmuka Manusia (Human-Facing)</h2>
    <ul>
      {(systemSection?.items ?? []).map((item) => (
        <li>
          <a href={item.href}><strong>{item.label}</strong></a> (<code>{item.href}</code>) — {item.meta}
        </li>
      ))}
    </ul>

    <h2>Antarmuka Mesin (Machine-Facing)</h2>
    <ul>
      <li><a href={routes.machine.sitemap}><strong>XML Sitemap</strong></a> (<code>{routes.machine.sitemap}</code>)</li>
      <li><a href={routes.machine.rss}><strong>RSS XML Feed</strong></a> (<code>{routes.machine.rss}</code>)</li>
      <li><a href={routes.machine.robots}><strong>Robots Policy</strong></a> (<code>{routes.machine.robots}</code>)</li>
    </ul>
  </section>
</GagaSiteLayout>
