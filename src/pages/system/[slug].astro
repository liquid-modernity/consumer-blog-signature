---
import GagaSiteLayout from '../../components/gaga/GagaSiteLayout.astro';
import {
  featureFlags,
  getEnabledPublicationTypes,
  getEnabledRootSections
} from '../../config/pakrpp-architecture';
import {
  getArchiveYears,
  getCanonicalTopicsWithCounts,
  localContentAdapter,
  toCanonicalPublications
} from '../../lib/pakrpp-content';
import { routes } from '../../config/routes';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { slug: 'sitemap' } },
    { params: { slug: 'rss' } },
    { params: { slug: 'status' } }
  ];
}

const { slug } = Astro.params;
const [publications, topics, archiveYears] = await Promise.all([
  toCanonicalPublications(),
  getCanonicalTopicsWithCounts(),
  getArchiveYears()
]);
const rootSections = getEnabledRootSections();
const pubTypes = getEnabledPublicationTypes();

const metaMap: Record<string, { title: string; subtitle: string; summary: string }> = {
  sitemap: {
    title: 'Peta Situs (Human Sitemap)',
    subtitle: 'Hierarki lengkap rute kanonik dan navigasi manusia untuk pembaca.',
    summary: '/system/sitemap adalah peta situs untuk manusia, terpisah dari /sitemap.xml yang ditujukan bagi crawler mesin.'
  },
  rss: {
    title: 'Sindikasi & Langganan RSS',
    subtitle: 'Halaman informasi dan petunjuk langganan umpan terbuka PAKRPP.',
    summary: '/system/rss adalah antarmuka manusia untuk informasi sindikasi, sedangkan umpan XML aktual berada di /rss.xml.'
  },
  status: {
    title: 'Status Sistem & Kontrak Arsitektur',
    subtitle: 'Verifikasi invarian inti, feature flags, registry softcoded, dan adapter CMS.',
    summary: 'Laporan kesehatan kontrak arsitektur PAKRPP Knowledge Publication System.'
  }
};

const current = metaMap[slug ?? 'sitemap'] ?? metaMap.sitemap;

const entryData = {
  title: current.title,
  subtitle: current.subtitle,
  description: current.summary,
  summary: current.summary,
  contentKind: 'system',
  contentClass: 'system',
  contentId: `pakrpp.system.${slug}`,
  status: 'published',
  visibility: 'public',
  language: 'id'
};
---

<GagaSiteLayout entryData={entryData}>
  <nav class="pakrpp-sys-nav" aria-label="Navigasi Sistem">
    <a href={routes.system.sitemap}>Peta Situs (/system/sitemap)</a>
    <span aria-hidden="true">·</span>
    <a href={routes.system.rss}>RSS (/system/rss)</a>
    <span aria-hidden="true">·</span>
    <a href={routes.system.status}>Status (/system/status)</a>
    <span aria-hidden="true">·</span>
    <a href={routes.machine.sitemap}>XML Crawler ({routes.machine.sitemap})</a>
  </nav>

  {slug === 'sitemap' && (
    <section class="pakrpp-sys-section" aria-label="Hierarki Peta Situs Manusia">
      <p>
        Peta situs ini dirancang untuk manusia. Untuk crawler dan pengindeks otomatis, gunakan <a href={routes.machine.sitemap}><code>{routes.machine.sitemap}</code></a>.
      </p>

      <h2>1. Bagian Root Indeks (/)</h2>
      <ul>
        {rootSections.map((sec) => (
          <li>
            <a href={`/#${sec.anchor}`}><strong>#{sec.label}</strong></a> (<code>/#{sec.anchor}</code>)
          </li>
        ))}
      </ul>

      <h2>2. Publikasi Kanonik ({publications.length})</h2>
      <ul>
        <li><a href={routes.publications.index}><strong>Indeks Objek Publikasi</strong></a> (<code>/publications</code>)</li>
        <li><a href={routes.discovery.latest}><strong>Semua Publikasi Terbaru</strong></a> (<code>/latest</code>)</li>
        {publications.map((pub) => (
          <li>
            <a href={pub.canonicalHref}>{pub.title}</a> (<code>{pub.canonicalHref}</code>)
          </li>
        ))}
      </ul>

      <h2>3. Topik ({topics.length}) &amp; Arsip ({archiveYears.length})</h2>
      <ul>
        {topics.map((t) => (
          <li>
            <a href={t.href}>Topik: {t.label}</a> (<code>{t.href}</code> · {t.count} publikasi)
          </li>
        ))}
        {archiveYears.map((y) => (
          <li>
            <a href={y.href}>Arsip {y.year}</a> (<code>{y.href}</code> · {y.count} publikasi)
          </li>
        ))}
      </ul>

      <h2>4. Pengetahuan, Tentang, Sistem &amp; Legal</h2>
      <ul>
        <li><a href={routes.knowledge.graph}>Graf Pengetahuan</a> (<code>{routes.knowledge.graph}</code>)</li>
        <li><a href={routes.knowledge.index}>Indeks Pengetahuan</a> (<code>{routes.knowledge.index}</code>)</li>
        <li><a href={routes.knowledge.tags}>Tag Pengetahuan</a> (<code>{routes.knowledge.tags}</code>)</li>
        <li><a href={routes.knowledge.references}>Objek Referensi</a> (<code>{routes.knowledge.references}</code>)</li>
        <li><a href={routes.about.root}>Tentang</a> (<code>{routes.about.root}</code>) · <a href={routes.about.author}>Penulis</a> · <a href={routes.about.support}>Dukungan</a> · <a href={routes.about.contact}>Kontak</a></li>
        <li><a href={routes.legal.privacy}>Kebijakan Privasi</a> · <a href={routes.legal.terms}>Ketentuan Penggunaan</a> · <a href={routes.legal.disclaimer}>Penafian</a> · <a href={routes.legal.license}>Lisensi</a></li>
      </ul>
    </section>
  )}

  {slug === 'rss' && (
    <section class="pakrpp-sys-section" aria-label="Informasi Langganan RSS">
      <p>
        Halaman ini (<code>/system/rss</code>) menyediakan panduan berlangganan bagi pembaca manusia. Umpan sindikasi XML mesin tersedia langsung pada:
      </p>
      <p>
        <a href={routes.machine.rss}><strong>Buka Feed XML Aktual ({routes.machine.rss}) →</strong></a>
      </p>
      <h2>Cara Berlangganan</h2>
      <ol>
        <li>Salin alamat kanonik <code>{routes.machine.rss}</code> ke pembaca RSS pilihan Anda (NetNewsWire, Feedbin, Inoreader, atau Miniflux).</li>
        <li>Setiap publikasi baru pada <code>/publications/:slug</code> secara otomatis diproyeksikan ke dalam umpan sindikasi terbuka.</li>
      </ol>
    </section>
  )}

  {slug === 'status' && (
    <section class="pakrpp-sys-section" aria-label="Status Kontrak Sistem">
      <h2>Status Kontrak Arsitektur</h2>
      <ul>
        <li><strong>Content Adapter Aktif</strong>: {localContentAdapter.providerName} (<code>{localContentAdapter.providerId}</code>)</li>
        <li><strong>CMS Boundary</strong>: Provider-Neutral / Siap diintegrasikan dengan EmDash CMS maupun headless CMS masa depan</li>
        <li><strong>Publikasi Tervalidasi</strong>: {publications.length} objek publikasi memenuhi invarian inti (<code>id, type, slug, title, status</code>)</li>
        <li><strong>Tipe Publikasi Terdaftar</strong>: {pubTypes.length} tipe ({pubTypes.map((t) => t.id).join(', ')})</li>
        <li><strong>Topik Kanonik Aktif</strong>: {topics.map((t) => `${t.label} (${t.id})`).join(', ')}</li>
      </ul>

      <h2>Feature Flags</h2>
      <ul>
        {Object.entries(featureFlags).map(([key, enabled]) => (
          <li>
            <code>{key}</code>: <strong>{enabled ? 'ENABLED' : 'DISABLED'}</strong>
          </li>
        ))}
      </ul>
    </section>
  )}
</GagaSiteLayout>

<style>
  .pakrpp-sys-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--gaga-border-subtle, rgba(128, 128, 128, 0.22));
  }
  .pakrpp-sys-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
