{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@config/*": [
        "src/config/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@scripts/*": [
        "src/scripts/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".gaga",
    "worker/bundle.mjs"
  ]
}
