{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consumer-blog-signature",
  "main": "worker/bundle.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/search"
    ]
  },
  "no_bundle": true
}
